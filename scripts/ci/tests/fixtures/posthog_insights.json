    {
      "id": 11403383,
      "name": "Rate limits — who is being throttled, and on what",
      "saved": true,
      "dashboards": [2040295],
      "query": {
        "kind": "DataVisualizationNode",
        "source": {
          "kind": "HogQLQuery",
          "query": "SELECT properties.feature AS limited_feature, coalesce(nullIf(toString(properties.origin), ''), 'unset') AS origin, count() AS hits, uniq(person_id) AS people FROM events WHERE event = 'rate_limit_hit' AND timestamp > now() - INTERVAL 30 DAY GROUP BY limited_feature, origin ORDER BY hits DESC LIMIT 25"
        },
        "display": "ActionsTable"
      }
    },
    {
      "id": 11403259,
      "name": "Top spenders — 30 day leaderboard",
      "saved": true,
      "dashboards": [2040295],
      "query": {
        "kind": "DataVisualizationNode",
        "source": {
          "kind": "HogQLQuery",
          "query": "SELECT coalesce(nullIf(toString(p.properties.email), ''), concat('user_id:', e.distinct_id)) AS user, toString(p.properties.plan) AS plan, count() AS calls, round(sum(toFloat64OrNull(toString(e.properties.$ai_total_cost_usd))), 4) AS cost_usd, sum(toFloat64OrNull(toString(e.properties.$ai_input_tokens))) AS input_tokens, sum(toFloat64OrNull(toString(e.properties.$ai_output_tokens))) AS output_tokens, uniq(e.properties.conversation_id) AS conversations, max(e.timestamp) AS last_active FROM events AS e LEFT JOIN persons AS p ON p.id = e.person_id WHERE e.event = '$ai_generation' AND e.timestamp > now() - INTERVAL 30 DAY GROUP BY user, plan ORDER BY cost_usd DESC LIMIT 200"
        },
        "display": "ActionsTable",
        "tableSettings": {
          "columns": [
            {
              "column": "user"
            },
            {
              "column": "plan"
            },
            {
              "column": "cost_usd",
              "settings": {
                "formatting": {
                  "style": "number",
                  "prefix": "$",
                  "decimalPlaces": 4
                }
              }
            },
            {
              "column": "calls",
              "settings": {
                "formatting": {
                  "style": "number"
                }
              }
            },
            {
              "column": "input_tokens",
              "settings": {
                "formatting": {
                  "style": "short"
                }
              }
            },
            {
              "column": "output_tokens",
              "settings": {
                "formatting": {
                  "style": "short"
                }
              }
            },
            {
              "column": "conversations"
            },
            {
              "column": "last_active"
            }
          ],
          "pinnedColumns": ["user"]
        }
      }
    }
