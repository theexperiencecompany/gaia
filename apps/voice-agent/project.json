{
  "name": "voice-agent",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": [
    "scope:python"
  ],
  "root": "apps/voice-agent",
  "sourceRoot": "apps/voice-agent/src",
  "implicitDependencies": [
    "shared-python",
    "docker"
  ],
  "release": {
    "docker": {
      "repositoryName": "theexperiencecompany/gaia-voice-agent"
    }
  },
  "targets": {
    "docker:build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker buildx build --cache-from type=registry,ref=ghcr.io/theexperiencecompany/gaia-voice-agent:buildcache --cache-to type=registry,ref=ghcr.io/theexperiencecompany/gaia-voice-agent:buildcache,mode=max,image-manifest=true,oci-mediatypes=true,compression=zstd --build-arg GIT_COMMIT_SHA=$(git rev-parse HEAD) -f apps/voice-agent/Dockerfile -t apps-voice-agent -t ghcr.io/theexperiencecompany/gaia-voice-agent:latest --load .",
        "cwd": "."
      },
      "cache": false,
      "inputs": [
        "production",
        "^production"
      ]
    },
    "sync": {
      "dependsOn": [
        "shared-python:sync"
      ],
      "executor": "nx:run-commands",
      "options": {
        "command": "uv sync --frozen",
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/pyproject.toml",
        "{workspaceRoot}/uv.lock"
      ]
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run python -m src start",
        "cwd": "{projectRoot}"
      }
    },
    "download-files": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run python -m src download-files",
        "cwd": "{projectRoot}"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --group dev ruff check src/",
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/apps/voice-agent/pyproject.toml",
        "{workspaceRoot}/uv.lock",
        "{workspaceRoot}/libs/shared/py/**/*",
        "^production"
      ]
    },
    "type-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "UV_PROJECT_ENVIRONMENT=../../.venv-voice-agent uv run --group dev mypy src --ignore-missing-imports",
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/apps/voice-agent/pyproject.toml",
        "{workspaceRoot}/uv.lock",
        "{workspaceRoot}/pyproject.toml",
        "{workspaceRoot}/libs/shared/py/**/*",
        "^production"
      ],
      "outputs": [
        "{projectRoot}/.mypy_cache"
      ]
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --group dev ruff format src/",
        "cwd": "{projectRoot}"
      }
    }
  }
}
