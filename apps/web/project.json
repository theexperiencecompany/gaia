{
  "name": "web",
  "root": "apps/web",
  "tags": ["scope:typescript"],
  "sourceRoot": "apps/web/src",
  "targets": {
    "sync": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm install --frozen-lockfile --prefer-offline",
        "cwd": "{workspaceRoot}"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/pnpm-lock.yaml",
        "{workspaceRoot}/package.json",
        "{projectRoot}/package.json"
      ],
      "outputs": []
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm dev",
        "cwd": "{projectRoot}"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm build",
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/apps/web/next.config.mjs",
        "{workspaceRoot}/apps/web/tsconfig.json",
        "{workspaceRoot}/apps/web/tailwind.config.ts"
      ],
      "outputs": ["{projectRoot}/.next", "{projectRoot}/.next/cache"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm check",
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/biome.json"]
    },
    "lint:fix": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm fix",
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm format",
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "format:check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "biome format --check .",
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/biome.json"]
    },
    "type-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm type && pnpm exec tsc -p e2e/tsconfig.json --noEmit",
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/apps/web/tsconfig.json",
        "^production"
      ]
    },
    "e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec playwright test",
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rm -rf .next node_modules .turbo",
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm vitest run --config vitest.config.ts",
        "cwd": "{projectRoot}"
      }
    }
  }
}
