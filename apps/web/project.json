{
  "name": "web",
  "root": "apps/web",
  "tags": ["scope:typescript"],
  "sourceRoot": "apps/web/src",
  "targets": {
    "sync": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm install --frozen-lockfile --prefer-offline",
        "cwd": "{workspaceRoot}"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/pnpm-lock.yaml",
        "{workspaceRoot}/package.json",
        "{projectRoot}/package.json"
      ],
      "outputs": []
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm dev",
        "cwd": "{projectRoot}"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm build",
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": [
        "typecheck",
        "^production",
        {
          "env": "NEXT_PUBLIC_API_BASE_URL"
        },
        {
          "env": "NEXT_PUBLIC_DISCORD_CLIENT_ID"
        },
        {
          "env": "NEXT_PUBLIC_SLACK_CLIENT_ID"
        },
        "{workspaceRoot}/apps/web/next.config.mjs",
        "{workspaceRoot}/apps/web/tsconfig.json"
      ],
      "outputs": ["{projectRoot}/.next", "{projectRoot}/.next/cache"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm check",
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/biome.json"]
    },
    "lint:fix": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm fix",
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm format",
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "format:check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "biome format --check .",
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/biome.json"]
    },
    "type-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm type && node \"$NX_WORKSPACE_ROOT/scripts/ts/type-check.mjs\" -p e2e/tsconfig.json --noEmit",
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        "typecheck",
        "^production",
        "{workspaceRoot}/apps/web/tsconfig.json"
      ]
    },
    "e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec playwright test",
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "e2e-screen": {
      "executor": "nx:run-commands",
      "options": {
        "command": "E2E_SIM=1 pnpm exec playwright test e2e/screen-over-time.spec.ts e2e/screen-surfaces.spec.ts --workers=1",
        "cwd": "{projectRoot}"
      },
      "cache": false,
      "inputs": [
        "{projectRoot}/package.json",
        "{projectRoot}/playwright.config.ts",
        "{projectRoot}/e2e/harness.ts",
        "{projectRoot}/e2e/global-setup.ts",
        "{projectRoot}/e2e/screen-*.ts",
        "{projectRoot}/src/features/chat/**/*",
        "{projectRoot}/src/hooks/**/*",
        "{projectRoot}/src/services/**/*",
        "{projectRoot}/src/stores/**/*",
        "{projectRoot}/src/lib/**/*",
        "{workspaceRoot}/libs/shared/ts/src/conversation/**/*",
        "{workspaceRoot}/libs/shared/ts/src/chat/**/*",
        "{workspaceRoot}/libs/shared/py/conversation_wire.py",
        "{workspaceRoot}/libs/shared/py/approvals.py",
        "{workspaceRoot}/apps/api/app/services/conversation/**/*",
        "{workspaceRoot}/apps/api/app/services/runtime/**/*",
        "{workspaceRoot}/apps/api/app/services/hil/**/*",
        "{workspaceRoot}/apps/api/app/agents/core/**/*",
        "{workspaceRoot}/apps/api/app/api/v1/endpoints/conversations.py",
        "{workspaceRoot}/apps/api/app/api/v1/endpoints/approvals.py",
        "{workspaceRoot}/apps/api/app/api/v1/endpoints/dev.py",
        "{workspaceRoot}/tools/llm-stub/**/*",
        "{workspaceRoot}/scripts/ci/sim-stack.sh",
        "{workspaceRoot}/scripts/ci/test-services.sh",
        "{workspaceRoot}/.github/actions/setup-python-test-env/**/*",
        {
          "externalDependencies": []
        }
      ],
      "metadata": {
        "ci": {
          "job": "web-e2e-screen"
        }
      }
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rm -rf .next node_modules .turbo",
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm vitest run --config vitest.config.ts",
        "cwd": "{projectRoot}"
      }
    },
    "docker:build": {
      "inputs": ["production", "^production", "{workspaceRoot}/.dockerignore"]
    }
  }
}
