{
  "name": "gaia",
  "description": "Frontend Website of GAIA - The personal AI assistant",
  "version": "0.26.0",
  "private": true,
  "homepage": "https://github.com/theexperiencecompany/gaia",
  "bugs": {
    "url": "https://github.com/theexperiencecompany/gaia/issues",
    "email": "support@heygaia.io"
  },
  "type": "module",
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions",
    "not dead"
  ],
  "scripts": {
    "extract-icons": "tsx scripts/extract-icon-paths.ts",
    "sync-wake-word-runtime": "node scripts/sync-wake-word-runtime.mjs",
    "extract-blog": "node scripts/extract-blog-data.mjs",
    "image-dimensions": "node scripts/generate-image-dimensions.mjs",
    "test": "vitest run",
    "prebuild": "npm run extract-icons && npm run extract-blog && npm run sync-wake-word-runtime && npm run image-dimensions && npm run area-css",
    "predev": "npm run sync-wake-word-runtime && npm run area-css && node scripts/clean-corrupt-dev-manifest.mjs",
    "dev": "nx next:dev --turbopack --port=${WEB_PORT:-3000}",
    "build": "npm run type-check && nx next:build",
    "start": "nx next:start",
    "type": "next typegen && node ../../scripts/ts/type-check.mjs --noEmit",
    "type-check": "npm run type",
    "check": "biome check .",
    "fix": "biome check --write .",
    "lint": "npm run check",
    "lint:fix": "npm run fix",
    "format": "biome format --write .",
    "promote-static": "node scripts/promote-static-landing.mjs",
    "prune-desktop-assets": "node scripts/prune-desktop-assets.mjs",
    "write-static-headers": "node scripts/write-static-headers.mjs",
    "verify-prerender": "node scripts/verify-prerender-cache.mjs",
    "verify-landing-bundle": "node scripts/verify-landing-bundle.mjs",
    "cf:build": "npm run type-check && IMAGE_LOADER=cloudflare opennextjs-cloudflare build && node scripts/inline-worker-css.mjs && npm run promote-static && npm run prune-desktop-assets && npm run write-static-headers",
    "deploy": "npm run cf:build && opennextjs-cloudflare deploy",
    "preview": "npm run cf:build && opennextjs-cloudflare preview",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "doctor": "npx react-doctor@0.9.12",
    "audit:css": "node scripts/audit-tailwind-classes.mjs",
    "area-css": "node scripts/generate-area-css.mjs"
  },
  "dependencies": {
    "@gaia/shared": "workspace:*",
    "@gaia/wake-word": "workspace:*",
    "@heroui/react": "3.2.7",
    "@heroui/styles": "3.2.7",
    "@hookform/resolvers": "^5.4.0",
    "@livekit/components-react": "^2.9.23",
