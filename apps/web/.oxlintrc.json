    },
    {
      "files": ["src/components/ui/holo-card/**"],
      "rules": {
        "shadcn/no-inline-styles": [
          "error",
          {
            "allow": [
              "position",
              "width",
              "height",
              "transform",
              "transformStyle",
              "transformOrigin",
              "perspective",
              "backfaceVisibility",
              "WebkitBackfaceVisibility",
              "display",
