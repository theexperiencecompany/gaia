        "shadcn/no-inline-styles": [
          "error",
          {
            "allow": [
              "background",
              "backgroundColor",
              "backgroundImage",
              "color",
              "fontSize",
              "fontWeight",
              "letterSpacing",
              "lineHeight",
              "padding",
              "margin*",
              "gap",
              "width",
              "height",
              "minWidth",
              "minHeight",
              "maxWidth",
              "display",
              "position",
              "top",
              "left",
              "right",
              "bottom",
              "zIndex",
              "overflow",
              "border",
              "borderColor",
              "borderRadius",
              "boxShadow",
              "opacity",
              "objectFit",
              "transform",
              "clipPath",
              "alignItems",
              "whiteSpace",
              "aspectRatio",
              "fontFamily",
              "scrollbarWidth",
              "wordBreak",
              "backgroundSize",
              "backgroundRepeat",
              "borderBottom",
              "textOverflow",
              "gridTemplateColumns",
              "verticalAlign",
              "animation"
            ]
          }
        ]
      }
    },
    {
      "files": ["src/components/ui/shine-border.tsx"],
      "rules": {
        "shadcn/no-inline-styles": [
          "error",
          {
            "allow": [
              "background",
              "backgroundImage",
              "backgroundSize",
              "padding",
              "mask",
              "maskComposite",
