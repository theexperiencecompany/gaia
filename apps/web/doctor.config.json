{
  "$schema": "https://react.doctor/schema/config.json",
  "ignore": {
    "overrides": [
      {
        "files": ["src/config/openui/hooks/useSafeTriggerAction.ts"],
        "rules": ["react-doctor/rules-of-hooks"]
      },
      {
        "files": [
          "src/features/chat/components/voice-agent/hooks/useVoiceSpectrum.ts"
        ],
        "rules": ["react-doctor/effect-needs-cleanup"]
      },
      {
        "files": ["src/features/desktop-popup/sync.ts"],
        "rules": ["react-doctor/effect-needs-cleanup"]
      },
      {
        "files": [
          "src/features/alternatives/data/entries/**",
          "src/features/comparisons/data/entries/**",
          "src/features/integrations/data/combosData-*.ts"
        ],
        "rules": ["deslop/unused-file"]
      },
      {
        "files": [
          "src/features/calendar/**",
          "src/components/layout/sidebar/right-variants/Calendar*",
          "src/components/layout/sidebar/variants/CalendarSidebar*",
          "src/stores/calendarStore*",
          "src/utils/date/dateTimeLocalUtils*"
        ],
        "rules": ["deslop/unused-file"]
      },
      {
        "files": [
          "src/features/wake-word/index.ts",
          "src/features/wake-word/components/WakeWordIndicator*"
        ],
        "rules": ["deslop/unused-file"]
      },
      {
        "files": ["src/app/[locale]/dev/**"],
        "rules": ["deslop/unused-file"]
      },
      {
        "files": [
          "src/features/chat/components/dev/**",
          "src/config/openui/examples/**"
        ],
        "rules": ["deslop/unused-file"]
      }
    ]
  }
}
