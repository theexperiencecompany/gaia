# ============================================================================================
# Web App Environment Variables
# These are placeholder values for build purposes
# ============================================================================================

# Core URLs
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1/

# Self-host UI (setup wizard, local sign-in, instance settings). The self-host
# image bakes it in; set it only when developing against an API running
# AUTH_MODE=local. Build-time: restart the dev server after changing it.
# NEXT_PUBLIC_GAIA_SELFHOST=true

# Which Dodo environment the embedded checkout overlay talks to ("test" | "live").
# Must match the API's DODO_PAYMENTS_API_KEY environment. Unset falls back to
# NODE_ENV (production -> live, otherwise test).
NEXT_PUBLIC_DODO_MODE=test

# Analytics (optional - leave empty to disable)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only; enables source-map upload (npm run cf:build --sentry)
SENTRY_AUTH_TOKEN=
# The commit the maps and events share (CI sets both)
SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_RYBBIT_SITE_ID=
NEXT_PUBLIC_RYBBIT_HOST=https://as.heygaia.io
NEXT_PUBLIC_FASTLANE_TRACKING_ID=
NEXT_PUBLIC_FASTLANE_HOST=https://aromatic-caribou-889.convex.site
# Cloudflare Turnstile site key for the public /contact form (pairs with the API's
# TURNSTILE_SECRET_KEY). Cloudflare's always-pass test key for local use: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Blog (optional) — server-only write credential (NO NEXT_PUBLIC_ prefix).
# Used by the /api/blog route handler; never exposed to the browser.
BLOG_BEARER_TOKEN=
