root = Artifact("Northwind four-day week pilot research report", "The pilot improved wellbeing while maintaining near-baseline throughput; make the four-day week permanent from January with a staggered support rota.", ["Pilot: 4 August–24 October 2026, 46 people, Monday–Thursday, 32 hours, full pay.", "Comparison: 12 pilot weeks versus the 12 weeks before.", "Recommendation: approve permanence at the 20 November leadership meeting."], [overview, throughput, teams, wellbeing, service, recommendation, methodology, sources])
overview = Section("Executive summary", "Wellbeing improved substantially, while total throughput remained close to baseline.", [summary_takeaways, summary_callout, designer_quote])
summary_takeaways = Takeaways(["Make the four-day week permanent from January.", "Keep full pay and 32 hours across Monday–Thursday.", "Introduce a staggered support rota to address Friday waits and slower first replies.", "Treat the pilot as a strong operational result with a targeted support-service gap."])
summary_callout = Callout("good", "Recommendation", "Approve permanence from January, subject to a staggered support rota that maintains Friday coverage.")
designer_quote = Quote("I used to spend Sunday dreading Monday. Now Friday is the day I fix the house, and the weekend is actually a weekend.", "Product designer")
throughput = Section("Throughput", "Pilot throughput started below baseline but converged, ending only slightly below the comparison period.", [throughput_stats, throughput_chart, throughput_note])
throughput_stats = Stats([["Baseline average", "216.6", "Completed tickets per week"], ["Pilot average", "209.8", "Completed tickets per week"], ["Change", "-3.1%", "Average weekly throughput", "down", "bad"], ["Final week", "214", "Pilot W12 versus baseline W12: 217"]])
throughput_chart = Line("Weekly throughput converged during the pilot", "Completed tickets per ISO week; 12 baseline weeks versus 12 pilot weeks", ["W1", "W2", "W3", "W4", "W5", "W6", "W7", "W8", "W9", "W10", "W11", "W12"], [["Baseline", [212, 218, 205, 221, 214, 219, 210, 224, 216, 213, 220, 217]], ["Pilot", [188, 197, 204, 209, 211, 216, 208, 219, 212, 214, 215, 214]]])
throughput_note = Callout("note", "Interpretation", "Pilot output was 6.8 tickets per week lower on average, with the gap narrowing from 24 tickets in W1 to 3 tickets in W12.")
teams = Section("Team comparison", "Engineering and Design increased tickets, while Marketing and Operations declined; overall team totals moved from 217 to 214.", [team_table, team_chart, team_note])
team_table = DataTable("Weekly tickets per team: before versus pilot", ["Team", "People", "Before", "Pilot", "Change"], [1, 2, 3, 4], [["Engineering", 18, 96, 99, 3], ["Platform", 7, 38, 40, 2], ["Product", 11, 58, 59, 1], ["Design", 6, 31, 32, 1], ["Marketing", 7, 38, 37, -1], ["Operations", 8, 52, 46, -6], ["Finance ops", 0, 21, 20, -1], ["People ops", 0, 31, 26, -5], ["Total", 0, 217, 214, -3]], null, {"0": [["Platform", 7, 38, 40, 2], ["Product", 11, 58, 59, 1]], "5": [["Finance ops", 0, 21, 20, -1], ["People ops", 0, 31, 26, -5]]})
team_chart = Bars("Engineering and Design offset Operations decline", "Tickets per week; before versus pilot", ["Engineering", "Design", "Marketing", "Operations"], [["Before", [96, 31, 38, 52]], ["Pilot", [99, 32, 37, 46]]])
team_note = Paragraph("Support is excluded from the team comparison. Engineering rose from 96 to 99 tickets per week, Design from 31 to 32, Marketing fell from 38 to 37, and Operations fell from 52 to 46.")
wellbeing = Section("Employee experience", "All four survey measures moved in the intended direction among the 44 of 46 people who responded.", [survey_chart, survey_table, wellbeing_note])
survey_chart = Bars("Wellbeing improved across every measured item", "Share agreeing, week 0 versus week 12; 44 of 46 respondents", ["Time for life outside work", "Energy left at end of week", "Focus without interruption", "Stressed most days"], [["Week 0", [41, 29, 47, 52]], ["Week 12", [83, 61, 64, 36]]])
survey_table = DataTable("Survey results", ["Measure", "Week 0", "Week 12", "Change"], [1, 2, 3], [["Time for life outside work", "41%", "83%", "+42 pp"], ["Energy left at end of week", "29%", "61%", "+32 pp"], ["Can focus without interruption", "47%", "64%", "+17 pp"], ["Stressed most days", "52%", "36%", "-16 pp"]])
wellbeing_note = Callout("good", "Strongest movement", "The share agreeing there was time for life outside work doubled from 41% to 83%; the share stressed most days fell from 52% to 36%.")
service = Section("Health and service coverage", "Sickness decreased, but Friday support coverage requires redesign before permanence.", [service_stats, service_callout, service_actions])
service_stats = Stats([["Sick days", "41", "Down from 67 last quarter", "down", "good"], ["Support first reply", "5.2h", "Up from 3.8h", "up", "bad"], ["Friday ticket wait", "62h", "Median; other days: 4h", "up", "bad"], ["Support staff choosing Monday", "2 of 5", "Volunteered instead of Friday"]])
service_callout = Callout("warn", "Operational risk", "Support first reply slowed from 3.8 hours to 5.2 hours, and Friday tickets waited a median of 62 hours versus 4 hours on other days.")
service_actions = Paragraph("Two of five support staff volunteered to take Monday off instead of Friday. A staggered rota should preserve Friday support coverage while retaining the four-day-week benefit.")
recommendation = Section("Decision and next steps", "Approve permanence from January and complete the listed implementation work.", [decision, next_steps])
decision = Callout("good", "Decision requested from Maya", "Approve the four-day week as permanent from January, with a staggered support rota.")
next_steps = Todo([["Approve", "the permanent four-day week at the 20 November leadership meeting.", "Maya — 20 Nov"], ["Draft", "the support Monday rota with Priya and Tom.", "Lena — 28 Nov"], ["Update", "contracts and the handbook.", "HR — 15 Dec"], ["Rerun", "the survey after six months.", "Maya — Jun 2027"]])
methodology = Section("Method", "The analysis compares 12 pilot weeks with the 12 weeks immediately before.", [method])
method = Paragraph("Throughput is completed tickets per ISO week from the tracker, counted on first move to done. The pilot ran from 4 August to 24 October 2026 with 46 people working Monday–Thursday for 32 hours on full pay. Survey results compare week 0 with week 12 and had 44 of 46 responses. Support is excluded from the team comparison.")
sources = Sources([["Northwind pilot charter", "Northwind", "July 2026"], ["The results are in: the UK's four-day week pilot", "Autonomy", "https://autonomy.work/portfolio/uk4dwpilotresults/"]])