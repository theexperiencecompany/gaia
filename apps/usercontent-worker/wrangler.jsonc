{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Forwards <content_id>.u.heygaia.link to the API's /api/v1/usercontent route,
  // which owns every serving rule. Secret (wrangler secret put): INTERNAL_API_TOKEN.
  "name": "gaia-usercontent",
  "main": "src/index.ts",
  "compatibility_date": "2026-02-24",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "*.u.heygaia.link/*",
      "zone_name": "heygaia.link"
    }
  ],
  "vars": {
    "API_ORIGIN": "https://api.heygaia.io"
  }
}
