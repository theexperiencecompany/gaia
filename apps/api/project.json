{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "root": "apps/api",
  "sourceRoot": "apps/api/app",
  "implicitDependencies": [
    "docker",
    "shared-python"
  ],
  "projectType": "application",
  "tags": [
    "scope:python"
  ],
  "release": {
    "docker": {
      "repositoryName": "theexperiencecompany/gaia"
    }
  },
  "targets": {
    "build": {
      "executor": "nx:noop",
      "cache": true,
      "inputs": [
        "production"
      ],
      "outputs": []
    },
    "docker:build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker build --platform linux/amd64 --build-arg GIT_COMMIT_SHA=$(git rev-parse HEAD) -f apps/api/Dockerfile -t apps-api -t ghcr.io/theexperiencecompany/gaia:latest . && docker push ghcr.io/theexperiencecompany/gaia:latest",
        "cwd": "."
      },
      "cache": false,
      "inputs": [
        "production",
        "^production"
      ]
    },
    "sync": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv sync --frozen --group backend --group dev",
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/pyproject.toml",
        "{projectRoot}/uv.lock"
      ],
      "outputs": [
        "{projectRoot}/.venv"
      ]
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --group backend uvicorn app.main:app --host 0.0.0.0 --port ${API_PORT:-8000} --reload --reload-dir app --log-level info --no-access-log",
        "cwd": "{projectRoot}"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uvx ruff check .",
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/apps/api/pyproject.toml",
        "{workspaceRoot}/apps/api/ruff.toml",
        "^production"
      ],
      "outputs": []
    },
    "lint:fix": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uvx ruff check . --fix",
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uvx ruff format .",
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "format:check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uvx ruff format . --check",
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/apps/api/pyproject.toml",
        "{workspaceRoot}/apps/api/ruff.toml"
      ]
    },
    "type-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --group backend --group dev mypy app --ignore-missing-imports",
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/apps/api/pyproject.toml",
        "^production"
      ],
      "outputs": [
        "{projectRoot}/.mypy_cache"
      ]
    },
    "worker": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --group backend arq app.worker.WorkerSettings --custom-log-dict app.workers.config.log_config.ARQ_LOG_CONFIG",
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --group backend --group dev pytest -v --tb=short -n auto --maxprocesses=4",
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/app/**/*",
        "{projectRoot}/tests/**/*",
        "{projectRoot}/pyproject.toml",
        "{projectRoot}/pytest.ini"
      ]
    },
    "test:real": {
      "executor": "nx:run-commands",
      "options": {
        "command": "USE_REAL_SERVICES=1 uv run --group backend --group dev pytest tests/integration/real tests/contracts tests/e2e/test_hil_barrier_e2e.py tests/e2e/test_hil_spawn_e2e.py -v --tb=short -n auto --maxprocesses=4",
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "test:contracts": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --group backend --group dev pytest tests/contracts -v --tb=short -n auto --maxprocesses=4",
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/app/**/*",
        "{projectRoot}/tests/contracts/**/*",
        "{projectRoot}/tests/conftest.py",
        "{projectRoot}/tests/factories.py",
        "{projectRoot}/tests/helpers.py"
      ]
    },
    "test:composio": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --group backend --group dev pytest tests/composio -v --tb=short -n auto --maxprocesses=4",
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "test:stress": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --group backend --group dev pytest tests/stress -v --tb=short -n auto --maxprocesses=4",
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "test:meta": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --group backend --group dev pytest tests/meta -v --tb=short -n auto --maxprocesses=4",
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/tests/meta/**/*",
        "{projectRoot}/tests/conftest.py"
      ]
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --group backend --group dev pytest tests/unit -v --tb=short -n auto --maxprocesses=4",
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/app/**/*",
        "{projectRoot}/tests/unit/**/*",
        "{projectRoot}/tests/conftest.py",
        "{projectRoot}/tests/factories.py",
        "{projectRoot}/tests/helpers.py"
      ]
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --group backend --group dev pytest tests/integration --ignore=tests/integration/real -v --tb=short -n auto --maxprocesses=4",
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/app/**/*",
        "{projectRoot}/tests/integration/**/*",
        "{projectRoot}/tests/conftest.py",
        "{projectRoot}/tests/factories.py",
        "{projectRoot}/tests/helpers.py"
      ]
    },
    "test:e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --group backend --group dev pytest tests/e2e -v --tb=short -m e2e -n auto --maxprocesses=4",
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --group backend --group dev pytest --cov=app --cov-report=html --cov-report=term-missing -n auto --maxprocesses=4",
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "find . -type d -name '__pycache__' -exec rm -rf {} + && find . -type f -name '*.pyc' -delete",
        "cwd": "{projectRoot}"
      }
    },
    "test:schemathesis": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --group backend --group dev pytest tests/integration/real/test_schemathesis.py -v --tb=short -m schemathesis --override-ini=addopts=--strict-markers --timeout=600",
        "cwd": "{projectRoot}"
      },
      "cache": false
    }
  }
}
