# Eval harness (apps/api/scripts/evals)
scripts/evals/.env.opik
scripts/evals/runs/
scripts/evals/data/gaia/
# Regenerated by every run (core/report.py writes reports/latest.html). It
# embeds full transcripts, tool-call arguments and per-case user identifiers —
# throwaway accounts today, but a tracked artifact that would carry real ones
# into git history the moment a run points at a real account.
scripts/evals/reports/
models_backup_*.json
# Written by every `seed_explore_workflows.py` run unless --no-backup is passed.
explore_workflows_backup_*.json

# Mutation-testing scratch dirs (scripts/ci/mutation.sh module, one per run).
# Normally removed by its EXIT trap, but a killed run leaves one behind and a
# `git add -A` then sweeps thousands of copied files into the index.
.mutation-*/
