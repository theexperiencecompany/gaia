{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "{{GAIA_LAB_EVENTS_URL}}",
            "timeout": 15,
            "headers": {
              "Authorization": "Bearer {{GAIA_LAB_TOKEN}}"
            },
            "allowedEnvVars": []
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "{{GAIA_LAB_EVENTS_URL}}",
            "timeout": 15,
            "headers": {
              "Authorization": "Bearer {{GAIA_LAB_TOKEN}}"
            },
            "allowedEnvVars": []
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "{{GAIA_LAB_EVENTS_URL}}",
            "timeout": 15,
            "headers": {
              "Authorization": "Bearer {{GAIA_LAB_TOKEN}}"
            },
            "allowedEnvVars": []
          }
        ]
      }
    ]
  }
}
