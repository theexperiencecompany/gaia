+impl ObscuraModuleLoader {
+    /// The bytes behind a `blob:` module URL. Only object URLs minted in this
+    /// page, for this page's origin, and not yet revoked resolve; anything else
+    /// is a network error, as in a browser.
+    fn blob_module_bytes(&self, specifier: &ModuleSpecifier) -> Result<Vec<u8>, ModuleLoaderError> {
+        let fail = || io_err(format!("Failed to fetch module {}", specifier));
+        let state = self
+            .page_state
+            .as_ref()
+            .and_then(Weak::upgrade)
+            .ok_or_else(fail)?;
+        let state = state.try_borrow().map_err(|_| fail())?;
+        let document_origin = url::Url::parse(&state.url)
+            .map(|document| document.origin().ascii_serialization())
+            .map_err(|_| fail())?;
+        // blob:<origin>/<uuid> — the origin is everything before the last '/'.
+        let blob_origin = specifier
+            .as_str()
+            .strip_prefix("blob:")
+            .and_then(|rest| rest.rsplit_once('/'))
+            .map(|(origin, _)| origin)
+            .ok_or_else(fail)?;
+        if blob_origin != document_origin {
+            return Err(fail());
+        }
+        // A fragment does not name a different object.
+        let key = specifier.as_str().split('#').next().unwrap_or_default();
+        state.blob_urls.get(key).cloned().ok_or_else(fail)
+    }
+}
+
 fn io_err(msg: String) -> ModuleLoaderError {
     std::io::Error::new(std::io::ErrorKind::Other, msg).into()
 }
@@ -191,6 +222,28 @@ impl ModuleLoader for ObscuraModuleLoader {
         _requested_module_type: RequestedModuleType,
