+/// Registers the bytes behind an object URL (see `ObscuraState::blob_urls`).
+/// Kept on the page's state whichever realm minted it, because the module
+/// loader is shared by every realm of the page.
+#[op2(fast)]
+fn op_blob_url_register(state: &OpState, #[string] url: &str, #[buffer] bytes: &[u8]) {
+    let shared = state.borrow::<SharedState>().clone();
+    shared
+        .borrow_mut()
+        .blob_urls
+        .insert(url.to_string(), bytes.to_vec());
+}
+
+#[op2(fast)]
+fn op_blob_url_revoke(state: &OpState, #[string] url: &str) {
+    let shared = state.borrow::<SharedState>().clone();
+    shared.borrow_mut().blob_urls.remove(url);
+}
+
+/// The object URL's contents as text, or `None` for an unknown/revoked URL.
+#[op2]
+#[string]
+fn op_blob_url_text(state: &OpState, #[string] url: &str) -> Option<String> {
+    let shared = state.borrow::<SharedState>().clone();
+    let state = shared.borrow();
+    state
+        .blob_urls
+        .get(url)
+        .map(|bytes| String::from_utf8_lossy(bytes).into_owned())
+}
