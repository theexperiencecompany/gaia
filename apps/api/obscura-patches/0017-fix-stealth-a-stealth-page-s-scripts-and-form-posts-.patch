+    /// Serves a page with one external script and a login form that answers
+    /// POST /login with a 303 to /secure; records each request's method, path
+    /// and User-Agent header.
+    fn spawn_user_agent_recording_server() -> (
+        String,
+        std::sync::Arc<std::sync::Mutex<Vec<(String, String, String)>>>,
+    ) {
+        use std::io::{Read as _, Write as _};
+
+        let listener = std::net::TcpListener::bind("127.0.0.1:0").unwrap();
+        let address = listener.local_addr().unwrap();
+        let seen = std::sync::Arc::new(std::sync::Mutex::new(Vec::new()));
+        let recorded = seen.clone();
+        std::thread::spawn(move || {
+            for stream in listener.incoming() {
+                let Ok(mut stream) = stream else {
+                    continue;
+                };
+                let mut request = [0u8; 4096];
+                let length = stream.read(&mut request).unwrap_or(0);
+                let request_text = String::from_utf8_lossy(&request[..length]).to_string();
+                let mut request_line = request_text
+                    .lines()
+                    .next()
+                    .unwrap_or_default()
+                    .split_whitespace();
+                let method = request_line.next().unwrap_or("GET").to_string();
+                let path = request_line.next().unwrap_or("/").to_string();
+                let user_agent = request_text
+                    .lines()
+                    .find_map(|line| {
+                        let (name, value) = line.split_once(':')?;
+                        name.eq_ignore_ascii_case("user-agent").then(|| value.trim().to_string())
+                    })
+                    .unwrap_or_default();
+                recorded.lock().unwrap().push((method.clone(), path.clone(), user_agent));
+                let response = if method == "POST" {
+                    "HTTP/1.1 303 See Other\r\nLocation: /secure\r\nContent-Length: 0\r\nConnection: close\r\n\r\n".to_string()
+                } else {
+                    let (content_type, body) = if path == "/app.js" {
+                        ("application/javascript", "globalThis.__ran = true;")
+                    } else {
+                        (
+                            "text/html",
+                            "<!doctype html><html><body><script src='/app.js'></script></body></html>",
+                        )
+                    };
+                    format!(
+                        "HTTP/1.1 200 OK\r\nContent-Type: {content_type}\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{body}",
+                        body.len(),
+                    )
+                };
+                let _ = stream.write_all(response.as_bytes());
+            }
+        });
+        (format!("http://{address}/"), seen)
+    }
+
+    fn stealth_page(name: &str) -> super::Page {
+        let context = std::sync::Arc::new(crate::BrowserContext::with_storage_and_network(
+            name.to_string(),
+            None,
+            true,
+            None,
+            None,
+            true,
+        ));
+        super::Page::new(name.to_string(), context)
+    }
+
+    fn user_agent_of(seen: &[(String, String, String)], method: &str, path: &str) -> Option<String> {
+        seen.iter()
+            .find(|(m, p, _)| m == method && p == path)
+            .map(|(_, _, ua)| ua.clone())
+    }
+
+    /// A stealth page once fetched its parser-inserted scripts with the plain
+    /// client, which announces another browser: a site that pins its session to
+    /// the User-Agent (Rack's session-hijacking guard) cleared the session on
+    /// every script request, and the cleared cookie replaced the signed-in one.
+    #[cfg(feature = "stealth")]
+    #[tokio::test(flavor = "current_thread")]
+    async fn stealth_scripts_are_requested_as_the_same_browser_as_their_page() {
+        let (url, seen) = spawn_user_agent_recording_server();
+        let mut page = stealth_page("stealth-script-identity");
+
+        page.navigate(&url).await.unwrap();
+
+        let seen = seen.lock().unwrap().clone();
+        let script_agent = user_agent_of(&seen, "GET", "/app.js");
+        assert!(script_agent.is_some(), "the script was never requested: {seen:?}");
+        assert_eq!(script_agent, user_agent_of(&seen, "GET", "/"), "requests: {seen:?}");
+    }
+
+    /// A stealth page submitted its forms with the plain client too, so a
+    /// login was made as one browser and every later request came from
+    /// another; a site that pins its session to the User-Agent dropped it.
+    #[cfg(feature = "stealth")]
+    #[tokio::test(flavor = "current_thread")]
+    async fn stealth_form_posts_and_their_redirects_go_out_as_the_page_browser() {
+        let (url, seen) = spawn_user_agent_recording_server();
+        let mut page = stealth_page("stealth-form-identity");
+        page.navigate(&url).await.unwrap();
+
+        page.navigate_with_wait_post(
+            &format!("{url}login"),
+            crate::lifecycle::WaitUntil::Load,
+            "POST",
+            "username=tomsmith",
+        )
+        .await
+        .unwrap();
+
+        let seen = seen.lock().unwrap().clone();
+        let page_agent = user_agent_of(&seen, "GET", "/");
+        assert_eq!(user_agent_of(&seen, "POST", "/login"), page_agent, "requests: {seen:?}");
+        assert_eq!(user_agent_of(&seen, "GET", "/secure"), page_agent, "requests: {seen:?}");
+        assert!(page.url_string().ends_with("/secure"), "landed on {}", page.url_string());
+    }
+
