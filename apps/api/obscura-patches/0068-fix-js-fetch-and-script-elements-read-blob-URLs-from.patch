+    /// A blob: URL the page minted is fetched from its Blob: by fetch(), with
+    /// the Blob's type, and as a dynamically inserted script.
+    #[tokio::test(flavor = "current_thread")]
+    async fn blob_urls_serve_fetch_and_scripts_from_the_page_store() {
+        let mut rt = setup_runtime_at("<html><head></head><body></body></html>", "https://example.com/");
+        rt.evaluate(
+            r#"(() => {
+            globalThis.__blob = [];
+            const text = URL.createObjectURL(new Blob(['hello'], {type: 'text/plain'}));
+            fetch(text).then(async response => {
+                __blob.push(response.status, response.headers.get('content-type'), await response.text());
+                return fetch(text, {method: 'POST'});
+            }).catch(error => __blob.push(error.name));
+            const script = document.createElement('script');
+            script.src = URL.createObjectURL(new Blob(['window.__blobScriptRan = true']));
+            document.head.append(script);
+            return true;
+            })()"#,
+        )
+        .unwrap();
+        rt.run_event_loop_bounded(200).await.unwrap();
+        assert_eq!(
+            rt.evaluate("[__blob, window.__blobScriptRan === true]").unwrap(),
+            serde_json::json!([[200, "text/plain", "hello", "TypeError"], true])
+        );
+    }
+
