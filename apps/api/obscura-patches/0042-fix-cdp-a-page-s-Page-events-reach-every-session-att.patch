     pub isolated_worlds: Vec<String>,
@@ -197,6 +200,7 @@ impl CdpContext {
             binding_sessions: HashMap::new(),
             opened_windows: HashMap::new(),
             runtime_enabled_sessions: HashSet::new(),
+            page_enabled_sessions: HashSet::new(),
             preload_counter: 0,
             fetch_intercept: FetchInterceptState::new(),
             intercept_tx: None,
@@ -317,6 +321,42 @@ impl CdpContext {
         Ok(page_ids)
     }
 
+    /// Take the events to send, with each page-scoped Page event also addressed
+    /// to every other session of its page that enabled Page, as Chrome does: a
+    /// second client watching a tab sees the navigations another one drives.
+    pub(crate) fn take_pending_events(&mut self) -> Vec<CdpEvent> {
+        let events = std::mem::take(&mut self.pending_events);
+        if self.page_enabled_sessions.is_empty() {
+            return events;
+        }
+        let mut out = Vec::with_capacity(events.len());
+        for event in events {
+            let watchers: Vec<String> = match (&event.session_id, is_page_scoped_page_event(&event.method)) {
+                (Some(origin), true) => match self.sessions.get(origin) {
+                    Some(page_id) => self
+                        .page_enabled_sessions
+                        .iter()
+                        .filter(|session| *session != origin && self.sessions.get(*session) == Some(page_id))
+                        .cloned()
+                        .collect(),
+                    None => Vec::new(),
+                },
+                _ => Vec::new(),
+            };
+            let copies: Vec<CdpEvent> = watchers
+                .into_iter()
+                .map(|session| CdpEvent {
+                    method: event.method.clone(),
+                    params: event.params.clone(),
+                    session_id: Some(session),
+                })
+                .collect();
+            out.push(event);
+            out.extend(copies);
+        }
+        out
+    }
+
     pub fn get_page(&self, id: &str) -> Option<&Page> {
         self.pages.iter().find(|p| p.id == id)
     }
