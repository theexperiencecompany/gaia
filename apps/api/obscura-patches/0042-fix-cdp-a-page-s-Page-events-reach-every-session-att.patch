         }
         for session_id in &removed_sessions {
             self.runtime_enabled_sessions.remove(session_id);
+            self.page_enabled_sessions.remove(session_id);
         }
         if let Some(context_ids) = self.page_contexts.remove(id) {
             for context_id in context_ids {
@@ -665,6 +706,15 @@ mod context_ownership_tests {
 
 }
 
+/// Whether a Page event belongs to the page rather than to the session that
+/// asked for it. Screencast frames are per session: each screencast has its own
+/// frame acks.
+fn is_page_scoped_page_event(method: &str) -> bool {
+    method.starts_with("Page.")
+        && method != "Page.screencastFrame"
+        && method != "Page.screencastVisibilityChanged"
+}
+
 /// Whether a CDP method can be served WITHOUT acquiring the per-connection V8 lock.
 ///
 /// Methods listed here were audited to confirm they do not transitively
@@ -1203,6 +1253,43 @@ mod tests {
         }
     }
 
+    #[tokio::test]
+    async fn page_events_reach_every_session_of_the_page_that_enabled_page() {
+        let mut ctx = CdpContext::new();
+        let page = ctx.create_page();
+        let other_page = ctx.create_page();
+        for (session, owner) in [("driver", &page), ("viewer", &page), ("quiet", &page), ("elsewhere", &other_page)] {
+            ctx.sessions.insert(session.into(), owner.clone());
+        }
+        for session in ["viewer", "elsewhere"] {
+            let enable = CdpRequest { session_id: Some(session.into()), ..req("Page.enable") };
+            assert!(dispatch(&enable, &mut ctx).await.error.is_none());
+        }
+        ctx.pending_events.clear();
+        for method in ["Page.frameNavigated", "Page.screencastFrame", "Network.requestWillBeSent"] {
+            ctx.pending_events.push(CdpEvent { method: method.into(), params: json!({}), session_id: Some("driver".into()) });
+        }
+
+        let sent: Vec<(String, String)> = ctx
+            .take_pending_events()
+            .into_iter()
+            .map(|event| (event.method, event.session_id.unwrap()))
+            .collect();
+
+        let expected = [
+            ("Page.frameNavigated", "driver"),
+            ("Page.frameNavigated", "viewer"),
+            ("Page.screencastFrame", "driver"),
+            ("Network.requestWillBeSent", "driver"),
+        ];
+        assert_eq!(sent, expected.map(|(m, s)| (m.to_string(), s.to_string())));
+
+        let disable = CdpRequest { session_id: Some("viewer".into()), ..req("Page.disable") };
+        assert!(dispatch(&disable, &mut ctx).await.error.is_none());
+        ctx.pending_events.push(CdpEvent { method: "Page.loadEventFired".into(), params: json!({}), session_id: Some("driver".into()) });
+        assert_eq!(ctx.take_pending_events().len(), 1);
+    }
+
     #[tokio::test]
     async fn audits_enable_returns_empty_success() {
         let mut ctx = CdpContext::new();
diff --git a/crates/obscura-cdp/src/domains/page.rs b/crates/obscura-cdp/src/domains/page.rs
