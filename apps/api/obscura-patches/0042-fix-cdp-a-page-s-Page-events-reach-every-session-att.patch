@@ -1398,6 +1398,9 @@ pub async fn handle(
 ) -> Result<Value, String> {
     match method {
         "enable" => {
+            if let Some(session) = session_id {
+                ctx.page_enabled_sessions.insert(session.clone());
+            }
             // Chrome loads a new target's initial about:blank right after
             // createTarget, so by the time a client attaches and calls
             // Page.enable the page has already produced its load events.
@@ -1516,6 +1519,12 @@ pub async fn handle(
 
             Ok(json!({ "executionContextId": context.id }))
         }
+        "disable" => {
+            if let Some(session) = session_id {
+                ctx.page_enabled_sessions.remove(session);
+            }
+            Ok(json!({}))
+        }
         "setLifecycleEventsEnabled" => Ok(json!({})),
         // Scoped to the target of the session that adds it, as in Chrome: a
         // script one tab registers does not run in another. runImmediately
