+    /// A shadow root attached inside a frame belongs to the frame's document.
+    /// Cloudflare Turnstile does exactly this in its challenge frame: it
+    /// attaches a shadow root to its own <body> and appends a <style> to it.
+    #[test]
+    fn frame_shadow_root_lives_in_the_frame_document() {
+        let mut parent = page(
+            "https://parent.example/page",
+            "<html><body><div><p>parent</p></div></body></html>",
+        );
+        let frame = FrameRealm::new(
+            &mut parent,
+            1,
+            0,
+            "https://child.example/frame",
+            "<html><body></body></html>",
+        )
+        .expect("frame realm");
+
+        assert_eq!(
+            frame
+                .evaluate(
+                    &mut parent,
+                    r#"(() => {
+                        const root = document.body.attachShadow({ mode: "open" });
+                        const style = document.createElement("style");
+                        style.textContent = "p { color: red }";
+                        root.appendChild(style);
+                        return [
+                            root.firstChild === style,
+                            style.parentNode === root,
+                            document.body.shadowRoot === root,
+                        ];
+                    })()"#,
+                )
+                .unwrap(),
+            serde_json::json!([true, true, true])
+        );
+        // The page's own tree is untouched: nothing was attached to its nodes.
+        assert_eq!(
+            parent
+                .evaluate("[document.body.shadowRoot, document.querySelector('div').shadowRoot]")
+                .unwrap(),
+            serde_json::json!([null, null])
+        );
+    }
+
     #[test]
     fn frame_uses_its_embedding_viewport() {
         let mut parent = page(
