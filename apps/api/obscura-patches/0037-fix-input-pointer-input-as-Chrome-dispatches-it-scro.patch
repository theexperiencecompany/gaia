+/// A trusted wheel event at the viewport point, then its default action: the
+/// nearest scrollable flat-tree ancestor that can move in the wheel's
+/// direction scrolls, else the viewport.
+fn wheel_js(x: f64, y: f64, delta_x: f64, delta_y: f64, modifiers: u64) -> String {
+    let (alt_key, ctrl_key, meta_key, shift_key) = modifier_flags(modifiers);
+    format!(
+        "(function() {{\
+            var target = globalThis.__obscura_hitTarget({x},{y}) || document.documentElement;\
+            if (!target) return;\
+            var wheel = globalThis.__obscura_markTrusted(new WheelEvent('wheel', {{bubbles:true,cancelable:true,composed:true,view:globalThis,clientX:{x},clientY:{y},deltaX:{delta_x},deltaY:{delta_y},deltaMode:0,altKey:{alt_key},ctrlKey:{ctrl_key},metaKey:{meta_key},shiftKey:{shift_key}}}));\
+            if (!target.dispatchEvent(wheel)) return;\
+            globalThis.__obscura_scrollByWheel(target, {delta_x}, {delta_y});\
+        }})()"
+    )
+}
