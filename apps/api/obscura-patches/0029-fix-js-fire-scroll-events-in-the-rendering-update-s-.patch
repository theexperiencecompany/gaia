diff --git a/crates/obscura-js/js/bootstrap.js b/crates/obscura-js/js/bootstrap.js
index 4fc267f..a88179e 100644
--- a/crates/obscura-js/js/bootstrap.js
+++ b/crates/obscura-js/js/bootstrap.js
@@ -1049,9 +1049,27 @@ let _rafRunningFrame = false;
 let _renderOpportunityScheduled = false;
 let _renderOpportunityRunning = false;
 
+// HTML "pending scroll event targets": a scroll queues its target once, and
+// the next rendering update's scroll steps fire the events, ahead of the
+// animation frame callbacks. A document's scroll event bubbles to the window.
+let _pendingScrollEventTargets = [];
+function _queueScrollEvent(target) {
+  if (!target || _pendingScrollEventTargets.includes(target)) return;
+  _pendingScrollEventTargets.push(target);
+  _scheduleRenderingOpportunity();
+}
 function _renderOpportunityHasWork() {
-  return _rafFrameScheduled || _resizeRenderCheckpointPending
-    || _intersectionRenderCheckpointPending;
+  return _pendingScrollEventTargets.length > 0 || _rafFrameScheduled
+    || _resizeRenderCheckpointPending || _intersectionRenderCheckpointPending;
+}
+
+function _runScrollSteps() {
+  const targets = _pendingScrollEventTargets;
+  _pendingScrollEventTargets = [];
+  for (const target of targets) {
+    try { target.dispatchEvent(new Event('scroll', { bubbles: target.nodeType === 9 })); }
+    catch (e) { console.error("Scroll event error:", e); }
+  }
 }
 
 // Gecko and the HTML rendering algorithm use one refresh opportunity for
@@ -1060,7 +1078,8 @@ function _renderOpportunityHasWork() {
 // lets registration order change which geometry a callback sees. Run the
 // phases once, in browser order, from one task instead:
 //
-//   animation frame callbacks -> layout/ResizeObserver -> intersections
+//   scroll events -> animation frame callbacks -> layout/ResizeObserver
+//   -> intersections
 //
 // A phase which queues more work while this task is running belongs to the
 // next opportunity unless a later phase in this opportunity can consume it.
@@ -1075,6 +1094,7 @@ function _runRenderingOpportunity() {
   _renderOpportunityScheduled = false;
   _renderOpportunityRunning = true;
   try {
+    if (_pendingScrollEventTargets.length > 0) _runScrollSteps();
     if (_rafFrameScheduled) _runAnimationFrameBatch();
     if (_resizeRenderCheckpointPending) _runResizeRenderCheckpoint();
     if (_intersectionRenderCheckpointPending) _runIntersectionRenderCheckpoint();
@@ -5530,14 +5550,10 @@ class Element extends Node {
       top: (this.scrollTop || 0) + (+dt || 0),
     });
   }
+  // Scrolling the viewport's root element scrolls the document, whose scroll
+  // event bubbles to the window; any other scroller gets its own.
   _fireScroll() {
-    if (this._scrollEventPending) return;
-    this._scrollEventPending = true;
-    const self = this;
-    setTimeout(() => {
-      self._scrollEventPending = false;
-      try { self.dispatchEvent(new Event('scroll', { bubbles: false })); } catch (e) {}
-    }, 0);
+    _queueScrollEvent(this._isViewportRoot() ? this.ownerDocument : this);
   }
   animate(keyframes, options) {
     const animation = new Animation(new KeyframeEffect(this, keyframes, options), document.timeline);
@@ -14592,8 +14608,6 @@ function _scrollRoot() {
 function _windowScroll(x, y, relative) {
   const root = _scrollRoot();
   if (!root) return;
-  const beforeLeft = root.scrollLeft || 0;
-  const beforeTop = root.scrollTop || 0;
   let left, top;
   if (x !== null && typeof x === 'object') { left = x.left; top = x.top; }
   else { left = x; top = y; }
@@ -14603,18 +14617,8 @@ function _windowScroll(x, y, relative) {
   if (top !== undefined) {
     root.scrollTop = (relative ? (root.scrollTop || 0) : 0) + (+top || 0);
   }
-  if ((root.scrollLeft || 0) === beforeLeft && (root.scrollTop || 0) === beforeTop) {
-    return;
-  }
-  // Async, matching the element path #431 added. A viewport scroll fires at
-  // the document and bubbles to the window, as in Chrome.
-  setTimeout(() => {
-    try {
-      const doc = globalThis.document;
-      if (doc) doc.dispatchEvent(new Event('scroll', { bubbles: true }));
-      else globalThis.dispatchEvent(new Event('scroll', { bubbles: false }));
-    } catch (e) {}
-  }, 0);
+  // The root's scrollLeft/scrollTop setters queue the document's scroll
+  // event for the next rendering update.
 }
 globalThis.scrollTo = function(x, y) { _windowScroll(x, y, false); };
 globalThis.scrollBy = function(x, y) { _windowScroll(x, y, true); };
