 crates/obscura-js/js/bootstrap.js             | 52 ++++++++++---------
 crates/obscura-js/src/runtime.rs              | 10 ++--
 crates/obscura-mcp/src/lib.rs                 |  7 +--
 5 files changed, 46 insertions(+), 49 deletions(-)

