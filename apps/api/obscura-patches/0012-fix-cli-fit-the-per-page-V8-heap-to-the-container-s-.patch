From 99ea29561b400f5e7cedd439fd6e567b473f5307 Mon Sep 17 00:00:00 2001
From: Aryan Randeriya <aryan.k.randeriya@gmail.com>
Date: Wed, 23 Sep 2026 18:46:41 +0530
Subject: [PATCH 12/18] fix(cli): fit the per-page V8 heap to the container's
 memory limit

Every page owns an isolate, and the fixed --max-old-space-size=4096 is larger
than a typical container. A page that retains memory without bound reached
3.9 GB before the near-heap-limit guard stopped its script; in a 3 GB cgroup
the kernel OOM-killed the whole engine first, taking every session with it.

Apply V8's own sizing rule (a quarter of memory, as Node does for cgroups) to
the tightest cgroup memory limit, never above the old default. With a 3 GB
limit each page gets 768 MB: the same page now stops at ~800 MB RSS and the
engine keeps serving other pages. --v8-flags still overrides.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Tm2SNEJ42hMPiZ6cFb8Vih
---
 crates/obscura-cli/src/main.rs | 91 ++++++++++++++++++++++++++++++++--
 1 file changed, 86 insertions(+), 5 deletions(-)

diff --git a/crates/obscura-cli/src/main.rs b/crates/obscura-cli/src/main.rs
index 16ebe9c..2c8b43a 100644
--- a/crates/obscura-cli/src/main.rs
+++ b/crates/obscura-cli/src/main.rs
@@ -323,11 +323,75 @@ const DEFAULT_V8_FLAGS: &str =
 const DEFAULT_V8_FLAGS: &str =
     "--max-old-space-size=1024 --max-semi-space-size=4 --optimize-for-size";
 
+#[cfg(test)]
 fn effective_v8_flags(user: Option<&str>) -> String {
-    match normalize_v8_flags(user) {
-        Some(u) => format!("{} {}", DEFAULT_V8_FLAGS, u),
-        None => DEFAULT_V8_FLAGS.to_string(),
+    effective_v8_flags_within(user, None)
+}
+
+/// The heap size in DEFAULT_V8_FLAGS, in MiB.
+#[cfg(target_pointer_width = "64")]
+const DEFAULT_HEAP_MB: u64 = 4096;
+#[cfg(not(target_pointer_width = "64"))]
+const DEFAULT_HEAP_MB: u64 = 1024;
+/// Floor for a container-derived heap, so a tiny limit still loads real pages.
+const MIN_CONTAINER_HEAP_MB: u64 = 128;
+
+/// DEFAULT_V8_FLAGS, then a heap cap fitted to `memory_limit_bytes`, then the
+/// user's flags (V8 takes the last value of a repeated flag, so the user wins).
+///
+/// The heap cap is per isolate, and each page owns an isolate. The fixed
+/// 4 GB default is larger than a typical container, so one page that retains
+/// memory without bound (a runaway microtask chain, a leaking timer) gets the
+/// container OOM-killed, and every other session with it, long before the V8
+/// near-heap-limit guard terminates the page's script. V8 sizes its default
+/// old generation to a quarter of physical memory, and Node applies the same
+/// rule to the cgroup limit; do the same, never above the fixed default.
+fn effective_v8_flags_within(user: Option<&str>, memory_limit_bytes: Option<u64>) -> String {
+    let mut flags = DEFAULT_V8_FLAGS.to_string();
+    if let Some(heap_mb) = container_heap_limit_mb(memory_limit_bytes) {
+        flags.push_str(&format!(" --max-old-space-size={heap_mb}"));
+    }
+    if let Some(u) = normalize_v8_flags(user) {
+        flags.push(' ');
+        flags.push_str(&u);
+    }
+    flags
+}
+
+/// A quarter of the memory limit in MiB, when that is below the default heap.
+fn container_heap_limit_mb(memory_limit_bytes: Option<u64>) -> Option<u64> {
+    let quarter_mb = memory_limit_bytes? / 4 / (1024 * 1024);
+    (quarter_mb < DEFAULT_HEAP_MB).then(|| quarter_mb.max(MIN_CONTAINER_HEAP_MB))
+}
+
+/// The tightest memory limit on this process's cgroup or any ancestor (cgroup
+/// v2 `memory.max`, else v1 `memory.limit_in_bytes`), or None when unlimited.
+fn cgroup_memory_limit_bytes() -> Option<u64> {
+    let read_limit = |path: &str| {
+        std::fs::read_to_string(path)
+            .ok()
+            .and_then(|raw| raw.trim().parse::<u64>().ok())
+            // cgroup v1 reports "unlimited" as a page-rounded i64::MAX.
+            .filter(|&bytes| bytes < (1 << 62))
+    };
+    let own = std::fs::read_to_string("/proc/self/cgroup").ok().and_then(|raw| {
+        raw.lines()
+            .find_map(|line| line.strip_prefix("0::").map(str::to_string))
+    });
+    if let Some(own) = own {
+        let mut path = std::path::PathBuf::from("/sys/fs/cgroup");
+        path.push(own.trim_start_matches('/'));
+        let mut tightest: Option<u64> = None;
+        for dir in path.ancestors().take_while(|dir| dir.starts_with("/sys/fs/cgroup")) {
+            if let Some(limit) = read_limit(&dir.join("memory.max").to_string_lossy()) {
+                tightest = Some(tightest.map_or(limit, |t| t.min(limit)));
+            }
+        }
+        if tightest.is_some() {
+            return tightest;
+        }
     }
+    read_limit("/sys/fs/cgroup/memory/memory.limit_in_bytes")
 }
 
 #[tokio::main(flavor = "current_thread")]
@@ -365,7 +429,8 @@ async fn main() -> anyhow::Result<()> {
         .with_writer(std::io::stderr)
         .init();
 
-    let v8_flags = effective_v8_flags(args.v8_flags.as_deref());
+    let v8_flags =
+        effective_v8_flags_within(args.v8_flags.as_deref(), cgroup_memory_limit_bytes());
     tracing::debug!("V8 flags: {}", v8_flags);
     obscura_js::set_v8_flags(&v8_flags);
 
@@ -1994,7 +2059,7 @@ fn dump_assets(page: &Page) -> String {
 #[cfg(test)]
 mod tests {
     use super::{
-        configure_fetch_navigation_timeout, effective_v8_flags, extract_assets,
+        configure_fetch_navigation_timeout, effective_v8_flags, effective_v8_flags_within, extract_assets,
         extract_readable_text, fetch_original_bytes, is_quiet_command, link_kind_from_rel,
         merge_proxy, normalize_v8_flags, read_urls_from_file, resolve_asset_url, select_log_filter,
         write_or_print, write_or_print_bytes, Args, Command, DumpFormat, DEFAULT_V8_FLAGS,
@@ -2376,6 +2441,22 @@ mod tests {
         assert!(merged.ends_with(user));
     }
 
+    #[test]
+    fn heap_fits_the_container_memory_limit() {
+        const GIB: u64 = 1024 * 1024 * 1024;
+        // No limit, or one big enough for the default: the default stands.
+        assert_eq!(effective_v8_flags_within(None, None), DEFAULT_V8_FLAGS);
+        assert_eq!(effective_v8_flags_within(None, Some(64 * GIB)), DEFAULT_V8_FLAGS);
+        // A 3 GiB container gives each page a quarter of it, after the default
+        // so it takes effect, and before the user's flags so they still win.
+        let merged = effective_v8_flags_within(Some("--max-old-space-size=900"), Some(3 * GIB));
+        assert!(merged.starts_with(DEFAULT_V8_FLAGS));
+        assert!(merged.ends_with(" --max-old-space-size=768 --max-old-space-size=900"));
+        // A tiny container keeps a usable floor.
+        assert!(effective_v8_flags_within(None, Some(GIB / 4))
+            .ends_with(" --max-old-space-size=128"));
+    }
+
     #[test]
     fn effective_v8_flags_appends_user_extras() {
         let merged = effective_v8_flags(Some("--expose-gc"));
