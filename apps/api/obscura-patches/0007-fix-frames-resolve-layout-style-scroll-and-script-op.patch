+    /// A script inserted by frame code runs once, in the frame. Its "already
+    /// started" flag belongs to the frame's document, not to whichever page
+    /// node happens to share its node id.
+    #[test]
+    fn frame_inserted_script_runs_once_in_the_frame() {
+        let mut parent = page(
+            "https://parent.example/page",
+            "<html><body><div><p>parent</p></div></body></html>",
+        );
+        let frame = FrameRealm::new(
+            &mut parent,
+            1,
+            0,
+            "https://child.example/frame",
+            "<html><body><script>globalThis.parsed = 1;</script></body></html>",
+        )
+        .expect("frame realm");
+
+        assert_eq!(
+            frame
+                .evaluate(
+                    &mut parent,
+                    r#"(() => {
+                        globalThis.ran = 0;
+                        const script = document.createElement("script");
+                        script.textContent = "globalThis.ran += 1;";
+                        document.body.appendChild(script);
+                        const afterInsert = globalThis.ran;
+                        // Moving a started script must not run it again.
+                        script.remove();
+                        document.body.appendChild(script);
+                        // Nor may moving a parser-inserted one.
+                        globalThis.parsed = 0;
+                        const parsed = document.querySelector("script");
+                        parsed.remove();
+                        document.body.appendChild(parsed);
+                        return [afterInsert, globalThis.ran, globalThis.parsed];
+                    })()"#,
+                )
+                .unwrap(),
+            serde_json::json!([1, 1, 0])
+        );
+    }
