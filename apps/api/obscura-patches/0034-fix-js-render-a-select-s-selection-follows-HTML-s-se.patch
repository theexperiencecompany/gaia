+    /// An option's selectedness: its dirty state, else its `selected`
+    /// attribute.
+    pub fn option_selectedness(&self, option: NodeId) -> bool {
+        self.form_control_checked(option).unwrap_or_else(|| {
+            self.with_node(option, |node| node.get_attribute("selected").is_some())
+                .unwrap_or(false)
+        })
+    }
+
+    /// A `<select>`'s list of options (HTML): its option children and the
+    /// option children of its optgroup children, in tree order.
+    pub fn select_options(&self, select: NodeId) -> Vec<NodeId> {
+        let local = |id: NodeId| {
+            self.with_node(id, |node| node.as_element().map(|name| name.local.to_string()))
+                .flatten()
+        };
+        let mut options = Vec::new();
+        for child in self.children(select) {
+            match local(child).as_deref() {
+                Some("option") => options.push(child),
+                Some("optgroup") => options.extend(
+                    self.children(child)
+                        .into_iter()
+                        .filter(|grandchild| local(*grandchild).as_deref() == Some("option")),
+                ),
+                _ => {}
+            }
+        }
+        options
+    }
+
+    /// The options a `<select>` has selected, as HTML's selectedness setting
+    /// algorithm leaves them: every selected option for a multiple select or
+    /// one shown as a list box (size > 1); otherwise exactly one, the last
+    /// selected option, or with none the first option that is not disabled.
+    pub fn selected_options(&self, select: NodeId) -> Vec<NodeId> {
+        let options = self.select_options(select);
+        let mut selected: Vec<NodeId> = options
+            .iter()
+            .copied()
+            .filter(|option| self.option_selectedness(*option))
+            .collect();
+        let (multiple, size) = self
+            .with_node(select, |node| {
+                (
+                    node.get_attribute("multiple").is_some(),
+                    node.get_attribute("size")
+                        .and_then(|size| size.trim().parse::<u32>().ok())
+                        .unwrap_or(1),
+                )
+            })
+            .unwrap_or((false, 1));
+        if multiple || size > 1 {
+            return selected;
+        }
+        if let Some(last) = selected.pop() {
+            return vec![last];
+        }
+        let disabled = |id: NodeId| {
+            self.with_node(id, |node| node.get_attribute("disabled").is_some())
+                .unwrap_or(false)
+        };
+        options
+            .into_iter()
+            .find(|option| {
+                !disabled(*option)
+                    && self
+                        .get_node(*option)
+                        .and_then(|node| node.parent)
+                        .is_none_or(|parent| parent == select || !disabled(parent))
+            })
+            .into_iter()
+            .collect()
+    }
+
     pub fn form_control_indeterminate(&self, node: NodeId) -> bool {
         self.inner
             .borrow()
