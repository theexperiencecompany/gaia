+/// Compiles and runs `source` as a classic script of its own, in the current
+/// context, the way a browser runs a `<script>`.
+///
+/// The script's URL is its V8 resource name, so stacks, `window.onerror` and
+/// `import()` see the script where a browser would (`https://host/app.js:2:7`),
+/// and top-level `var` and function declarations become globals of the realm.
+/// An uncaught exception, including a SyntaxError, is reported to the realm's
+/// `onerror` and `error` listeners with that URL and position, then cleared.
+///
+/// Returns false only when execution is being terminated; the termination is
+/// left pending so it unwinds whatever JavaScript is below.
+pub(crate) fn run_classic_script(scope: &mut v8::HandleScope, source: &str, url: &str) -> bool {
+    let Some(code) = v8::String::new(scope, source) else {
+        return true;
+    };
+    let Some(name) = v8::String::new(scope, url) else {
+        return true;
+    };
+    let origin = v8::ScriptOrigin::new(
+        scope,
+        name.into(),
+        0,
+        0,
+        false,
+        0,
+        None,
+        false,
+        false,
+        false,
+        None,
+    );
+    let scope = &mut v8::TryCatch::new(scope);
+    let ran = v8::Script::compile(scope, code, Some(&origin))
+        .and_then(|script| script.run(scope))
+        .is_some();
+    if ran {
+        return true;
+    }
+    if scope.has_terminated() || scope.is_execution_terminating() {
+        return false;
+    }
+    if let Some(exception) = scope.exception() {
+        report_script_exception(scope, exception);
+    }
+    true
+}
+
+/// HTML's "report the exception" for a script's uncaught exception: hands the
+/// message, the source URL, the 1-based line and column and the thrown value to
+/// the current realm's reporter, which fires `onerror` and `error` listeners.
+pub(crate) fn report_script_exception(
+    scope: &mut v8::TryCatch<v8::HandleScope>,
+    exception: v8::Local<v8::Value>,
+) {
+    let (text, filename, line, column) = match scope.message() {
+        Some(message) => {
+            let text = message.get(scope).into();
+            let filename = message
+                .get_script_resource_name(scope)
+                .filter(|name| name.is_string())
+                .unwrap_or_else(|| v8::String::empty(scope).into());
+            let line = message.get_line_number(scope).unwrap_or(0) as i32;
+            let column = message.get_start_column() as i32 + 1;
+            (text, filename, line, column)
+        }
+        None => {
+            let text = exception
+                .to_string(scope)
+                .unwrap_or_else(|| v8::String::empty(scope));
+            (text.into(), v8::String::empty(scope).into(), 0, 0)
+        }
+    };
+    let context = scope.get_current_context();
+    let global = context.global(scope);
+    let Some(key) = v8::String::new(scope, "__obscura_reportScriptError") else {
+        return;
+    };
+    let scope = &mut v8::TryCatch::new(scope);
+    let Some(reporter) = global
+        .get(scope, key.into())
+        .and_then(|value| v8::Local::<v8::Function>::try_from(value).ok())
+    else {
+        return;
+    };
+    let line = v8::Integer::new(scope, line).into();
+    let column = v8::Integer::new(scope, column).into();
+    reporter.call(scope, global.into(), &[text, filename, line, column, exception]);
+}
+
+/// Runs a script element's source as its own classic script in the realm named
+/// by `frame_id`, calling `before` just before it and `done` just after it.
+///
+/// An inserted inline script runs synchronously, so bootstrap.js calls this
+/// directly. A fetched script runs as its own task: bootstrap.js queues this op
+/// itself as a microtask, so no bootstrap function is on the stack below
+/// the script, as in a browser's script-execution task. `before` and `done`
+/// bracket the script inside that one call, where bootstrap sets and restores
+/// `document.currentScript`; nothing another task queued can run in between.
+#[op2(nofast, reentrant)]
+fn op_script_run_classic(
+    scope: &mut v8::HandleScope,
+    state: Rc<RefCell<OpState>>,
+    #[string] source: String,
+    #[string] url: String,
+    frame_id: u32,
+    before: v8::Local<v8::Value>,
+    done: v8::Local<v8::Value>,
+) {
+    // A native op is bound in the page realm, so the page's context is the
+    // current one; a frame's is looked up by the id its bootstrap passed.
+    let context = if frame_id == 0 {
+        scope.get_current_context()
+    } else {
+        let registry = state
+            .borrow()
+            .try_borrow::<Rc<RefCell<RealmStates>>>()
+            .cloned();
+        let Some(context) =
+            registry.and_then(|registry| registry.borrow().context_by_frame_id(frame_id))
+        else {
+            // The frame is gone; its scripts no longer run.
+            return;
+        };
+        v8::Local::new(scope, context)
+    };
+    let receiver: v8::Local<v8::Value> = v8::undefined(scope).into();
+    if let Ok(before) = v8::Local::<v8::Function>::try_from(before) {
+        if before.call(scope, receiver, &[]).is_none() {
+            return;
+        }
+    }
+    let completed = {
+        let scope = &mut v8::ContextScope::new(scope, context);
+        run_classic_script(scope, &source, &url)
+    };
+    if !completed {
+        return;
+    }
+    if let Ok(done) = v8::Local::<v8::Function>::try_from(done) {
+        done.call(scope, receiver, &[]);
+    }
+}
