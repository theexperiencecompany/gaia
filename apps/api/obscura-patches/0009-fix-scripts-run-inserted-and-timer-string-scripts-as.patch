+    /// A fetched dynamic script runs as its own classic script named by its URL,
+    /// as in a browser: its stack reads `https://host/app.js:line:col` with no
+    /// engine frames, `onerror` gets that URL, and top-level declarations
+    /// become globals.
+    #[tokio::test(flavor = "current_thread")]
+    async fn dynamic_external_script_runs_as_its_own_script_named_by_its_url() {
+        let mut rt = setup_runtime("<html><head></head><body></body></html>");
+        let result = rt
+            .call_function_on_for_cdp(
+                r#"async () => {
+                    const originalFetchOp = Deno.core.ops.op_fetch_url;
+                    const reports = [];
+                    const listened = [];
+                    globalThis.onerror = (message, source, line, column, error) => {
+                        reports.push([message, source, line, column, error instanceof Error]);
+                        return true;
+                    };
+                    addEventListener("error", event => listened.push([event.filename, event.lineno]));
+                    try {
+                        Deno.core.ops.op_fetch_url = (url) => JSON.stringify({
+                            status: 200,
+                            headers: { "content-type": "text/javascript" },
+                            body: "var dynTopVar = 1;\nfunction dynTopFn() {}\n" +
+                                  "globalThis.dynStack = new Error('x').stack;\n" +
+                                  "globalThis.dynCurrent = document.currentScript && document.currentScript.id;\n" +
+                                  "throw new Error('boom');",
+                            url,
+                        });
+                        const script = document.createElement("script");
+                        script.id = "dyn";
+                        script.src = "/assets/app.js";
+                        const outcome = await new Promise(resolve => {
+                            script.onload = () => resolve("load");
+                            script.onerror = () => resolve("error");
+                            document.head.appendChild(script);
+                        });
+                        return {
+                            outcome,
+                            stack: globalThis.dynStack.split("\n").slice(0, 2),
+                            engineFrames: /eval at|obscura:bootstrap/.test(globalThis.dynStack),
+                            current: globalThis.dynCurrent,
+                            currentAfter: document.currentScript,
+                            topVar: globalThis.dynTopVar,
+                            topFn: typeof globalThis.dynTopFn,
+                            reports,
+                            listened,
+                        };
+                    } finally {
+                        Deno.core.ops.op_fetch_url = originalFetchOp;
+                    }
+                }"#,
+                None,
+                &[],
+                true,
+                true,
+            )
+            .await
+            .unwrap();
+
+        assert_eq!(
+            result.value.unwrap(),
+            serde_json::json!({
+                "outcome": "load",
+                "stack": ["Error: x", "    at http://example.com/assets/app.js:3:23"],
+                "engineFrames": false,
+                "current": "dyn",
+                "currentAfter": null,
+                "topVar": 1,
+                "topFn": "function",
+                "reports": [[
+                    "Uncaught Error: boom",
+                    "http://example.com/assets/app.js",
+                    5,
+                    1,
+                    true,
+                ]],
+                "listened": [["http://example.com/assets/app.js", 5]],
+            })
+        );
+    }
