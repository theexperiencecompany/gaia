+    #[cfg(feature = "render")]
+    #[test]
+    fn check_visibility_counts_inline_svg_content_as_boxes() {
+        // The SVG renderer draws an inline <svg>'s content inside the root's
+        // box, so its shapes have no rect of their own but are visible.
+        let dom = parse_html(
+            r#"<html><body>
+                <svg id="icon" width="20" height="20"><g id="g"><path id="path" d="M0 0h10v10z"/></g>
+                  <g id="gone" style="display:none"><rect id="under-gone" width="5" height="5"/></g>
+                  <rect id="hidden" style="visibility:hidden" width="5" height="5"/></svg>
+                <svg id="unrendered" style="display:none"><rect id="in-unrendered" width="5" height="5"/></svg>
+            </body></html>"#,
+        );
+        let mut rt = ObscuraJsRuntime::new();
+        rt.set_dom(dom);
+        rt.set_viewport(800.0, 600.0);
+        rt.run_page_init();
+
+        let result = rt
+            .evaluate(
+                r#"Object.fromEntries(["icon", "g", "path", "gone", "under-gone", "hidden", "unrendered", "in-unrendered"]
+                    .map(id => [id, document.getElementById(id).checkVisibility({checkVisibilityCSS: true})]))"#,
+            )
+            .unwrap();
+        assert_eq!(
+            result,
+            serde_json::json!({
+                "icon": true, "g": true, "path": true, "gone": false, "under-gone": false,
+                "hidden": false, "unrendered": false, "in-unrendered": false,
+            })
+        );
+    }
