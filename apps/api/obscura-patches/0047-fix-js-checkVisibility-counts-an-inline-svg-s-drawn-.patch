+    /// Whether the element generates a box (CSSOM View checkVisibility step 1).
+    /// The content of an inline `<svg>` is drawn by the SVG renderer inside the
+    /// root's box rather than laid out, so it has no rect of its own; an SVG
+    /// element under a root that has a box generates one unless it or an SVG
+    /// ancestor computes `display: none`.
+    pub fn generates_box(&self, tree: &DomTree, id: obscura_dom::tree::NodeId) -> bool {
+        const SVG: &str = "http://www.w3.org/2000/svg";
+        let rects = &self.layout.rects;
+        if rects.contains_key(&id) {
+            return true;
+        }
+        let mut current = Some(id);
+        while let Some(node) = current {
+            let Some(is_svg_root) = tree
+                .with_node(node, |n| {
+                    n.as_element()
+                        .filter(|name| &*name.ns == SVG)
+                        .map(|name| &*name.local == "svg")
+                })
+                .flatten()
+            else {
+                return false;
+            };
+            if node != id && is_svg_root && rects.contains_key(&node) {
+                return true;
+            }
+            if self
+                .layout
+                .styles
+                .get(&node)
+                .is_none_or(|style| style.display == crate::Display::None)
+            {
+                return false;
+            }
+            current = tree.with_node(node, |n| n.parent).flatten();
+        }
+        false
+    }
+
