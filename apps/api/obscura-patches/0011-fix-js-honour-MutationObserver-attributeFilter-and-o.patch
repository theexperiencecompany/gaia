+// MutationObserver per DOM §4.3. Observers that registered at least once, in
+// registration order; "notify mutation observers" walks this list.
 globalThis.__mutationObservers = [];
+// One pending "mutation observer microtask" for the whole agent, as the spec
+// has it, rather than one per queued record.
+let _mutationObserverMicrotaskQueued = false;
+// Captured before page script runs, so a page that replaces queueMicrotask or
+// Promise cannot reroute (or drop) observer delivery.
+const _queueEngineMicrotask = globalThis.queueMicrotask.bind(globalThis);
+function _notifyMutationObservers() {
+  _mutationObserverMicrotaskQueued = false;
+  for (const observer of [...globalThis.__mutationObservers]) {
+    if (observer._records.length === 0) continue;
+    const records = observer._records.splice(0);
+    try { observer._callback.call(observer, records, observer); }
+    catch (e) { /* observer errors shouldn't propagate */ }
+  }
+}
+function _queueMutationObserverMicrotask() {
+  if (_mutationObserverMicrotaskQueued) return;
+  _mutationObserverMicrotaskQueued = true;
+  _queueEngineMicrotask(_notifyMutationObservers);
+}
 globalThis.MutationObserver = class MutationObserver {
   constructor(callback) {
+    if (typeof callback !== "function") {
+      throw new TypeError(
+        "Failed to construct 'MutationObserver': parameter 1 is not of type 'Function'."
+      );
+    }
     this._callback = callback;
     this._targets = [];
     this._records = [];
   }
   observe(target, options) {
-    this._targets.push({ target, options: options || {} });
-    globalThis.__mutationObservers.push(this);
+    if (!target || target._nid == null) {
+      throw new TypeError(
+        "Failed to execute 'observe' on 'MutationObserver': parameter 1 is not of type 'Node'."
+      );
+    }
+    const given = options == null ? {} : options;
+    const init = {
+      childList: !!given.childList,
+      subtree: !!given.subtree,
+      attributes: given.attributes === undefined ? undefined : !!given.attributes,
+      characterData: given.characterData === undefined ? undefined : !!given.characterData,
+      attributeOldValue: given.attributeOldValue === undefined ? undefined : !!given.attributeOldValue,
+      characterDataOldValue: given.characterDataOldValue === undefined ? undefined : !!given.characterDataOldValue,
+      attributeFilter: given.attributeFilter === undefined ? undefined : Array.from(given.attributeFilter, String),
+    };
+    // An old-value or filter option implies the mutation type it qualifies.
+    if ((init.attributeOldValue !== undefined || init.attributeFilter !== undefined)
+        && init.attributes === undefined) init.attributes = true;
+    if (init.characterDataOldValue !== undefined && init.characterData === undefined) {
+      init.characterData = true;
+    }
+    const fail = (why) => {
+      throw new TypeError(`Failed to execute 'observe' on 'MutationObserver': ${why}`);
+    };
+    if (!init.childList && !init.attributes && !init.characterData) {
+      fail("The options object must set at least one of 'attributes', 'characterData', or 'childList' to true.");
+    }
+    if (init.attributeOldValue && !init.attributes) {
+      fail("The options object may only set 'attributeOldValue' to true when 'attributes' is true or not present.");
+    }
+    if (init.attributeFilter !== undefined && !init.attributes) {
+      fail("The options object may only set 'attributeFilter' when 'attributes' is true or not present.");
+    }
+    if (init.characterDataOldValue && !init.characterData) {
+      fail("The options object may only set 'characterDataOldValue' to true when 'characterData' is true or not present.");
+    }
+    if (init.attributeFilter !== undefined) init.attributeFilter = new Set(init.attributeFilter);
+    // Observing a node this observer already watches replaces its options
+    // instead of adding a second registration.
+    const existing = this._targets.find((registration) => registration.target === target);
+    if (existing) existing.options = init;
+    else this._targets.push({ target, options: init });
+    if (!globalThis.__mutationObservers.includes(this)) {
+      globalThis.__mutationObservers.push(this);
+    }
   }
   disconnect() {
     this._targets = [];
+    this._records = [];
     const idx = globalThis.__mutationObservers.indexOf(this);
     if (idx >= 0) globalThis.__mutationObservers.splice(idx, 1);
   }
   takeRecords() {
-    const r = this._records.slice();
-    this._records = [];
-    return r;
+    return this._records.splice(0);
   }
   _notify(records) {
     this._records.push(...records);
-    Promise.resolve().then(() => {
-      if (this._records.length > 0) {
-        const batch = this._records.splice(0);
-        try { this._callback(batch, this); } catch(e) { /* observer errors shouldn't propagate */ }
-      }
-    });
+    _queueMutationObserverMicrotask();
   }
 };
+// "Queue a mutation record": one record per interested observer, chosen by
+// each registration's options. attributeFilter matters beyond fidelity: an
+// observer that watches only `src` and rewrites `type`/`class` from its own
+// callback must not be told about those writes, or it re-triggers itself in
+// an endless microtask chain that never yields to the event loop.
