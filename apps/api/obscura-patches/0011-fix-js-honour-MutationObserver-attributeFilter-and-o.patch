-  // wired up at appendChild / setAttribute. _wrap also lazily creates a
-  // wrapper for nodes that didn't have one yet (e.g. children parsed from
+  // Use `_wrap` (the canonical node-id → wrapper resolver): it lazily creates
+  // a wrapper for nodes that didn't have one yet (e.g. children parsed from
   // `set innerHTML`), which we need for record.target/added/removed.
   const target = _wrap(target_nid);
   if (!target) return;
-  const record = {
-    type: type, // 'childList', 'attributes', 'characterData'
-    target: target,
-    addedNodes: (addedNodes || []).map(nid => _wrap(nid)).filter(Boolean),
-    removedNodes: (removedNodes || []).map(nid => _wrap(nid)).filter(Boolean),
-    attributeName: attributeName || null,
-    oldValue: oldValue ?? null,
-    previousSibling: null,
-    nextSibling: null,
+  // Inclusive ancestors, computed once and only if a subtree registration
+  // could need them.
+  let ancestors = null;
+  const isAncestor = (nid) => {
+    if (!ancestors) {
+      ancestors = new Set();
+      let cur = target.parentNode;
+      while (cur) { ancestors.add(cur._nid); cur = cur.parentNode; }
+    }
+    return ancestors.has(nid);
   };
-  // Walk target → ancestors so a subtree-mode observer rooted at any
-  // ancestor matches. The previous implementation just checked that
-  // `target.contains` and `target.closest` were defined (always true on
-  // any Element), so subtree=true silently behaved like subtree=false and
-  // every nested mutation missed its subscriber.
+  const interested = new Map();
   for (const obs of globalThis.__mutationObservers) {
-    let matched = false;
-    for (const t of obs._targets) {
-      const root = t.target;
+    for (const { target: root, options } of obs._targets) {
       if (!root) continue;
-      // Filter by type per the observer options. Default behaviour matches
-      // real MutationObserver: attribute mutations need options.attributes,
-      // characterData mutations need options.characterData, childList
-      // needs options.childList.
-      const wantsType =
-        (type === 'attributes' && t.options.attributes) ||
-        (type === 'characterData' && t.options.characterData) ||
-        (type === 'childList' && t.options.childList);
-      if (!wantsType) continue;
-      if (root._nid === target_nid) { matched = true; break; }
-      if (t.options.subtree) {
-        // Walk parents until we hit the observed root or run off the tree.
-        let cur = target.parentNode;
-        while (cur) {
-          if (cur._nid === root._nid) { matched = true; break; }
-          cur = cur.parentNode;
-        }
-        if (matched) break;
+      if (type === 'attributes') {
+        if (!options.attributes) continue;
+        if (options.attributeFilter && !options.attributeFilter.has(attributeName)) continue;
+      } else if (type === 'characterData') {
+        if (!options.characterData) continue;
+      } else if (type === 'childList') {
+        if (!options.childList) continue;
       }
-    }
-    if (matched) obs._notify([record]);
+      if (root._nid !== target_nid && !(options.subtree && isAncestor(root._nid))) continue;
+      const wantsOld = (type === 'attributes' && options.attributeOldValue)
+        || (type === 'characterData' && options.characterDataOldValue);
+      if (!interested.has(obs) || wantsOld) interested.set(obs, wantsOld ? (oldValue ?? null) : null);
+    }
+  }
+  if (!interested.size) return;
+  const added = (addedNodes || []).map(nid => _wrap(nid)).filter(Boolean);
+  const removed = (removedNodes || []).map(nid => _wrap(nid)).filter(Boolean);
+  for (const [obs, recordOldValue] of interested) {
+    obs._notify([{
+      type: type, // 'childList', 'attributes', 'characterData'
+      target: target,
+      addedNodes: added.slice(),
+      removedNodes: removed.slice(),
+      attributeName: attributeName || null,
+      attributeNamespace: null,
+      oldValue: recordOldValue,
+      previousSibling: null,
+      nextSibling: null,
+    }]);
   }
 };
 
diff --git a/crates/obscura-js/src/runtime.rs b/crates/obscura-js/src/runtime.rs
index 3644850..fbb4043 100644
--- a/crates/obscura-js/src/runtime.rs
+++ b/crates/obscura-js/src/runtime.rs
@@ -20950,6 +20950,89 @@ mod tests {
         assert_eq!(result, serde_json::json!("SPAN"));
     }
 
+    // A consent manager's script blocker (OneTrust OtAutoBlock on booking.com)
+    // watches only `src` and, from its callback, rewrites `type` and `class` on
+    // the same script. With attributeFilter ignored every rewrite re-notified
+    // the observer, an endless microtask chain that pinned a CPU and grew the
+    // heap by ~16 MB/s. The callback must run once per `src` change, and the
+    // engine must go idle.
+    #[tokio::test(flavor = "current_thread")]
+    async fn mutation_observer_attribute_filter_stops_self_triggering_callback() {
+        let mut rt = setup_runtime("<html><head></head><body></body></html>");
+        rt.execute_script(
+            "mutation-observer-self-trigger",
+            r#"
+                globalThis.__calls = 0;
+                globalThis.__names = [];
+                new MutationObserver((records) => {
+                    // Cap the chain so the old behaviour fails the test instead of hanging it.
+                    if (++__calls > 50) return;
+                    for (const record of records) {
+                        __names.push(record.attributeName);
+                        const script = record.target;
+                        script.setAttribute("type", "text/plain");
+                        script.setAttribute("class", "optanon-category-C0004");
+                    }
+                }).observe(document.documentElement, {
+                    childList: true, subtree: true, attributes: true, attributeFilter: ["src"],
+                });
+                const script = document.createElement("script");
+                script.setAttribute("data-x", "1");
+                document.head.appendChild(script);
+                script.setAttribute("src", "https://example.com/gtm.js");
+            "#,
+        )
+        .unwrap();
+        rt.run_event_loop_bounded(200).await.unwrap();
+        assert_eq!(
+            rt.evaluate("[__calls, __names.join(',')]").unwrap(),
+            serde_json::json!([1, ",src"])
+        );
+    }
+
+    // Per DOM "observe": re-observing a node replaces its options rather than
+    // registering twice, attributeOldValue/attributeFilter imply attributes,
+    // oldValue is reported only when asked for, and invalid options throw.
+    #[tokio::test(flavor = "current_thread")]
+    async fn mutation_observer_observe_options_follow_the_spec() {
+        let mut rt = setup_runtime(r#"<html><body><div id="t" title="a"></div></body></html>"#);
+        rt.execute_script(
+            "mutation-observer-options",
+            r#"
+                const t = document.getElementById("t");
+                globalThis.__seen = [];
+                const observer = new MutationObserver((records) => {
+                    for (const r of records) __seen.push(`${r.type}:${r.attributeName}:${r.oldValue}`);
+                });
+                observer.observe(t, { attributes: true });
+                observer.observe(t, { attributeOldValue: true, attributeFilter: ["title"] });
+                t.setAttribute("title", "b");
+                t.setAttribute("lang", "en");
+                const plain = new MutationObserver((records) => {
+                    for (const r of records) __seen.push(`plain:${r.attributeName}:${r.oldValue}`);
+                });
+                plain.observe(t, { attributes: true });
+                t.setAttribute("title", "c");
+                globalThis.__errors = [
+                    () => observer.observe(t, {}),
+                    () => observer.observe(t, { attributes: false, attributeFilter: ["x"] }),
+                    () => observer.observe(t, { childList: true, attributeOldValue: true, attributes: false }),
+                    () => observer.observe(null, { childList: true }),
+                    () => new MutationObserver(null),
+                ].map((f) => { try { f(); return "none"; } catch (e) { return e.name; } });
+            "#,
+        )
+        .unwrap();
+        rt.run_event_loop_bounded(200).await.unwrap();
+        assert_eq!(
+            rt.evaluate("[__seen.join('|'), __errors.join(',')]").unwrap(),
+            serde_json::json!([
+                "attributes:title:a|attributes:title:b|plain:title:null",
+                "TypeError,TypeError,TypeError,TypeError,TypeError"
+            ])
+        );
+    }
+
     #[test]
     fn document_write_registers_window_named_access() {
         let mut rt = setup_runtime("<html><body></body></html>");
