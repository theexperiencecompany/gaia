     let mut backend_ids: Vec<i64> = Vec::with_capacity(n);
     let mut attributes: Vec<Value> = Vec::with_capacity(n);
     let mut clickable: Vec<i64> = Vec::new();
+    // Live form state, as Chrome reports it: what a field holds now, not its
+    // value attribute. DOM agents read these to see what was already typed.
+    let mut input_value_index: Vec<i64> = Vec::new();
+    let mut input_value: Vec<i64> = Vec::new();
+    let mut input_checked: Vec<i64> = Vec::new();
+    let mut option_selected: Vec<i64> = Vec::new();
 
     // Layout arrays are 1:1 with nodes (nodeIndex[i] == i).
     let mut layout_node_index: Vec<i64> = Vec::with_capacity(n);
@@ -195,6 +201,19 @@ fn build_capture_snapshot(dom: &DomTree, url: &str, title: &str) -> Value {
         }
         attributes.push(json!(attr_idx));
 
+        if let Some(value) = live_input_value(dom, nid, &tag, &attrs) {
+            input_value_index.push(i as i64);
+            input_value.push(strings.intern(&value));
+        }
+        if is_checkable(&tag, &attrs)
+            && dom.form_control_checked(nid).unwrap_or_else(|| has_attr(&attrs, "checked"))
+        {
+            input_checked.push(i as i64);
+        }
+        if tag == "option" && has_attr(&attrs, "selected") {
+            option_selected.push(i as i64);
+        }
+
         let interactive = matches!(
             tag.as_str(),
             "a" | "button" | "input" | "select" | "textarea" | "summary" | "details" | "option" | "label"
@@ -258,6 +277,9 @@ fn build_capture_snapshot(dom: &DomTree, url: &str, title: &str) -> Value {
                 "backendNodeId": backend_ids,
                 "attributes": attributes,
                 "isClickable": { "index": clickable },
+                "inputValue": { "index": input_value_index, "value": input_value },
+                "inputChecked": { "index": input_checked },
+                "optionSelected": { "index": option_selected },
             },
             "layout": {
                 "nodeIndex": layout_node_index,
@@ -277,6 +299,47 @@ fn build_capture_snapshot(dom: &DomTree, url: &str, title: &str) -> Value {
     })
 }
 
+fn attr<'a>(attrs: &'a [(String, String)], name: &str) -> Option<&'a str> {
+    attrs.iter().find(|(k, _)| k.eq_ignore_ascii_case(name)).map(|(_, v)| v.as_str())
+}
+
+fn has_attr(attrs: &[(String, String)], name: &str) -> bool {
+    attr(attrs, name).is_some()
+}
+
+fn input_type(attrs: &[(String, String)]) -> String {
+    attr(attrs, "type").unwrap_or("text").to_ascii_lowercase()
+}
+
+fn is_checkable(tag: &str, attrs: &[(String, String)]) -> bool {
+    tag == "input" && matches!(input_type(attrs).as_str(), "checkbox" | "radio")
+}
+
+/// The value an input or textarea holds now, the one its `value` getter returns:
+/// the live control state once script or typing set it, else the default.
+fn live_input_value(
+    dom: &DomTree,
+    nid: NodeId,
+    tag: &str,
+    attrs: &[(String, String)],
+) -> Option<String> {
+    if tag != "input" && tag != "textarea" {
+        return None;
+    }
+    if let Some(value) = dom.form_control_state(nid).and_then(|control| control.value) {
+        return Some(value);
+    }
+    if tag == "textarea" {
+        return Some(dom.text_content(nid));
+    }
+    Some(match input_type(attrs).as_str() {
+        // A checkbox or radio with no value attribute submits "on".
+        "checkbox" | "radio" => attr(attrs, "value").unwrap_or("on").to_string(),
+        "file" => String::new(),
+        _ => attr(attrs, "value").unwrap_or("").to_string(),
+    })
+}
+
