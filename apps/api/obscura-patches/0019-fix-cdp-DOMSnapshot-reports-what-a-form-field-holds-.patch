+    /// Node index in the snapshot of the element whose id attribute is `id`.
+    fn row_with_id(snap: &Value, id: &str) -> i64 {
+        let strings = snap["strings"].as_array().unwrap();
+        let attrs = snap["documents"][0]["nodes"]["attributes"].as_array().unwrap();
+        attrs
+            .iter()
+            .position(|pairs| {
+                pairs.as_array().unwrap().chunks(2).any(|kv| {
+                    strings[kv[0].as_u64().unwrap() as usize] == "id"
+                        && strings[kv[1].as_u64().unwrap() as usize] == id
+                })
+            })
+            .unwrap_or_else(|| panic!("#{id} should be in the snapshot")) as i64
+    }
+
+    #[tokio::test]
+    async fn capture_snapshot_reports_live_form_state() {
+        // DOM agents read what a field holds from inputValue/inputChecked/
+        // optionSelected; without them every typed field read as empty and the
+        // agent typed it again.
+        let mut ctx = CdpContext::new();
+        let session = navigate(
+            &mut ctx,
+            "<input id=t value=orig><input id=p type=password><textarea id=a>x</textarea>\
+             <input id=c type=checkbox><input id=r type=radio checked><input id=u type=checkbox>\
+             <select id=s><option id=o1>One</option><option id=o2 value=2>Two</option></select>",
+        )
+        .await;
+        let typed = ctx.get_session_page_mut(&Some(session.clone())).unwrap().evaluate(
+            "(() => { const e = (id) => document.getElementById(id); \
+             e('t').value = 'Aryan'; e('p').value = 'gaia-test-123'; e('a').value = 'typed'; \
+             e('c').checked = true; e('r').checked = false; e('s').value = '2'; \
+             return e('t').value; })()",
+        );
+        assert_eq!(typed, json!("Aryan"), "the page script ran");
+
+        let snap = handle("captureSnapshot", &json!({}), &mut ctx, &Some(session.clone()))
+            .await
+            .expect("captureSnapshot should succeed");
+        let nodes = &snap["documents"][0]["nodes"];
+        let strings = snap["strings"].as_array().unwrap();
+        let rows = |column: &str| -> Vec<i64> {
+            nodes[column]["index"].as_array().unwrap().iter().map(|v| v.as_i64().unwrap()).collect()
+        };
+        let value_rows = rows("inputValue");
+        let value_of = |id: &str| -> String {
+            let at = value_rows
+                .iter()
+                .position(|&row| row == row_with_id(&snap, id))
+                .unwrap_or_else(|| panic!("#{id} should have an inputValue"));
+            let string = nodes["inputValue"]["value"][at].as_u64().unwrap() as usize;
+            strings[string].as_str().unwrap().to_string()
+        };
+        assert_eq!(value_of("t"), "Aryan");
+        assert_eq!(value_of("p"), "gaia-test-123");
+        assert_eq!(value_of("a"), "typed");
+        assert_eq!(value_of("u"), "on", "an untouched checkbox submits its default value");
+
+        let checked = rows("inputChecked");
+        assert!(checked.contains(&row_with_id(&snap, "c")), "a checkbox ticked by script is checked");
+        assert!(!checked.contains(&row_with_id(&snap, "r")), "a radio unticked by script is not");
+        assert!(!checked.contains(&row_with_id(&snap, "u")));
+
+        let selected = rows("optionSelected");
+        assert_eq!(selected, vec![row_with_id(&snap, "o2")]);
+    }
+
