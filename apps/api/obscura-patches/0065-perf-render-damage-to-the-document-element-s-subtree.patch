-    dirty.insert(root);
-    dirty.extend(style_descendants(tree, root));
+fn add_style_subtree(tree: &DomTree, root: NodeId, dirty: &mut StyleDamage) {
+    if dirty.everything {
+        return;
+    }
+    // The document element's style subtree is every styled node.
+    if root == tree.document() || document_element(tree) == Some(root) {
+        dirty.everything = true;
+        return;
+    }
     // Rebuild the context chain too. A retained ancestor may carry a final
     // post-layout Px repair (native controls, blockification, table/grid
     // fixups) where a full pass would feed its specified Auto/inherit form to
     // the fresh descendant's normalization. Ancestors are fresh individually;
     // their unrelated sibling subtrees remain reusable.
-    dirty.extend(style_ancestors(tree, root));
+    let ancestors = style_ancestors(tree, root);
+    // A subtree inside one already added is already dirty, with its context.
+    if dirty.subtree_roots.contains(&root)
+        || ancestors.iter().any(|ancestor| dirty.subtree_roots.contains(ancestor))
+    {
+        return;
+    }
+    dirty.subtree_roots.insert(root);
+    dirty.insert(root);
+    dirty.extend(style_descendants(tree, root));
+    dirty.extend(ancestors);
+}
+
+/// The nodes a retained restyle must re-cascade. `everything` stands for the
+/// whole document (a full cascade); `subtree_roots` are the roots whose entire
+/// style subtrees are already in `nodes`, so a subtree inside one is not
+/// walked again.
+#[derive(Debug, Default)]
+struct StyleDamage {
+    nodes: HashSet<NodeId>,
+    subtree_roots: HashSet<NodeId>,
+    everything: bool,
+}
+
+impl StyleDamage {
+    fn insert(&mut self, node: NodeId) -> bool {
+        !self.everything && self.nodes.insert(node)
+    }
+
+    fn extend(&mut self, nodes: impl IntoIterator<Item = NodeId>) {
+        if !self.everything {
+            self.nodes.extend(nodes);
+        }
+    }
+
+    fn len(&self) -> usize {
+        self.nodes.len()
+    }
+
+    fn is_empty(&self) -> bool {
+        !self.everything && self.nodes.is_empty()
+    }
+}
+
+/// The document's root element.
+fn document_element(tree: &DomTree) -> Option<NodeId> {
+    tree.children(tree.document())
+        .into_iter()
+        .find(|child| tree.with_node(*child, |node| node.is_element()).unwrap_or(false))
 }
 
