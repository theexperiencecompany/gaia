+    /// A change that damages the document element's whole style subtree is
+    /// planned as a whole-document restyle without enumerating the document,
+    /// and nested subtree damage is walked once.
+    #[test]
+    fn root_subtree_damage_plans_a_whole_document_restyle() {
+        let tree = parse_html(
+            "<html><body><main id=main><p id=inner><b id=deep></b></p></main></body></html>",
+        );
+        let id = |name: &str| tree.get_element_by_id(name).unwrap();
+        let html = document_element(&tree).unwrap();
+        let sheet = crate::css::Stylesheet::parse_for_viewport(
+            &tree,
+            &[".dark p { color: red } main.on b { color: blue }".to_string()],
+            (800.0, 600.0),
+        );
+        tree.with_node_mut(html, |node| node.set_attribute("class", "dark".into()));
+        let mutation: RetainedStyleMutation = AttributeStyleMutation {
+            node: html,
+            name: "class".into(),
+            old_value: None,
+            new_value: Some("dark".into()),
+        }
+        .into();
+        assert!(matches!(
+            retained_style_plan(&tree, &sheet, &HashMap::new(), &[mutation]),
+            RetainedStylePlan::WholeDocument
+        ));
+
+        let mut damage = StyleDamage::default();
+        add_style_subtree(&tree, id("main"), &mut damage);
+        let after_main = damage.len();
+        add_style_subtree(&tree, id("inner"), &mut damage);
+        assert_eq!(damage.len(), after_main, "a subtree inside a damaged one adds nothing");
+        assert!(damage.nodes.contains(&id("deep")) && !damage.everything);
+    }
