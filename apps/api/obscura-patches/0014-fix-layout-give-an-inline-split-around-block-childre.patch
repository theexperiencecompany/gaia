+        // Amazon's footer shape: an inline <a> whose children are a block h5
+        // and a display:block span. CSS2 §9.2.1.1 splits the inline around
+        // them; Chrome reports the anonymous block as one of its client rects
+        // and their union as its bounding rect, so the link is visible and
+        // clickable. Hit testing inside the block finds the block's content,
+        // whose ancestor chain includes the link.
+        let dom = parse_html(
+            r#"<html><head><style>
+                html,body { margin:0; font:16px/20px sans-serif }
+                ul { margin:0; padding:0; list-style:none; width:400px }
+                li { padding:0 10px }
+                h5 { margin:0; font-size:12px; line-height:14px }
+                .text { display:block }
+            </style></head><body>
+                <ul><li><a id="link" href="/music"><h5 id="heading">Amazon Music</h5><span id="text" class="text">Stream millions<br>of songs</span></a></li></ul>
+                <p id="plain-host"><a id="plain" href="/plain">plain link</a></p>
+            </body></html>"#,
+        );
+        let mut rt = ObscuraJsRuntime::new();
+        rt.set_dom(dom);
+        rt.set_viewport(800.0, 600.0);
+        rt.run_page_init();
+
+        let result = rt
+            .evaluate(
+                r#"
+                const box = (r) => [r.x, r.y, r.width, r.height];
+                const link = document.getElementById("link");
+                const heading = document.getElementById("heading").getBoundingClientRect();
+                const text = document.getElementById("text").getBoundingClientRect();
+                const plain = document.getElementById("plain");
+                const hit = document.elementFromPoint(heading.x + 5, heading.y + heading.height / 2);
+                const hitText = document.elementFromPoint(text.x + 5, text.y + text.height / 2);
+                const chain = [];
+                for (let node = hit; node; node = node.parentElement) chain.push(node.id || node.tagName);
+                return {
+                    link: box(link.getBoundingClientRect()),
+                    linkRects: Array.from(link.getClientRects(), box),
+                    heading: box(heading),
