+    #[test]
+    fn inline_split_around_blocks_covers_its_fragments() {
+        // CSS2 §9.2.1.1: an inline containing block-level boxes is split
+        // around them. The blocks sit in an anonymous block box, which Chrome
+        // reports as one fragment of the inline (the containing block's
+        // content width, first block top to last block bottom), with an
+        // empty fragment at an edge where the inline starts or ends with a
+        // block. getBoundingClientRect is the union of non-empty fragments.
+        // Expected values measured in Chrome with the same markup.
+        let tree = parse_html(
+            r##"<style>html,body{margin:0;font:16px/20px sans-serif}</style>
+<div style="width:400px"><a id="amazon" href="#"><h5 id="h" style="margin:0;font-size:12px;line-height:14px">Amazon Music</h5><span id="s" style="display:block">Stream millions<br>of songs</span></a></div>
+<div style="width:400px"><a id="narrow" href="#"><div id="d" style="width:100px">narrow</div></a></div>
+<div style="width:400px;padding:0 10px"><a id="margins" href="#"><h5 style="margin:10px 0;height:20px"></h5><span style="display:block;margin:5px 20px;height:20px"></span></a></div>
+<div style="width:400px"><a id="outer" href="#"><span id="inner"><div id="deep" style="height:30px"></div></span></a></div>"##,
+        );
+        let laid = layout_dom(&tree, (1280.0, 720.0));
+
+        let (rect, fragments) = split_geometry(&laid, &tree, "amazon");
+        let rect = rect.expect("split inline must have a box");
+        assert_rect_near(rect, [0.0, 0.0, 400.0, 54.0], "amazon rect");
+        assert_eq!(fragments.len(), 3, "{fragments:?}");
+        assert_rect_near(fragments[0], [0.0, 0.0, 0.0, 0.0], "amazon before");
+        assert_rect_near(fragments[1], [0.0, 0.0, 400.0, 54.0], "amazon blocks");
+        assert_rect_near(fragments[2], [0.0, 54.0, 0.0, 0.0], "amazon after");
+
+        // The anonymous block is as wide as the containing block, even when
+        // the block inside it is narrower.
+        let (rect, fragments) = split_geometry(&laid, &tree, "narrow");
+        assert_rect_near(rect.unwrap(), [0.0, 54.0, 400.0, 20.0], "narrow rect");
+        assert_eq!(fragments.len(), 3, "{fragments:?}");
+        assert_rect_near(fragments[1], [0.0, 54.0, 400.0, 20.0], "narrow blocks");
+        assert_rect_near(fragments[2], [0.0, 74.0, 0.0, 0.0], "narrow after");
