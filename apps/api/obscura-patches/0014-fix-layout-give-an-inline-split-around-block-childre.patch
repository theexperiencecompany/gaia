+    /// Fragments and bounding rect of an element, for split-inline tests.
+    fn split_geometry(laid: &DomLayout, tree: &DomTree, id: &str) -> (Option<Rect>, Vec<Rect>) {
+        let node = tree.get_element_by_id(id).unwrap();
+        (
+            laid.rects.get(&node).copied(),
+            laid.inline_fragments.get(&node).cloned().unwrap_or_default(),
+        )
+    }
