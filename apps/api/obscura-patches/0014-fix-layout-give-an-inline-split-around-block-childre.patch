+                assert!(rect.width < 120.0 && rect.height < 25.0, "{id}: {rect:?}");
+            }
+        }
+        #[cfg(feature = "paint")]
+        {
+            let (rect, fragments) = split_geometry(&laid, &tree, "plain");
+            let rect = rect.unwrap();
+            assert_eq!(fragments, vec![rect]);
+            assert!(rect.width > 40.0 && rect.width < 90.0, "{rect:?}");
+            assert!((rect.height - 17.0).abs() < 1.0, "{rect:?}");
+            let node = tree.get_element_by_id("plain").unwrap();
+            assert!(!laid.split_inlines.contains(&node));
+        }
+    }
+
+    #[cfg(feature = "paint")]
+    #[test]
+    fn inline_split_around_a_block_keeps_its_text_line_fragments() {
+        // Text before and after the block becomes line fragments of the
+        // inline, shaped like any other inline's text. Chrome:
+        // [[0,55,45.38,17],[0,74,400,20],[0,95,32.02,17]] with the first
+        // line at y=0 here.
+        let tree = parse_html(
+            r##"<style>html,body{margin:0;font:16px/20px sans-serif}</style>
+<div style="width:400px"><a id="mixed" href="#">before<div id="d2">block</div>after</a></div>"##,
+        );
+        let laid = layout_dom(&tree, (1280.0, 720.0));
+        let (rect, fragments) = split_geometry(&laid, &tree, "mixed");
+        let rect = rect.expect("split inline must have a box");
+        assert_eq!(fragments.len(), 3, "{fragments:?}");
+        let [before, block, after] = [fragments[0], fragments[1], fragments[2]];
+        assert!(before.width > 30.0 && before.width < 60.0, "{before:?}");
+        assert!((before.height - 17.0).abs() < 1.0, "{before:?}");
+        assert!(before.y + before.height <= block.y + 0.5, "{fragments:?}");
+        assert_rect_near(block, [0.0, 20.0, 400.0, 20.0], "block fragment");
+        assert!(after.width > 20.0 && after.width < 50.0, "{after:?}");
+        assert!(after.y >= block.y + block.height - 0.5, "{fragments:?}");
+        assert!((rect.x, rect.width) == (0.0, 400.0), "{rect:?}");
+        assert!((rect.y - before.y).abs() < 0.01, "{rect:?}");
+        assert!(
+            (rect.y + rect.height - after.y - after.height).abs() < 0.01,
+            "{rect:?}"
+        );
+    }
 }
