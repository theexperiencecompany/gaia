+        // Block margins stay outside the block fragment; the containing
+        // block's padding offsets it; the trailing empty fragment sits below
+        // the last block's bottom margin.
+        let (rect, fragments) = split_geometry(&laid, &tree, "margins");
+        assert_rect_near(rect.unwrap(), [10.0, 84.0, 400.0, 50.0], "margins rect");
