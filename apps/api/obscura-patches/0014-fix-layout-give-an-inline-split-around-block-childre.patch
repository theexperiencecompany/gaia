+/// Geometry for plain inlines that the box tree spliced out.
+///
+/// CSS2 §9.2.1.1 splits an inline box that contains a block-level box: the
+/// inline content before and after the block becomes line fragments of the
+/// inline, and the block boxes in between sit in an anonymous block box of
+/// the containing block. Browsers expose that anonymous block's extent as one
+/// fragment of the inline (Blink's block-in-inline line): the containing
+/// block's content-box width, from the top of the first block to the bottom
+/// of the last. An inline that starts or ends with a block also has an empty
+/// fragment at that edge. `getBoundingClientRect()` is the union of the
+/// non-empty fragments, `getClientRects()` lists them all.
+///
+/// Line fragments for text of the inline come from shaping (the inline is an
+/// owner in its run); block fragments come from the laid-out blocks.
+fn synthesize_split_inline_fragments(
+    tree: &DomTree,
+    split_inlines: &HashSet<NodeId>,
+    rects: &mut HashMap<NodeId, Rect>,
+    inline_fragments: &mut HashMap<NodeId, Vec<Rect>>,
+    styles: &HashMap<NodeId, crate::LayoutStyle>,
+) {
+    enum Piece {
+        Inline,
+        Block(NodeId),
+    }
+    fn collect(
+        tree: &DomTree,
+        id: NodeId,
+        split_inlines: &HashSet<NodeId>,
+        styles: &HashMap<NodeId, crate::LayoutStyle>,
+        out: &mut Vec<Piece>,
+    ) {
+        for child in rendered_children(tree, id) {
+            let Some(node) = tree.get_node(child) else {
+                continue;
+            };
+            if let obscura_dom::tree::NodeData::Text { contents } = &node.data {
+                if !contents.trim().is_empty() {
+                    out.push(Piece::Inline);
+                }
+                continue;
+            }
+            if !node.is_element() {
+                continue;
+            }
+            let Some(style) = styles.get(&child) else {
+                continue;
+            };
+            if style.display == crate::Display::None
+                || style.float.is_some()
+                || matches!(style.position, Some(taffy::Position::Absolute))
+            {
+                continue;
+            }
+            if style.display_contents || split_inlines.contains(&child) {
+                collect(tree, child, split_inlines, styles, out);
+            } else if is_in_flow_block_level(style) {
+                out.push(Piece::Block(child));
+            } else {
+                out.push(Piece::Inline);
+            }
+        }
+    }
+
+    let mut synthesized = Vec::new();
+    for &id in split_inlines {
+        let mut pieces = Vec::new();
+        collect(tree, id, split_inlines, styles, &mut pieces);
+        let mut line_fragments = inline_fragments.get(&id).cloned().unwrap_or_default();
+        if !pieces.iter().any(|piece| matches!(piece, Piece::Block(_))) {
+            // No split: shaping already produced the whole geometry.
+            continue;
+        }
+
+        // The anonymous block box spans the containing block's content box:
+        // the nearest ancestor that is not itself a plain inline.
+        let mut containing_block = rendered_parent(tree, id);
+        while let Some(ancestor) = containing_block {
+            if !styles
+                .get(&ancestor)
+                .is_some_and(passes_through_block_containing_block)
+            {
+                break;
+            }
+            containing_block = rendered_parent(tree, ancestor);
+        }
+        let Some((cb_x, cb_width)) = containing_block.and_then(|cb| {
+            let rect = rects.get(&cb)?;
+            let style = styles.get(&cb)?;
+            let left = style.border.left + style.padding.left;
+            let right = style.border.right + style.padding.right;
+            Some((rect.x + left, (rect.width - left - right).max(0.0)))
+        }) else {
+            continue;
+        };
+
+        let mut fragments: Vec<Rect> = Vec::new();
+        let mut group: Option<(f32, f32)> = None; // top, bottom
+        let flush = |group: &mut Option<(f32, f32)>, fragments: &mut Vec<Rect>| {
+            if let Some((top, bottom)) = group.take() {
+                fragments.push(Rect {
+                    x: cb_x,
+                    y: top,
+                    width: cb_width,
+                    height: (bottom - top).max(0.0),
+                });
+            }
+        };
+        let starts_with_block = matches!(pieces.first(), Some(Piece::Block(_)));
+        let ends_with_block = matches!(pieces.last(), Some(Piece::Block(_)));
+        let mut last_block_bottom = None;
+        for piece in &pieces {
+            match *piece {
+                Piece::Inline => flush(&mut group, &mut fragments),
+                Piece::Block(block) => {
+                    let Some(rect) = rects.get(&block) else {
+                        continue;
+                    };
+                    let margin_bottom = styles.get(&block).map_or(0.0, |style| style.margin.bottom);
+                    let bottom = rect.y + rect.height;
+                    group = Some(match group {
+                        Some((top, group_bottom)) => (top.min(rect.y), group_bottom.max(bottom)),
+                        None => (rect.y, bottom),
+                    });
+                    last_block_bottom = Some(bottom + margin_bottom);
+                }
+            }
+        }
+        flush(&mut group, &mut fragments);
+        let Some(first_block) = fragments.first().copied() else {
+            continue;
+        };
+        if starts_with_block {
+            fragments.insert(
+                0,
+                Rect {
+                    x: cb_x,
+                    y: first_block.y,
+                    width: 0.0,
+                    height: 0.0,
+                },
+            );
+        }
+        if ends_with_block {
+            if let Some(bottom) = last_block_bottom {
+                fragments.push(Rect {
+                    x: cb_x,
+                    y: bottom,
+                    width: 0.0,
+                    height: 0.0,
+                });
+            }
+        }
+        // Interleave the shaped line fragments in visual (block-axis) order;
+        // the sort is stable, so an edge fragment stays ahead of the block
+        // fragment that shares its top.
+        fragments.append(&mut line_fragments);
+        fragments.sort_by(|a, b| a.y.total_cmp(&b.y));
+        synthesized.push((id, fragments));
+    }
+
+    for (id, fragments) in synthesized {
+        // CSSOM View: the bounding rect is the union of the fragments that
+        // have both a width and a height; if none has, the first fragment.
+        let union = fragments
+            .iter()
+            .filter(|rect| rect.width > 0.0 && rect.height > 0.0)
+            .copied()
+            .reduce(|union, rect| {
+                let left = union.x.min(rect.x);
+                let top = union.y.min(rect.y);
+                let right = (union.x + union.width).max(rect.x + rect.width);
+                let bottom = (union.y + union.height).max(rect.y + rect.height);
+                Rect {
+                    x: left,
+                    y: top,
+                    width: right - left,
+                    height: bottom - top,
+                }
+            })
+            .unwrap_or(fragments[0]);
+        rects.insert(id, union);
+        inline_fragments.insert(id, fragments);
+    }
+}
