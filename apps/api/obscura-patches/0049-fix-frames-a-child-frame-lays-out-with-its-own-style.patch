+/// The `href` of the document's first `<base href>`.
+fn document_base_href(dom: &DomTree) -> Option<String> {
+    match dom.query_selector("base[href]") {
+        Ok(Some(nid)) => dom
+            .get_node(nid)
+            .and_then(|n| n.get_attribute("href").map(|s| s.to_string())),
+        _ => None,
+    }
+}
