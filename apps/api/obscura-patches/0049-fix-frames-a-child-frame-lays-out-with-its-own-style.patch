diff --git a/crates/obscura/tests/child_frame_resources.rs b/crates/obscura/tests/child_frame_resources.rs
new file mode 100644
index 0000000..14db250
--- /dev/null
+++ b/crates/obscura/tests/child_frame_resources.rs
@@ -0,0 +1,125 @@
+//! A child frame's document lays out with its own stylesheets and images, as
+//! the page's does, and its load event waits for its images.
+#![cfg(feature = "render")]
+
+use std::io::{Read, Write};
+
+use obscura::Browser;
+
+const PARENT_HTML: &str = r#"<!doctype html><html><body>
+<iframe src="/child.html" width="400" height="300"></iframe>
+</body></html>"#;
+
+const CHILD_HTML: &str = r#"<!doctype html><html><head><link rel="stylesheet" href="/child.css"></head>
+<body><div id="box">x</div><img id="img" src="/child.png">
+<script>window.addEventListener('load', () => {
+  window.__atLoad = document.getElementById('img').getBoundingClientRect().width;
+});</script></body></html>"#;
+
+const CHILD_CSS: &str = "#box { width: 123px; height: 45px }";
+
+/// A 37x21 opaque PNG.
+fn png() -> Vec<u8> {
+    fn chunk(out: &mut Vec<u8>, kind: &[u8], data: &[u8]) {
+        out.extend((data.len() as u32).to_be_bytes());
+        let start = out.len();
+        out.extend(kind);
+        out.extend(data);
+        out.extend(crc32(&out[start..]).to_be_bytes());
+    }
+    fn crc32(bytes: &[u8]) -> u32 {
+        let mut crc = !0u32;
+        for byte in bytes {
+            crc ^= u32::from(*byte);
+            for _ in 0..8 {
+                crc = if crc & 1 == 1 { (crc >> 1) ^ 0xEDB8_8320 } else { crc >> 1 };
+            }
+        }
+        !crc
+    }
+    fn adler32(bytes: &[u8]) -> u32 {
+        let (mut a, mut b) = (1u32, 0u32);
+        for byte in bytes {
+            a = (a + u32::from(*byte)) % 65521;
+            b = (b + a) % 65521;
+        }
+        (b << 16) | a
+    }
+    let (width, height) = (37u32, 21u32);
+    let mut raw = Vec::new();
+    for _ in 0..height {
+        raw.push(0);
+        for _ in 0..width {
+            raw.extend([255, 0, 0]);
+        }
+    }
+    // zlib with one stored (uncompressed) deflate block.
+    let mut zlib = vec![0x78, 0x01, 0x01];
+    zlib.extend((raw.len() as u16).to_le_bytes());
+    zlib.extend((!(raw.len() as u16)).to_le_bytes());
+    zlib.extend(&raw);
+    zlib.extend(adler32(&raw).to_be_bytes());
+
+    let mut out = vec![0x89, b'P', b'N', b'G', b'\r', b'\n', 0x1a, b'\n'];
+    let mut header = Vec::new();
+    header.extend(width.to_be_bytes());
+    header.extend(height.to_be_bytes());
+    header.extend([8, 2, 0, 0, 0]);
+    chunk(&mut out, b"IHDR", &header);
+    chunk(&mut out, b"IDAT", &zlib);
+    chunk(&mut out, b"IEND", &[]);
+    out
+}
+
+fn spawn_server() -> String {
+    let listener = std::net::TcpListener::bind("127.0.0.1:0").unwrap();
+    let addr = listener.local_addr().unwrap();
+    let image = png();
+    std::thread::spawn(move || {
+        for incoming in listener.incoming() {
+            let Ok(mut stream) = incoming else { continue };
+            let mut buf = [0u8; 2048];
+            let read = stream.read(&mut buf).unwrap_or(0);
+            let request = &buf[..read];
+            let (content_type, body): (&str, Vec<u8>) = if request.starts_with(b"GET /child.html ") {
+                ("text/html", CHILD_HTML.as_bytes().to_vec())
+            } else if request.starts_with(b"GET /child.css ") {
+                ("text/css", CHILD_CSS.as_bytes().to_vec())
+            } else if request.starts_with(b"GET /child.png ") {
+                ("image/png", image.clone())
+            } else {
+                ("text/html", PARENT_HTML.as_bytes().to_vec())
+            };
+            let headers = format!(
+                "HTTP/1.1 200 OK\r\nContent-Type: {content_type}\r\nContent-Length: {}\r\nConnection: close\r\n\r\n",
+                body.len()
+            );
+            let _ = stream.write_all(headers.as_bytes());
+            let _ = stream.write_all(&body);
+            let _ = stream.shutdown(std::net::Shutdown::Both);
+        }
+    });
+    format!("http://{addr}")
+}
+
+#[tokio::test]
+async fn a_child_frame_lays_out_with_its_own_stylesheets_and_images() {
+    std::env::set_var("OBSCURA_ALLOW_PRIVATE_NETWORK", "1");
+    let base = spawn_server();
+
+    let browser = Browser::new().unwrap();
+    let mut page = browser.new_page().await.unwrap();
+    page.goto(&base).await.unwrap();
+    page.settle(2000).await;
+    assert_eq!(page.frame_urls().len(), 1, "the child frame never loaded");
+
+    let geometry = page
+        .evaluate_in_frame(
+            0,
+            "(() => { const box = document.getElementById('box').getBoundingClientRect(); \
+             const img = document.getElementById('img').getBoundingClientRect(); \
+             return [box.width, box.height, img.width, img.height, window.__atLoad]; })()",
+        )
+        .unwrap();
+    assert_eq!(geometry, serde_json::json!([123, 45, 37, 21, 37]));
+}
