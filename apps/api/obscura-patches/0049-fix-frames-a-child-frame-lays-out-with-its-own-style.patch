+    /// Wait up to `max_ms` for a frame's running loads, applying each result.
+    #[cfg(feature = "render")]
+    async fn wait_for_frame_render_resources(&mut self, index: usize, max_ms: u64) {
+        let Some(frame) = self.frames.get(index) else {
+            return;
+        };
+        let notify = frame.render_resource_notify();
+        let deadline = tokio::time::Instant::now() + tokio::time::Duration::from_millis(max_ms);
+        loop {
+            // Register first, then apply and check: see prepare_screenshot_resources.
+            let notified = notify.notified();
+            tokio::pin!(notified);
+            notified.as_mut().enable();
+            self.frames[index].service_render_resources();
+            if !self.frames[index].has_pending_render_resources()
+                || tokio::time::timeout_at(deadline, notified).await.is_err()
+            {
