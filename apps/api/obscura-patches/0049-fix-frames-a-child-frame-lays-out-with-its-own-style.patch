+    /// Whether the frame's renderer cache has an outcome for `url`, as an
+    /// image of `profile` when one is given.
+    #[cfg(feature = "render")]
+    pub fn render_resource_is_known(
+        &self,
+        url: &str,
+        profile: Option<crate::ops::ImageRequestProfile>,
+    ) -> bool {
+        match profile {
+            Some(profile) => crate::runtime::render_image_resource_is_known_in(&self.state, url, profile),
+            None => crate::runtime::render_resource_is_known_in(&self.state, url),
+        }
+    }
+
+    /// Start the frame's loads for `loadable` through the page transport, and
+    /// record `rejected` as missing.
+    #[cfg(feature = "render")]
+    pub fn start_render_resource_loads(
+        &self,
+        loadable: Vec<(String, Option<crate::ops::ImageRequestProfile>, bool)>,
+        rejected: Vec<(String, Option<crate::ops::ImageRequestProfile>, bool)>,
+    ) -> usize {
+        for (url, profile, _) in rejected {
+            match profile {
+                Some(profile) => {
+                    crate::runtime::seed_shared_render_image_resource_in(&self.state, url, profile, None)
+                }
+                None => crate::runtime::seed_shared_render_resource_in(&self.state, url, None),
+            }
+        }
+        let requests = crate::runtime::mark_render_resources_in_flight_in(&self.state, loadable);
+        crate::runtime::start_render_resource_loads_in(&self.state, requests)
+    }
+
+    /// Whether the frame's loads are still running.
+    #[cfg(feature = "render")]
+    pub fn has_pending_render_resources(&self) -> bool {
+        !self.state.borrow().render_resource_in_flight.is_empty()
