+/// How long a document's parse waits for its image and font loads
+/// (OBSCURA_RENDER_RESOURCE_WARMUP_MS, default one second).
+#[cfg(feature = "render")]
+fn render_resource_warmup_ms() -> u64 {
+    std::env::var("OBSCURA_RENDER_RESOURCE_WARMUP_MS")
+        .ok()
+        .and_then(|value| value.parse::<u64>().ok())
+        .unwrap_or(1_000)
+}
+
+/// CSS text that can name render resources: `<style>` contents, `style`
+/// attributes, and SVG `<use href>` references.
+#[cfg(feature = "render")]
+fn render_resource_css_sources(dom: &DomTree) -> Vec<String> {
+    let mut sources = Vec::new();
+    for id in dom.descendants(dom.document()) {
+        let Some(node) = dom.get_node(id) else {
+            continue;
+        };
+        if node
+            .as_element()
+            .is_some_and(|element| element.local.as_ref() == "style")
+        {
+            sources.push(dom.text_content(id));
+        }
+        if let Some(style) = node.get_attribute("style") {
+            sources.push(style.to_string());
+        }
+        if node
+            .as_element()
+            .is_some_and(|element| element.local.as_ref() == "use")
+        {
+            if let Some(href) = node
+                .get_attribute("href")
+                .or_else(|| node.get_attribute("xlink:href"))
+            {
+                sources.push(format!("url({href})"));
+            }
+        }
+    }
+    sources
+}
