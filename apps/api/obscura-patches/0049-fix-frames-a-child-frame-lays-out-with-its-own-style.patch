+/// A document's image and font loads not yet known to its renderer cache,
+/// split into those its transport may load and those it must record as
+/// missing (another scheme, or blocked by the client).
+#[cfg(feature = "render")]
+fn classify_render_resource_candidates(
+    image_urls: Vec<(String, obscura_js::ImageRequestProfile)>,
+    css_sources: Vec<String>,
+    document_url: &url::Url,
+    base_url: &url::Url,
+    is_known: impl Fn(&str, Option<obscura_js::ImageRequestProfile>) -> bool,
+    is_blocked: impl Fn(&str) -> bool,
+) -> (
+    Vec<(String, Option<obscura_js::ImageRequestProfile>, bool)>,
+    Vec<(String, Option<obscura_js::ImageRequestProfile>, bool)>,
+) {
+    let mut candidates = std::collections::BTreeSet::new();
+    for (raw, profile) in image_urls {
+        if let Ok(mut url) = url::Url::parse(&raw) {
+            url.set_fragment(None);
+            candidates.insert((url.to_string(), Some(profile), false));
+        }
+    }
+    for css in css_sources {
+        for raw in css_resource_urls(&css, base_url) {
+            if let Ok(mut url) = url::Url::parse(&raw) {
+                url.set_fragment(None);
+                let is_font = render_resource_is_font(&url);
+                candidates.insert((url.to_string(), None, is_font));
+            }
+        }
+    }
+    candidates.retain(|(url, profile, _)| !is_known(url, *profile));
+
+    let mut loadable = Vec::new();
+    let mut rejected = Vec::new();
+    // Preserve the historical warmup bound. Anything beyond this batch
+    // is reported again by a later cache-only layout.
+    for (url, profile, is_font) in candidates.into_iter().take(MAX_STYLESHEET_RESOURCES) {
+        if subresource_allowed(Some(document_url), &url) && !is_blocked(&url) {
+            loadable.push((url, profile, is_font));
+        } else {
+            rejected.push((url, profile, is_font));
+        }
+    }
+    (loadable, rejected)
+}
