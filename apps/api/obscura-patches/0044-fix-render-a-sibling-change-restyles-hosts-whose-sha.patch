     sheets
 }
 
+/// The sheets whose structural rules can test `parent`'s children: the ones
+/// that select the children, plus each child host's own shadow sheet, whose
+/// `:host(:first-child)` / `:host(:nth-child())` rules test the host's place
+/// among its siblings.
+fn child_structure_sheets<'a>(
+    tree: &DomTree,
+    parent: NodeId,
+    child_sheets: &[&'a crate::css::Stylesheet],
+    shadow_sheets: &'a HashMap<NodeId, std::sync::Arc<crate::css::Stylesheet>>,
+) -> Vec<&'a crate::css::Stylesheet> {
+    let mut sheets = child_sheets.to_vec();
+    for child in element_children(tree, parent) {
+        if let Some(sheet) = tree.shadow_root(child).and_then(|root| shadow_sheets.get(&root)) {
+            push_sheet(&mut sheets, sheet);
+        }
+    }
+    sheets
+}
