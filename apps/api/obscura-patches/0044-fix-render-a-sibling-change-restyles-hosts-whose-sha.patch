diff --git a/crates/obscura-render/src/dom/shadow_restyle_tests.rs b/crates/obscura-render/src/dom/shadow_restyle_tests.rs
index 29f5703..00416ab 100644
--- a/crates/obscura-render/src/dom/shadow_restyle_tests.rs
+++ b/crates/obscura-render/src/dom/shadow_restyle_tests.rs
@@ -479,6 +479,47 @@ fn retained_attach_shadow_after_layout_matches_full() {
 
 /// Cost: with many styled components, a mutation inside one of them
 /// re-cascades that component only.
+/// A host's place among its siblings is state its own shadow sheet can test
+/// with `:host(:first-child)` / `:host(:nth-child())`; inserting or removing a
+/// light-DOM sibling must restyle it.
+#[test]
+fn retained_sibling_change_restyles_hosts_with_structural_host_rules() {
+    let mut peers = String::new();
+    for index in 0..CLEAN_PEERS {
+        peers.push_str(&format!("<span class=clean data-index={index}></span>"));
+    }
+    let html = format!(
+        r#"<!doctype html><html><head><style>
+             html,body{{margin:0}} .clean{{display:block;height:1px}}
+           </style></head><body>
+           <div id="list"><x-row id="a"></x-row><x-row id="b"></x-row></div>
+           <div id="source"><style>:host{{display:block;height:5px}}
+             :host(:first-child){{height:31px}} :host(:nth-child(even)){{width:77px}}</style><i>row</i></div>
+           <div id="source-b"><style>:host{{display:block;height:5px}}
+             :host(:first-child){{height:31px}} :host(:nth-child(even)){{width:77px}}</style><i>row</i></div>
+           <p id="spare">new first row</p>
+           <aside id="clean">{peers}</aside>
+           </body></html>"#
+    );
+    let tree = parse_html(&html);
+    let id = |name: &str| tree.get_element_by_id(name).unwrap_or_else(|| panic!("{name}"));
+    let (list, a, spare) = (id("list"), id("a"), id("spare"));
+    attach(&tree, a, id("source"));
+    attach(&tree, id("b"), id("source-b"));
+    tree.remove_child(spare);
+    let mut cache = crate::css::StylesheetCache::default();
+
+    let initial = initial_layout(&tree, &mut cache);
+    tree.insert_before(a, spare);
+    let insert = TreeStyleMutation::Insert { node: spare, old_parent: None, new_parent: list };
+    finish("sibling insert before hosts", &tree, &mut cache, initial, &[insert.into()], COMPONENT_BUDGET);
+
+    let initial = initial_layout(&tree, &mut cache);
+    tree.remove_child(spare);
+    let remove = TreeStyleMutation::remove(&tree, spare, list);
+    finish("sibling remove before hosts", &tree, &mut cache, initial, &[remove.into()], COMPONENT_BUDGET);
+}
