         ShadowSheetLookup {
             sheet,
@@ -2937,7 +2930,51 @@ impl StylesheetCache {
     /// Forget roots that are no longer connected, so a root that returns later
     /// is treated as new rather than matched against a stale fingerprint.
     pub(crate) fn retain_shadow_roots(&mut self, live: &std::collections::HashSet<NodeId>) {
-        self.shadow.retain(|root, _| live.contains(root));
+        let gone: Vec<NodeId> = self
+            .shadow
+            .keys()
+            .filter(|root| !live.contains(root))
+            .copied()
+            .collect();
+        for root in gone {
+            self.forget_shadow_root(root);
+        }
+    }
+
+    /// The shared copy of `sources` for one more entry, or None when a new
+    /// distinct text would take the shadow texts past the byte bound.
+    fn retain_shadow_text(&mut self, sources: Vec<String>) -> Option<Arc<Vec<String>>> {
+        if let Some(shared) = self.shadow_texts.get_key_value(&sources).map(|(key, _)| Arc::clone(key)) {
+            if let Some(text) = self.shadow_texts.get_mut(&sources) {
+                text.entries += 1;
+            }
+            return Some(shared);
+        }
+        let bytes = sources
+            .iter()
+            .try_fold(0usize, |total, source| total.checked_add(source.len()))?;
+        if self.shadow_text_bytes.saturating_add(bytes) > MAX_STYLESHEET_CACHE_SOURCE_BYTES {
+            return None;
+        }
+        let shared = Arc::new(sources);
+        self.shadow_text_bytes += bytes;
+        self.shadow_texts
+            .insert(Arc::clone(&shared), ShadowText { entries: 1, bytes });
+        Some(shared)
+    }
+
+    fn forget_shadow_root(&mut self, root: NodeId) {
+        let Some(entry) = self.shadow.remove(&root) else {
+            return;
+        };
+        let Some(text) = self.shadow_texts.get_mut(&entry.sources) else {
+            return;
+        };
+        text.entries -= 1;
+        if text.entries == 0 {
+            self.shadow_text_bytes -= text.bytes;
+            self.shadow_texts.remove(&entry.sources);
+        }
     }
 
     pub fn hit_count(&self) -> u64 {
@@ -2949,12 +2986,7 @@ impl StylesheetCache {
     }
 
     pub fn retained_source_bytes(&self) -> usize {
-        self.entry.as_ref().map_or(0, |entry| entry.source_bytes)
-            + self
-                .shadow
-                .values()
-                .map(|entry| entry.source_bytes)
-                .sum::<usize>()
+        self.entry.as_ref().map_or(0, |entry| entry.source_bytes) + self.shadow_text_bytes
     }
 }
 
