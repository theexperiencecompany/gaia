 mod tests {
     use super::*;
 
+    /// Many instances of one component share one `<style>` text: the byte
+    /// bound counts it once, so every instance is remembered, and the text is
+    /// released with its last instance.
+    #[test]
+    fn shadow_sheet_cache_counts_a_shared_text_once() {
+        let tree = obscura_dom::parse_html("<html><body></body></html>");
+        let text = vec![format!(".a{{color:red}}/*{}*/", "x".repeat(512 * 1024))];
+        let instances = 2 * MAX_STYLESHEET_CACHE_SOURCE_BYTES / text[0].len();
+        let mut cache = StylesheetCache::default();
+        let look = |cache: &mut StylesheetCache, root: u32| {
+            cache.get_or_parse_shadow(
+                &tree,
+                NodeId::new(root),
+                NodeId::new(root + 100_000),
+                text.clone(),
+                (640.0, 480.0),
+                CssMediaType::Screen,
+                &mut HashMap::new(),
+            )
+        };
+        for root in 0..instances as u32 {
+            assert!(!look(&mut cache, root).unchanged);
+        }
+        for root in 0..instances as u32 {
+            assert!(look(&mut cache, root).unchanged, "instance {root} was forgotten");
+        }
+        assert_eq!(cache.retained_source_bytes(), text[0].len());
+
+        cache.retain_shadow_roots(&std::collections::HashSet::from([NodeId::new(0)]));
+        assert_eq!(cache.retained_source_bytes(), text[0].len());
+        cache.retain_shadow_roots(&std::collections::HashSet::new());
+        assert_eq!(cache.retained_source_bytes(), 0);
+    }
+
     fn test_invalidation_map(css: &str) -> InvalidationMap {
         let tree = obscura_dom::parse_html("<html><body></body></html>");
         Stylesheet::parse(&tree, &[css.to_string()])
