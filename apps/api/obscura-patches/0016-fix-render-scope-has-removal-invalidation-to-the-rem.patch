+/// Where the anchors of a `:has()` can sit relative to a removed subtree, from
+/// the combinators of its relative selectors (Blink's
+/// `CheckPseudoHasArgumentTraversalScope`). A match runs from the anchor down
+/// and/or forward to the subject, so the anchor of an element that left is one
+/// of its old ancestors or an earlier sibling of one.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct RelationalAnchorScope {
+    /// How many old ancestors, nearest first, can be anchors. `usize::MAX`
+    /// for a descendant combinator anywhere in the argument.
+    pub ancestors: usize,
+    /// The old parent's children can be anchors (`:has(+ .x)`, `:has(~ .x)`).
+    pub siblings: bool,
+    /// Children at every old ancestor boundary can be anchors: sibling and
+    /// descendant combinators mixed, or combinators inside functional
+    /// pseudo-classes, which this summary does not model.
+    pub ancestor_siblings: bool,
+}
+
+impl RelationalAnchorScope {
+    pub(crate) const NONE: Self = Self {
+        ancestors: 0,
+        siblings: false,
+        ancestor_siblings: false,
+    };
+    pub(crate) const ANY: Self = Self {
+        ancestors: usize::MAX,
+        siblings: true,
+        ancestor_siblings: true,
+    };
+
+    /// How many levels of a removed subtree, from its root, can hold an
+    /// element that a match from a surviving anchor passed through.
+    pub(crate) fn removed_depth(self) -> usize {
+        if self.ancestor_siblings {
+            usize::MAX
+        } else {
+            self.ancestors.max(usize::from(self.siblings))
+        }
+    }
+
+    fn union(self, other: Self) -> Self {
+        Self {
+            ancestors: self.ancestors.max(other.ancestors),
+            siblings: self.siblings || other.siblings,
+            ancestor_siblings: self.ancestor_siblings || other.ancestor_siblings,
+        }
+    }
+
+    /// Scope of one relative selector. A structural pseudo in it can change
+    /// on elements that stay: siblings of the removed element (`:first-child`
+    /// and friends), whose anchors are already in scope, and the old parent
+    /// (`:empty`), whose anchors sit one level further up.
+    fn of_argument(selector: &str, structural_side_effect: bool) -> Self {
+        let Some(combinators) = relative_selector_combinators(selector) else {
+            return Self::ANY;
+        };
+        let child_or_descendant = combinators.iter().all(|&c| c == '>' || c == ' ');
+        let sibling = combinators.iter().all(|&c| c == '+' || c == '~');
+        if child_or_descendant {
+            let ancestors = if combinators.iter().all(|&c| c == '>') {
+                combinators.len() + usize::from(structural_side_effect)
+            } else {
+                usize::MAX
+            };
+            Self {
+                ancestors,
+                siblings: false,
+                ancestor_siblings: false,
+            }
+        } else if sibling && !structural_side_effect {
+            Self {
+                ancestors: 0,
+                siblings: true,
+                ancestor_siblings: false,
+            }
+        } else {
+            Self::ANY
+        }
+    }
+}
+
+/// The combinators of a relative selector in order, the leading (possibly
+/// implicit descendant) one first; `' '` is the descendant combinator. None
+/// when a functional pseudo-class argument has combinators of its own, or the
+/// selector cannot be split.
+fn relative_selector_combinators(selector: &str) -> Option<Vec<char>> {
+    let chars = selector.trim().chars().collect::<Vec<_>>();
+    let mut combinators = Vec::new();
+    let mut index = 0usize;
+    match chars.first() {
+        Some(&c) if matches!(c, '>' | '+' | '~') => {
+            combinators.push(c);
+            index = 1;
+        }
+        _ => combinators.push(' '),
+    }
+    let mut pending_whitespace = false;
+    let mut token = false;
+    while index < chars.len() {
+        let ch = chars[index];
+        if ch.is_whitespace() {
+            pending_whitespace = true;
+            index += 1;
+            continue;
+        }
+        if matches!(ch, '>' | '+' | '~') {
+            if !token {
+                return None;
+            }
+            combinators.push(ch);
+            pending_whitespace = false;
+            token = false;
+            index += 1;
+            continue;
+        }
+        if pending_whitespace && token {
+            combinators.push(' ');
+        }
+        pending_whitespace = false;
+        token = true;
+        match ch {
+            '\\' => index += 2,
+            '[' => index = matching_delimiter(&chars, index, '[', ']')? + 1,
+            '(' => {
+                let close = matching_delimiter(&chars, index, '(', ')')?;
+                let argument = chars[index + 1..close].iter().collect::<String>();
+                for alternative in split_selector_list(&argument) {
+                    let nested = relative_selector_combinators(&alternative)?;
+                    if nested != [' '] {
+                        return None;
+                    }
+                }
+                index = close + 1;
+            }
+            '\'' | '"' => return None,
+            _ => index += 1,
+        }
+    }
+    Some(combinators)
+}
+
+/// The selector features (ids, classes, attribute names, local names) of a
+/// subtree, captured when the subtree leaves the document.
+///
+/// Blink and WebKit invalidate `:has()` on removal by asking whether the
+/// removed elements carry any feature of a `:has()` argument, then walking to
+/// the anchors. Obscura plans restyle at the next rendering opportunity, when
+/// the detached subtree may already have been edited (unobserved), so the
+/// features are recorded at removal time instead of read back later.
+#[derive(Clone, Default, PartialEq, Eq)]
+pub struct SelectorFeatures {
+    /// Each map holds a feature's smallest depth below the removed root
+    /// (the root is depth 0), so a `:has()` whose argument only reaches a
+    /// fixed depth ignores features further down.
+    element_depth: Option<u32>,
+    ids: HashMap<String, u32>,
+    classes: HashMap<String, u32>,
+    /// ASCII-lowercased attribute local names.
+    attributes: HashMap<String, u32>,
+    /// ASCII-lowercased element local names.
+    local_names: HashMap<String, u32>,
+}
+
+impl std::fmt::Debug for SelectorFeatures {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("SelectorFeatures")
+            .field("element_depth", &self.element_depth)
+            .field("ids", &self.ids.len())
+            .field("classes", &self.classes.len())
+            .field("attributes", &self.attributes.len())
+            .field("local_names", &self.local_names.len())
+            .finish()
+    }
+}
+
+fn note_feature(map: &mut HashMap<String, u32>, feature: String, depth: u32) {
+    map.entry(feature)
+        .and_modify(|known| *known = (*known).min(depth))
+        .or_insert(depth);
+}
+
+impl SelectorFeatures {
+    /// Collect the features of `root` and its light-tree descendants. Shadow
+    /// trees are skipped: a `:has()` argument never matches across a shadow
+    /// boundary, and a removed host takes its shadow-scope anchors with it.
+    pub fn collect(tree: &DomTree, root: NodeId) -> Self {
+        let mut features = Self::default();
+        let mut stack = vec![(root, 0u32)];
+        while let Some((id, depth)) = stack.pop() {
+            let is_element = tree
+                .with_node(id, |node| {
+                    let Some(element) = node.as_element() else {
+                        return false;
+                    };
+                    note_feature(
+                        &mut features.local_names,
+                        element.local.as_ref().to_ascii_lowercase(),
+                        depth,
+                    );
+                    for attribute in node.attrs().unwrap_or_default() {
+                        note_feature(
+                            &mut features.attributes,
+                            attribute.name.local.as_ref().to_ascii_lowercase(),
+                            depth,
+                        );
+                    }
+                    // The same lookups `relational_key_may_match` uses.
+                    if let Some(id) = node.get_attribute("id") {
+                        note_feature(&mut features.ids, id.to_owned(), depth);
+                    }
+                    if let Some(classes) = node.get_attribute("class") {
+                        for class in classes.split_whitespace() {
+                            note_feature(&mut features.classes, class.to_owned(), depth);
+                        }
+                    }
+                    true
+                })
+                .unwrap_or(false);
+            if is_element {
+                features.element_depth =
+                    Some(features.element_depth.map_or(depth, |known| known.min(depth)));
+            }
+            stack.extend(tree.children(id).into_iter().map(|child| (child, depth + 1)));
+        }
+        features
+    }
+
+    /// Whether an element sits less than `depth` levels below the root.
+    pub fn has_elements_within(&self, depth: usize) -> bool {
+        self.element_depth.is_some_and(|known| (known as usize) < depth)
+    }
+
+    fn contains_within(&self, key: &RelationalSelectorKey, depth: usize, quirks: bool) -> bool {
+        let within = |map: &HashMap<String, u32>, expected: &str, fold: bool| {
+            map.get(expected).is_some_and(|known| (*known as usize) < depth)
+                || (fold
+                    && map.iter().any(|(actual, known)| {
+                        (*known as usize) < depth && actual.eq_ignore_ascii_case(expected)
+                    }))
+        };
+        match key {
+            RelationalSelectorKey::Id(expected) => within(&self.ids, expected, quirks),
+            RelationalSelectorKey::Class(expected) => within(&self.classes, expected, quirks),
+            RelationalSelectorKey::Attribute(expected) => {
+                within(&self.attributes, &expected.to_ascii_lowercase(), false)
+            }
+            RelationalSelectorKey::LocalName(expected) => {
+                within(&self.local_names, &expected.to_ascii_lowercase(), false)
+            }
+        }
+    }
+}
