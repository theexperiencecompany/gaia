+//! `:has()` invalidation for light-DOM removals. As in Blink and WebKit, a
+//! removal restyles a `:has()` anchor only when the removed subtree carried a
+//! feature of the `:has()` argument (or the argument has a sibling/structural
+//! side effect on the elements that stay). Every case compares the retained
+//! restyle with a forced full cascade of the same final tree.
+
+use super::*;
+use obscura_dom::tree_sink::parse_html;
+
+const VIEWPORT: (f32, f32) = (640.0, 480.0);
+const CLEAN_PEERS: usize = 2_000;
+
+/// `body:has(...)` is the nytimes.com shape: a keyed anchor whose subtree is
+/// the whole document. `:has(> .b)` has no anchor key, so every ancestor of a
+/// removal is a candidate anchor.
+const HAS_CSS: &str = r#"
+    html,body{margin:0}
+    .clean{display:block;height:1px}
+    body:has(.flag){color:#010203}
+    body:has(.flag) .kid{width:31px}
+    .a:has(.b){width:123px;color:#123456}
+    .a:has(.b) .kid{height:9px}
+    :has(> .direct) > .note{padding-left:3px}
+    .n:has(.label:empty){width:77px}
+    :has(> .cap:empty) > .note{margin-left:5px}
+    .col:not(:last-child):not(:has(+ .dummy)){margin-right:4px}
+    .wrap :has(> .icon) > .note{padding-top:2px}
+"#;
+
+fn document() -> DomTree {
+    let mut peers = String::new();
+    for index in 0..CLEAN_PEERS {
+        peers.push_str(&format!("<span class=clean data-index={index}></span>"));
+    }
+    parse_html(&format!(
+        r#"<!doctype html><html><head><style>{HAS_CSS}</style></head><body>
+           <i id="flag" class="flag"></i>
+           <div id="a" class="a">
+             <section id="mid"><i id="b" class="b"></i><i id="b2"></i></section>
+             <p id="kid" class="kid"></p>
+             <div id="shelf"></div>
+           </div>
+           <div id="elsewhere"></div>
+           <div id="holder"><i id="direct" class="direct"></i><i class="note"></i></div>
+           <div id="n" class="n"><span id="label" class="label">text</span></div>
+           <div id="capbox"><span id="cap" class="cap">t</span><i class="note"></i></div>
+           <div id="row"><div id="col1" class="col"></div><div id="col2" class="col"></div><div id="col3" class="col dummy"></div><div id="col4" class="col"></div></div>
+           <div class="wrap"><div><div id="iconbox"><b id="icon" class="icon"></b><b id="plain" class="note"></b></div></div></div>
+           <aside id="clean">{peers}</aside>
+           </body></html>"#,
+    ))
+}
+
+fn id(tree: &DomTree, name: &str) -> NodeId {
+    tree.get_element_by_id(name).unwrap_or_else(|| panic!("{name}"))
+}
+
+fn initial_layout(tree: &DomTree, cache: &mut crate::css::StylesheetCache) -> DomLayout {
+    layout_dom_with_web_fonts_and_stylesheet_cache(tree, VIEWPORT, &HashMap::new(), &[], cache)
+}
+
+/// Retained restyle for `mutations`, checked against a full cascade.
+fn finish(
+    case: &str,
+    tree: &DomTree,
+    cache: &mut crate::css::StylesheetCache,
+    mut initial: DomLayout,
+    mutations: Vec<TreeStyleMutation>,
+) -> ContainerLayoutTelemetry {
+    let retained = RetainedStyleMaps {
+        styles: std::mem::take(&mut initial.styles),
+        custom_properties: std::mem::take(&mut initial.custom_properties),
+    };
+    let mutations = mutations
+        .into_iter()
+        .map(RetainedStyleMutation::from)
+        .collect::<Vec<_>>();
+    let (incremental, telemetry) = layout_dom_with_web_fonts_pass_limit(
+        tree,
+        VIEWPORT,
+        &HashMap::new(),
+        &[],
+        None,
+        Some(cache),
+        Some(retained),
+        &mutations,
+    );
+    let full = layout_dom(tree, VIEWPORT);
+    assert_eq!(
+        incremental.styles.keys().collect::<HashSet<_>>(),
+        full.styles.keys().collect::<HashSet<_>>(),
+        "{case}: computed-style node set"
+    );
+    for (node, style) in &incremental.styles {
+        assert_eq!(
+            format!("{style:#?}"),
+            format!("{:#?}", full.styles[node]),
+            "{case}: computed style for {node:?} (id={:?})",
+            tree.get_node(*node)
+                .and_then(|node| node.get_attribute("id").map(str::to_owned)),
+        );
+    }
+    assert_eq!(incremental.rects, full.rects, "{case}: border boxes");
+    assert_eq!(
+        incremental.custom_properties, full.custom_properties,
+        "{case}: custom properties"
+    );
+    assert_eq!(telemetry.retained_fallback, 0, "{case}: {telemetry:?}");
+    telemetry
+}
+
+/// Remove `node` the way the runtime does: record, then mutate.
+fn remove(tree: &DomTree, node: NodeId) -> TreeStyleMutation {
+    let parent = tree.get_node(node).and_then(|node| node.parent).unwrap();
+    let mutation = TreeStyleMutation::remove(tree, node, parent);
+    tree.remove_child(node);
+    mutation
+}
+
+/// Roughly the ancestor chain plus a few small subtrees. The whole document
+/// is over 2000 elements.
+const LOCAL_BUDGET: usize = 40;
+
+#[test]
+fn retained_has_argument_removal_matches_full() {
+    // `.a:has(.b)` stops matching when `.b`, or an element holding it, goes.
+    for (case, victim) in [("remove .b", "b"), ("remove .b's parent", "mid")] {
+        let tree = document();
+        let mut cache = crate::css::StylesheetCache::default();
+        let initial = initial_layout(&tree, &mut cache);
+        let a = id(&tree, "a");
+        let kid = id(&tree, "kid");
+        assert_eq!(initial.styles[&a].width, crate::Dimension::Px(123.0), "{case}");
+        let mutation = remove(&tree, id(&tree, victim));
+        let telemetry = finish(case, &tree, &mut cache, initial, vec![mutation]);
+        assert!(
+            telemetry.retained_reused >= CLEAN_PEERS,
+            "{case}: {telemetry:?}"
+        );
+        let full = layout_dom(&tree, VIEWPORT);
+        assert_ne!(full.styles[&a].width, crate::Dimension::Px(123.0), "{case}");
+        assert_ne!(full.styles[&kid].height, crate::Dimension::Px(9.0), "{case}");
+    }
+
+    // A keyed anchor whose subtree is the whole document: removing the flag
+    // must restyle all of it.
+    let tree = document();
+    let mut cache = crate::css::StylesheetCache::default();
+    let initial = initial_layout(&tree, &mut cache);
+    let mutation = remove(&tree, id(&tree, "flag"));
+    finish("remove body:has() flag", &tree, &mut cache, initial, vec![mutation]);
+
+    // Unkeyed anchor: the removed child's old parent stops matching.
+    let tree = document();
+    let mut cache = crate::css::StylesheetCache::default();
+    let initial = initial_layout(&tree, &mut cache);
+    let mutation = remove(&tree, id(&tree, "direct"));
+    finish("remove unkeyed-anchor argument", &tree, &mut cache, initial, vec![mutation]);
+
+    // Removing a label's only text makes it `:empty`: a structural side
+    // effect on an element that stays, with no element removed.
+    let tree = document();
+    let mut cache = crate::css::StylesheetCache::default();
+    let initial = initial_layout(&tree, &mut cache);
+    let text = tree.children(id(&tree, "label"))[0];
+    let mutation = remove(&tree, text);
+    finish("remove text under :empty", &tree, &mut cache, initial, vec![mutation]);
+}
+
+#[test]
+fn retained_has_removal_walks_only_to_possible_anchors() {
+    // Each `:has()` argument bounds where its anchor can be: the old parent
+    // for `> .x`, the old parent's children for `+ .x`, one level further up
+    // when the old parent turns `:empty`. The anchor compound's key also
+    // comes from around a `:not()`.
+    let cases: [(&str, fn(&DomTree) -> NodeId); 6] = [
+        ("child argument, unkeyed anchor", |tree| id(tree, "direct")),
+        // `.direct` is a grandchild of the old parent: its anchor left too.
+        ("child argument below the removed root", |tree| id(tree, "holder")),
+        ("child argument under a descendant path", |tree| id(tree, "icon")),
+        ("child argument whose parent turns :empty", |tree| tree.children(id(tree, "cap"))[0]),
+        ("sibling argument inside :not()", |tree| id(tree, "col3")),
+        ("sibling argument, unrelated sibling", |tree| id(tree, "col1")),
+    ];
+    for (case, victim) in cases {
+        let tree = document();
+        let mut cache = crate::css::StylesheetCache::default();
+        let initial = initial_layout(&tree, &mut cache);
+        let mutation = remove(&tree, victim(&tree));
+        let telemetry = finish(case, &tree, &mut cache, initial, vec![mutation]);
+        assert!(
+            telemetry.retained_fresh <= LOCAL_BUDGET,
+            "{case}: restyle must stay near the removal {telemetry:?}"
+        );
+    }
+}
+
+#[test]
+fn retained_unrelated_removal_does_not_restyle_has_anchors() {
+    // Neither removal carries `.flag`, `.b`, `.direct` or `.label`, so none
+    // of the `:has()` anchors (body, `.a`, every ancestor for the unkeyed
+    // one) can change.
+    for (case, victim) in [
+        ("remove clean peer", "clean-victim"),
+        ("remove sibling of .b", "b2"),
+    ] {
+        let tree = document();
+        if victim == "clean-victim" {
+            let peer = tree.children(id(&tree, "clean"))[CLEAN_PEERS / 2];
+            tree.with_node_mut(peer, |node| node.set_attribute("id", "clean-victim".into()));
+        }
+        let mut cache = crate::css::StylesheetCache::default();
+        let initial = initial_layout(&tree, &mut cache);
+        let mutation = remove(&tree, id(&tree, victim));
+        let telemetry = finish(case, &tree, &mut cache, initial, vec![mutation]);
+        assert!(
+            telemetry.retained_fresh <= LOCAL_BUDGET,
+            "{case}: an unrelated removal must not restyle the document {telemetry:?}"
+        );
+        assert!(
+            telemetry.retained_reused >= CLEAN_PEERS,
+            "{case}: {telemetry:?}"
+        );
+    }
+}
+
+#[test]
+fn retained_has_removal_uses_the_state_at_removal_time() {
+    // `.b` leaves `#mid`, then `#mid` leaves `.a`: by the rendering
+    // opportunity `.b`'s old parent is detached and `#mid` no longer holds
+    // `.b`, yet `.a` must stop matching.
+    let tree = document();
+    let mut cache = crate::css::StylesheetCache::default();
+    let initial = initial_layout(&tree, &mut cache);
+    let first = remove(&tree, id(&tree, "b"));
+    let second = remove(&tree, id(&tree, "mid"));
+    finish("nested removals", &tree, &mut cache, initial, vec![first, second]);
+
+    // Same, but `#mid` moves out of `.a` instead of leaving the document.
+    let tree = document();
+    let mut cache = crate::css::StylesheetCache::default();
+    let initial = initial_layout(&tree, &mut cache);
+    let a = id(&tree, "a");
+    let mid = id(&tree, "mid");
+    let elsewhere = id(&tree, "elsewhere");
+    let first = remove(&tree, id(&tree, "b"));
+    tree.append_child(elsewhere, mid);
+    let moved = TreeStyleMutation::Insert {
+        node: mid,
+        old_parent: Some(a),
+        new_parent: elsewhere,
+    };
+    finish("removal then move of old parent", &tree, &mut cache, initial, vec![first, moved]);
+
+    // A detached subtree edited before the flush: its recorded features, not
+    // its current ones, decide.
+    let tree = document();
+    let mut cache = crate::css::StylesheetCache::default();
+    let initial = initial_layout(&tree, &mut cache);
+    let mid = id(&tree, "mid");
+    let b = id(&tree, "b");
+    let mutation = remove(&tree, mid);
+    tree.with_node_mut(b, |node| node.set_attribute("class", "renamed".into()));
+    finish("detached edit after removal", &tree, &mut cache, initial, vec![mutation]);
+}
