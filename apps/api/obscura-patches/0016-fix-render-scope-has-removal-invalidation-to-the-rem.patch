+/// What a removal took out of the tree, captured when it happened.
+///
+/// Both halves can go stale before the rendering opportunity plans restyle:
+/// a detached subtree can be edited without any mutation record, and the old
+/// parent can itself be removed or moved, cutting the old ancestor chain.
+/// `:has()` removal invalidation needs the state as of the last render.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct RemovedSubtree {
+    /// The old parent, then its ancestors up to the tree-scope root.
+    old_ancestors: Vec<NodeId>,
+    features: crate::css::SelectorFeatures,
+}
+
+impl RemovedSubtree {
+    pub fn capture(tree: &DomTree, node: NodeId, old_parent: NodeId) -> Self {
+        let mut old_ancestors = vec![old_parent];
+        let mut current = old_parent;
+        while let Some(parent) = tree.get_node(current).and_then(|node| node.parent) {
+            old_ancestors.push(parent);
+            current = parent;
+        }
+        Self {
+            old_ancestors,
+            features: crate::css::SelectorFeatures::collect(tree, node),
+        }
+    }
+}
+
+impl TreeStyleMutation {
+    /// Record `node` leaving `old_parent`. Call it before the DOM change, or
+    /// at least before anything else touches the subtree or the old ancestors.
+    pub fn remove(tree: &DomTree, node: NodeId, old_parent: NodeId) -> Self {
+        Self::Remove {
+            node,
+            old_parent,
+            removed: RemovedSubtree::capture(tree, node, old_parent),
+        }
+    }
+}
