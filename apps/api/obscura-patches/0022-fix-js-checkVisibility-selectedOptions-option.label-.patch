+/// What `Element.checkVisibility` needs from layout, as bits: 1 the element
+/// has a box, 2 its computed visibility is hidden, 4 it or an ancestor has
+/// opacity 0. 0 means no box; -1 means layout is unavailable.
+#[cfg(feature = "render")]
+#[op2(fast)]
+fn op_element_visibility(state: &OpState, nid: u32, frame_id: u32) -> i32 {
+    let shared = frame_state(state, frame_id);
+    let mut gs = shared.borrow_mut();
+    sample_live_document_animations(&mut gs);
+    if ensure_prepared_geometry(&mut gs).is_none() {
+        return -1;
+    }
+    let (Some(prepared), Some(dom)) = (gs.prepared_render.as_ref(), gs.dom.as_ref()) else {
+        return -1;
+    };
+    let id = obscura_dom::tree::NodeId::new(nid);
+    if !prepared.layout().rects.contains_key(&id) {
+        return 0;
+    }
+    1 | if prepared.visibility_hidden(dom, id) { 2 } else { 0 }
+        | if prepared.opacity_zero(dom, id) { 4 } else { 0 }
