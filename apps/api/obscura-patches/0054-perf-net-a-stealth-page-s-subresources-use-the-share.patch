+    /// A stealth page's scripts and styles share one transaction while in
+    /// flight and reuse a fresh cached response, as the plain client's do.
+    #[tokio::test]
+    async fn stealth_cacheable_subresources_share_one_request_and_the_cache() {
+        use std::sync::atomic::{AtomicUsize, Ordering};
+        let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let address = listener.local_addr().unwrap();
+        let network = Arc::new(AtomicUsize::new(0));
+        let served = network.clone();
+        tokio::spawn(async move {
+            while let Ok((mut stream, _)) = listener.accept().await {
+                let served = served.clone();
+                tokio::spawn(async move {
+                    let mut request = [0u8; 4096];
+                    let _ = stream.read(&mut request).await;
+                    served.fetch_add(1, Ordering::SeqCst);
+                    tokio::time::sleep(Duration::from_millis(80)).await;
+                    let body = "window.x = 1;";
+                    let response = format!(
+                        "HTTP/1.1 200 OK\r\nContent-Type: application/javascript\r\nCache-Control: max-age=3600\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{body}",
+                        body.len()
+                    );
+                    let _ = stream.write_all(response.as_bytes()).await;
+                    let _ = stream.shutdown().await;
+                });
+            }
+        });
+        let url = Url::parse(&format!("http://{address}/shared.js")).unwrap();
+        let initiator = url.join("/page.html").unwrap();
+        let client = Arc::new(StealthHttpClient::with_proxy(Arc::new(CookieJar::new()), None, true));
+        let callbacks = Arc::new(crate::client::CallbackRegistry::new());
+        let responses_seen = Arc::new(AtomicUsize::new(0));
+        let observed = responses_seen.clone();
+        callbacks.add_response(Arc::new(move |_, _| {
+            observed.fetch_add(1, Ordering::SeqCst);
+        }));
+        let fetch = |client: Arc<StealthHttpClient>, callbacks: Arc<crate::client::CallbackRegistry>| {
+            let url = url.clone();
+            let request = crate::client::ResourceRequest::subresource(
+                crate::client::ResourceType::Script,
+                &initiator,
+            );
+            async move {
+                client
+                    .fetch_resource_with_callbacks(&url, request, Some(&callbacks))
+                    .await
+                    .unwrap()
+            }
+        };
+
+        let mut fetches = tokio::task::JoinSet::new();
+        for _ in 0..8 {
+            fetches.spawn(fetch(client.clone(), callbacks.clone()));
+        }
+        while let Some(response) = fetches.join_next().await {
+            assert_eq!(response.unwrap().status, 200);
+        }
+        assert_eq!(fetch(client.clone(), callbacks.clone()).await.status, 200);
+
+        assert_eq!(network.load(Ordering::SeqCst), 1, "one transaction for nine requests");
+        assert_eq!(responses_seen.load(Ordering::SeqCst), 9, "every request is observed");
+    }
+
