@@ -368,6 +375,59 @@ impl StealthHttpClient {
         callbacks: Option<&CallbackRegistry>,
         initial_method: wreq::Method,
         initial_body: Option<Vec<u8>>,
+    ) -> Result<Response, ObscuraNetError> {
+        let cache_key = if initial_method == wreq::Method::GET && initial_body.is_none() {
+            ResourceCacheKey::for_request(
+                url,
+                &request,
+                &*self.extra_headers.read().await,
+                &self.cookie_jar,
+                stealth_identity::USER_AGENT.to_string(),
+            )
+        } else {
+            None
+        };
+        let Some(cache_key) = cache_key else {
+            return self
+                .fetch_with_profile_uncached(url, request, callbacks, initial_method, initial_body)
+                .await;
+        };
+        self.resource_loader
+            .load(
+                cache_key,
+                || {
+                    self.fetch_with_profile_uncached(
+                        url,
+                        request.clone(),
+                        callbacks,
+                        wreq::Method::GET,
+                        None,
+                    )
+                },
+                |response| async {
+                    if let Some(callbacks) = callbacks {
+                        let request_info = RequestInfo {
+                            url: url.clone(),
+                            method: wreq::Method::GET.to_string(),
+                            headers: self.extra_headers.read().await.clone(),
+                            resource_type: request.resource_type,
+                        };
+                        callbacks.fire_request(&request_info).await;
+                        callbacks.fire_response(&request_info, &response).await;
+                    }
+                    response
+                },
+            )
+            .await
+    }
