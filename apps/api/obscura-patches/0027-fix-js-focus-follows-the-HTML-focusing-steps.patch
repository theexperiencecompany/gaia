+}
+// HTML "focus delegate" of a shadow host whose shadow root delegates focus:
+// the first focusable area in its shadow tree, in tree order.
+function _focusDelegate(host) {
+  const root = _shadowRootForHost(host, true);
+  if (!root || !root.delegatesFocus) return null;
+  const all = root.querySelectorAll('*');
+  for (let i = 0; i < all.length; i++) {
+    if (_isFocusableArea(all[i])) return all[i];
+    const nested = _focusDelegate(all[i]);
+    if (nested) return nested;
+  }
+  return null;
+}
+function _fireFocusEvent(target, type, relatedTarget) {
+  const bubbles = type === 'focusin' || type === 'focusout';
+  target.dispatchEvent(globalThis.__obscura_markTrusted(new FocusEvent(type, {
+    bubbles, cancelable: false, composed: true, view: globalThis, relatedTarget,
+  })));
+}
+// Move focus to `next` (an element, or null for the viewport): blur and
+// focusout on the element losing it while nothing is focused, then focus and
+// focusin on the new one, as Chrome orders them. A blur handler that moves
+// focus itself wins.
+function _focusingSteps(next) {
+  const previous = _currentFocus();
+  if (previous === next) return;
+  if (previous) {
+    globalThis.__obscura_focused = null;
+    _fireFocusEvent(previous, 'blur', next);
+    _fireFocusEvent(previous, 'focusout', next);
+    if (_currentFocus() !== null) return;
+  }
+  if (!next || !next.isConnected) return;
+  globalThis.__obscura_focused = next;
+  _fireFocusEvent(next, 'focus', previous);
+  _fireFocusEvent(next, 'focusin', previous);
+}
+// The default action of a mousedown nobody cancelled (Chrome's mouse focus):
+// focus the nearest flat-tree inclusive ancestor of the pressed node that is
+// a focusable area (an editing host for content inside contenteditable), or
+// that host's focus delegate; with none, focus returns to the viewport.
+globalThis.__obscura_focusOnPress = function(target) {
+  for (let n = target; n; n = _flatTreeParent(n)) {
+    if (n.nodeType !== 1) continue;
+    if (_isFocusableArea(n)) {
+      _focusingSteps(n);
+      return;
+    }
+    const delegate = _focusDelegate(n);
+    if (delegate) {
+      const current = _currentFocus();
+      if (current && _retarget(current, n.ownerDocument) === _retarget(n, n.ownerDocument)
+          && current !== n) {
+        return;
+      }
+      _focusingSteps(delegate);
+      return;
+    }
+  }
+  _focusingSteps(null);
+};
