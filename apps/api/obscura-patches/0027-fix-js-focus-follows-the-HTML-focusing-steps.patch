+// ---- Focus (HTML "focusable area", "focusing steps", "unfocusing steps") ----
+// The element holding focus, wherever it is: inside a shadow tree it stays
+// the inner element, and document/shadow-root activeElement retarget it.
+function _currentFocus() {
+  const focused = globalThis.__obscura_focused || null;
+  // Focus fixup: a removed element no longer holds focus.
+  if (focused && !focused.isConnected) {
+    globalThis.__obscura_focused = null;
+    return null;
+  }
+  return focused;
+}
+globalThis.__obscura_focusedElement = _currentFocus;
+// The flat-tree parent: a slotted node's slot, a shadow root's host.
+function _flatTreeParent(node) {
+  if (node.nodeType === 1 || node.nodeType === 3) {
+    const slot = +_dom("assigned_slot", node._nid);
+    if (slot >= 0) return _wrap(slot);
+  }
+  const parent = node.parentNode;
+  return parent instanceof ShadowRoot ? parent.host : parent;
+}
+// An editing host: contenteditable true or plaintext-only on an element whose
+// parent is not itself editable.
+function _isEditingHost(el) {
+  const state = el.getAttribute('contenteditable');
+  if (state === null) return false;
+  const v = state.toLowerCase();
+  if (v !== '' && v !== 'true' && v !== 'plaintext-only') return false;
+  const parent = el.parentElement;
+  return !(parent && parent.isContentEditable);
+}
+// Elements HTML makes focusable areas, before rendering and disabled state.
+function _hasFocusableSemantics(el) {
+  const tabindex = el.getAttribute('tabindex');
+  if (tabindex !== null && /^[ \t\n\f\r]*[+-]?[0-9]/.test(tabindex)) return true;
+  const name = el.localName;
+  if (el.namespaceURI === 'http://www.w3.org/1999/xhtml') {
+    switch (name) {
+      case 'a':
+      case 'area':
+        return el.hasAttribute('href');
+      case 'input':
+        return (el.getAttribute('type') || '').toLowerCase() !== 'hidden';
+      case 'button':
+      case 'select':
+      case 'textarea':
+      case 'iframe':
+        return true;
+      case 'audio':
+      case 'video':
+        return el.hasAttribute('controls');
+      case 'summary': {
+        const details = el.parentElement;
+        if (!details || details.localName !== 'details') return false;
+        for (let c = details.firstElementChild; c; c = c.nextElementSibling) {
+          if (c.localName === 'summary') return c === el;
+        }
+        return false;
+      }
+    }
+  } else if (el.namespaceURI === 'http://www.w3.org/2000/svg' && name === 'a') {
+    return el.hasAttribute('href') || el.hasAttribute('xlink:href');
+  }
+  return _isEditingHost(el);
+}
+// Being rendered: the element has a layout box, and visibility lets it show.
+function _isBeingRendered(el) {
+  if (typeof Deno.core.ops.op_element_visibility !== 'function') return true;
+  const facts = Deno.core.ops.op_element_visibility(el._nid | 0, _realmFrameId);
+  if (facts < 0) return true;
+  return (facts & 1) !== 0 && (facts & 2) === 0;
+}
+function _isInert(el) {
+  for (let n = el; n; n = _flatTreeParent(n)) {
+    if (n.nodeType === 1 && n.hasAttribute('inert')) return true;
+  }
+  return false;
+}
+function _isFocusableArea(el) {
+  return !!el && el.nodeType === 1 && el.isConnected
+    && _hasFocusableSemantics(el)
+    && !_isActuallyDisabled(el)
+    && !_isInert(el)
