+    const rect = target.getBoundingClientRect();
+    const vw = globalThis.innerWidth || 1280;
+    const vh = globalThis.innerHeight || 720;
+    if (rect.top < 0 || rect.left < 0 || rect.bottom > vh || rect.right > vw) {
+      target.scrollIntoView({ block: 'center', inline: 'center' });
+    }
+  }
+  // Unfocus when this element, or a shadow host around the focused element,
+  // holds focus.
+  blur() {
+    const current = _currentFocus();
+    if (current && _retarget(current, this) === this) _focusingSteps(null);
+  }
 
