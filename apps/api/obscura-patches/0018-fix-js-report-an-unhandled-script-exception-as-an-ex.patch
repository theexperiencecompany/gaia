 /// HTML's "report the exception" for a script's uncaught exception: hands the
 /// message, the source URL, the 1-based line and column and the thrown value to
 /// the current realm's reporter, which fires `onerror` and `error` listeners.
+/// When none of them handled it, the exception goes to the developer console as
+/// an exception (`Runtime.exceptionThrown`), the way a browser reports it; it is
+/// not a `console.error` call, which would tell a CDP client the page logged it.
 pub(crate) fn report_script_exception(
     scope: &mut v8::TryCatch<v8::HandleScope>,
     exception: v8::Local<v8::Value>,
 ) {
+    let error = deno_core::error::JsError::from_v8_exception(scope, exception);
+    if dispatch_script_error(scope, exception) {
+        return;
+    }
+    let state = deno_core::JsRuntime::op_state_from(scope);
+    let Some(page) = state.borrow().try_borrow::<SharedState>().cloned() else {
+        return;
+    };
+    let mut page = page.borrow_mut();
+    let first = error.frames.first();
+    let url = first
+        .and_then(|frame| frame.file_name.clone())
+        .unwrap_or_default();
+    let message = format!(
+        "Uncaught {}{}",
+        error.exception_message.trim_start_matches("Uncaught "),
+        first
+            .filter(|_| !url.is_empty())
+            .map(|frame| format!(
+                " ({url}:{}:{})",
+                frame.line_number.unwrap_or(0),
+                frame.column_number.unwrap_or(0)
+            ))
+            .unwrap_or_default()
+    );
+    tracing::error!(target: "obscura::console", "{}", message);
+    if page.console_messages_enabled {
+        if page.pending_console_messages.len() >= 1_024 {
+            page.pending_console_messages.pop_front();
+        }
+        page.pending_console_messages
+            .push_back(format!("[error] {message}"));
+    }
+    record_uncaught_exception(&mut page, &error, &url);
+}
+
+/// Fires `onerror` and the `error` event for an uncaught script exception and
+/// says whether a handler handled it (returned true from `onerror`, or
+/// cancelled the event).
+fn dispatch_script_error(
+    scope: &mut v8::TryCatch<v8::HandleScope>,
+    exception: v8::Local<v8::Value>,
+) -> bool {
     let (text, filename, line, column) = match scope.message() {
         Some(message) => {
             let text = message.get(scope).into();
@@ -1376,18 +1486,20 @@ pub(crate) fn report_script_exception(
     let context = scope.get_current_context();
     let global = context.global(scope);
     let Some(key) = v8::String::new(scope, "__obscura_reportScriptError") else {
-        return;
+        return false;
     };
     let scope = &mut v8::TryCatch::new(scope);
     let Some(reporter) = global
         .get(scope, key.into())
         .and_then(|value| v8::Local::<v8::Function>::try_from(value).ok())
     else {
-        return;
+        return false;
     };
     let line = v8::Integer::new(scope, line).into();
     let column = v8::Integer::new(scope, column).into();
-    reporter.call(scope, global.into(), &[text, filename, line, column, exception]);
+    reporter
+        .call(scope, global.into(), &[text, filename, line, column, exception])
+        .is_some_and(|handled| handled.is_true())
 }
 
