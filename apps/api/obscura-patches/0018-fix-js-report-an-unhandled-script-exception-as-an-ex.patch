+    /// An uncaught script exception nobody handled reaches the developer console
+    /// once, as the exception itself (CDP `Runtime.exceptionThrown`), never as a
+    /// `console.error` call the page did not make. One an `error` listener
+    /// cancelled is not reported at all (HTML "report an exception").
+    #[test]
+    fn uncaught_script_exception_is_reported_once_as_an_exception() {
+        let mut rt = setup_runtime("<html><head></head><body></body></html>");
+        rt.set_runtime_events_enabled(true);
+        let summary = |events: Vec<RuntimeEvent>| -> Vec<String> {
+            events
+                .into_iter()
+                .map(|event| match event {
+                    RuntimeEvent::Console(event) => format!("console.{}", event.kind),
+                    RuntimeEvent::Exception(event) => format!(
+                        "exception {} {}:{}:{}",
+                        event.description.lines().next().unwrap_or(""),
+                        event.url,
+                        event.line_number,
+                        event.column_number,
+                    ),
+                })
+                .collect()
+        };
+
+        assert!(rt
+            .execute_page_script_guarded("https://www.example.com/", "\"use strict\";\n_w.x = 1;")
+            .is_err());
+        rt.execute_script(
+            "insert",
+            "const s = document.createElement('script'); s.textContent = 'null.y'; document.body.appendChild(s);",
+        )
+        .unwrap();
+        assert_eq!(
+            summary(rt.take_pending_runtime_events()),
+            [
+                "exception ReferenceError: _w is not defined https://www.example.com/:1:0",
+                "exception TypeError: Cannot read properties of null (reading 'y') http://example.com/test:0:5",
+            ]
+        );
+
+        rt.execute_script(
+            "setup",
+            "addEventListener('error', (e) => e.preventDefault());",
+        )
+        .unwrap();
+        assert!(rt
+            .execute_page_script_guarded("https://www.example.com/", "_w.x = 1;")
+            .is_err());
+        assert_eq!(summary(rt.take_pending_runtime_events()), Vec::<String>::new());
+    }
+
     /// A document's own parser-inserted script reports an uncaught exception to
     /// `onerror` with its URL, as a browser does; host-internal scripts do not.
     #[test]
