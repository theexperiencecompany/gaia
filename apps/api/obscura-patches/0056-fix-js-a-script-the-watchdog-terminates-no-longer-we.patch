+    /// A runaway in-order script the watchdog kills never reports its own
+    /// completion; the scripts queued behind it must still run.
+    #[tokio::test(flavor = "current_thread")]
+    async fn a_terminated_in_order_script_does_not_wedge_the_scripts_behind_it() {
+        let mut rt = setup_runtime("<html><head></head><body></body></html>");
+        rt.evaluate(
+            r#"
+            const looping = document.createElement('script');
+            looping.async = false;
+            looping.src = 'data:text/javascript,while (true) {}';
+            const next = document.createElement('script');
+            next.async = false;
+            next.src = 'data:text/javascript,window.__nextRan = true';
+            document.head.append(looping, next);
+            true
+            "#,
+        )
+        .unwrap();
+        let watchdog = rt.arm_watchdog(std::time::Duration::from_millis(300));
+        let _ = tokio::time::timeout(std::time::Duration::from_secs(10), rt.run_event_loop()).await;
+        assert!(rt.disarm_watchdog(watchdog), "the looping script was not terminated");
+
+        rt.run_event_loop_bounded(200).await.unwrap();
+        assert_eq!(rt.evaluate("window.__nextRan === true").unwrap(), serde_json::json!(true));
+        assert_eq!(
+            rt.evaluate("globalThis.__obscura_hasPendingDynamicScripts()").unwrap(),
+            serde_json::json!(false)
+        );
+    }
+
