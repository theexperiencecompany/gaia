 crates/obscura-js/js/bootstrap.js | 19 +++++++++++-
 crates/obscura-js/src/ops.rs      |  5 ++++
 crates/obscura-js/src/runtime.rs  | 48 +++++++++++++++++++++++++++++--
 3 files changed, 69 insertions(+), 3 deletions(-)

diff --git a/crates/obscura-js/js/bootstrap.js b/crates/obscura-js/js/bootstrap.js
index 3eac80f..b257124 100644
--- a/crates/obscura-js/js/bootstrap.js
+++ b/crates/obscura-js/js/bootstrap.js
@@ -381,10 +381,16 @@ async function __runDynScriptTask(task) {
         // page's Promise polyfill is not involved), which leaves no bootstrap
         // frame below the script's top level.
         await new Promise(resolve => {
+          const settle = () => {
+            if (!_scriptRunsInFlight.delete(settle)) return;
+            globalThis.__currentScriptNid = task.prevNid || 0;
+            resolve();
+          };
+          _scriptRunsInFlight.add(settle);
           const run = Deno.core.ops.op_script_run_classic.bind(
             null, body, task.url, _realmFrameId,
             () => { globalThis.__currentScriptNid = task.nid; },
-            () => { globalThis.__currentScriptNid = task.prevNid || 0; resolve(); },
+            settle,
           );
           const execute = () => { Deno.core.ops.op_queue_microtask(run); };
           if (_scheduleAfter(0, execute) === undefined) execute();
@@ -405,6 +411,17 @@ async function __runDynScriptTask(task) {
     }
   }
 }
+// Completions of fetched scripts handed to the engine to run. One the engine
+// terminates (a runaway script past its budget) never reports back, so the
+// host settles them once it has cancelled the termination; otherwise the
+// in-order queue and the load-delaying count would wait on it forever.
+const _scriptRunsInFlight = new Set();
+Object.defineProperty(globalThis, '__obscura_settleTerminatedScripts', {
+  value: function() { for (const settle of [..._scriptRunsInFlight]) settle(); },
+  writable: false,
+  enumerable: false,
+  configurable: false,
+});
 async function __runAsyncClassicScript(task) {
   __dynClassicPending++;
   try {
