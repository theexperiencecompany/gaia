+
+    /// After a termination is cancelled: the fetched scripts the engine was
+    /// running when it fired never reported their completion. Settle them in
+    /// every realm so the scripts queued behind them run.
+    fn settle_terminated_scripts(&mut self) {
+        const SETTLE: &str = "globalThis.__obscura_settleTerminatedScripts?.(), true";
+        let _ = self.execute_runtime_script("<settle-terminated-scripts>", SETTLE.to_string());
+        let frames = self.realm_states().borrow().frame_contexts();
+        for frame in frames {
+            let _ = self.eval_in_realm(&frame, SETTLE);
+        }
     }
 
     /// Drive the event loop for at most `budget_ms`, bounded against BOTH async
@@ -3243,7 +3257,7 @@ impl ObscuraJsRuntime {
