+/// The CDP events of one navigation, emitted as it reaches each step, the way
+/// Chrome reports them: the commit (document request, frameNavigated, fresh
+/// execution contexts, `commit`), then `DOMContentLoaded` and `load` when the
+/// document fires them, then the rest of the network log, `networkIdle` when
+/// nothing is in flight, and frameStoppedLoading. A page script that
+/// navigates again while loading commits a new document under a new loader.
+pub(crate) struct NavigationEvents {
+    session_id: Option<String>,
+    frame_id: String,
+    page_id: String,
+    browser_context_id: String,
+    /// The loader of the document committed last. The first commit uses the
+    /// loaderId the `Page.navigate` response carries.
+    loader_id: String,
+    commits: usize,
+    /// Main-document responses already reported, by the page's request id,
+    /// with the loader id they are reported under.
+    documents: Vec<(String, String)>,
+}
+
+impl NavigationEvents {
