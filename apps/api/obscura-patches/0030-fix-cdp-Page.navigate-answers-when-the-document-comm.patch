+        loader_id: &str,
+    ) -> Self {
+        Self {
+            session_id: session_id.clone(),
+            frame_id: page.frame_id.clone(),
+            page_id: page.id.clone(),
+            browser_context_id: page.context.id.clone(),
+            loader_id: loader_id.to_string(),
+            commits: 0,
+            documents: Vec::new(),
         }
-        if internal_id != loader_id {
