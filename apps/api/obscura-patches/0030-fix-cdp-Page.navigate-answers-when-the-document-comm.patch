+    /// The navigation starts: Chrome reports frameStartedLoading.
+    pub(crate) fn started(&self, ctx: &mut CdpContext) {
+        ctx.pending_events.push(CdpEvent {
+            method: "Page.frameStartedLoading".into(),
+            params: json!({"frameId": self.frame_id}),
+            session_id: self.session_id.clone(),
+        });
+    }
+
+    /// Whether a document has committed.
+    pub(crate) fn committed(&self) -> bool {
+        self.commits > 0
+    }
+
+    pub(crate) fn progress(
+        &mut self,
+        ctx: &mut CdpContext,
+        step: obscura_browser::NavigationProgress,
