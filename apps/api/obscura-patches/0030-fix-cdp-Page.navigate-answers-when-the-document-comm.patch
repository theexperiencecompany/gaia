+        match step {
+            obscura_browser::NavigationProgress::Committed { url, title, document } => {
+                if self.commits > 0 {
+                    self.loader_id = format!("loader-{}", uuid::Uuid::new_v4());
+                }
+                self.commits += 1;
+                self.commit(ctx, &url, document.as_ref());
+                // The target's URL changes when the document commits; clients
+                // that track TargetInfo would otherwise keep the old one for
+                // the whole load.
+                self.target_info_changed(ctx, &url, &title);
+            }
+            obscura_browser::NavigationProgress::DomContentLoaded => {
+                self.lifecycle(ctx, "DOMContentLoaded");
+                ctx.pending_events.push(CdpEvent {
+                    method: "Page.domContentEventFired".into(),
+                    params: json!({"timestamp": timestamp()}),
+                    session_id: self.session_id.clone(),
+                });
+            }
+            obscura_browser::NavigationProgress::Load => {
+                self.lifecycle(ctx, "load");
+                ctx.pending_events.push(CdpEvent {
+                    method: "Page.loadEventFired".into(),
+                    params: json!({"timestamp": timestamp()}),
+                    session_id: self.session_id.clone(),
+                });
             }
