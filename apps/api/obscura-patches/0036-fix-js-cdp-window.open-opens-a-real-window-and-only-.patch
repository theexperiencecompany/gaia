+/// Close a page target: detach every session attached to it, report it
+/// destroyed, and drop the page.
+pub(crate) fn close_target(ctx: &mut CdpContext, target_id: &str) {
+    let mut sessions = ctx
+        .sessions
+        .iter()
+        .filter(|(_, page_id)| page_id.as_str() == target_id)
+        .map(|(session_id, _)| session_id.clone())
+        .collect::<Vec<_>>();
+    sessions.sort_unstable();
+    for session_id in sessions {
+        ctx.pending_events.push(CdpEvent::new(
+            "Target.detachedFromTarget",
+            json!({
+                "sessionId": session_id,
+                "targetId": target_id,
+            }),
+        ));
+    }
+    ctx.pending_events.push(CdpEvent::new(
+        "Target.targetDestroyed",
+        json!({ "targetId": target_id }),
+    ));
+    ctx.remove_page(target_id);
+}
+
+/// Open the auxiliary window page script asked for with window.open: a new
+/// page in the opener's browser context, on about:blank, reported created
+/// (with its opener) and attached, as Target.createTarget reports a target.
+/// Returns the new page's id and session; the caller navigates it.
+pub(crate) fn open_window(ctx: &mut CdpContext, opener_id: &str) -> Option<(String, String)> {
+    let context_id = ctx.get_page(opener_id)?.context.id.clone();
+    let explicit_context = ctx.browser_context(&context_id).is_some();
+    let page_id = ctx
+        .create_page_in_context(explicit_context.then_some(context_id.as_str()))
+        .ok()?;
+    let session_id = format!("{page_id}-session");
+    let page = ctx.get_page_mut(&page_id)?;
+    page.navigate_blank();
+    let target_info = json!({
+        "targetId": page_id,
+        "type": "page",
+        "title": page.title,
+        "url": page.url_string(),
+        "attached": true,
+        "canAccessOpener": false,
+        "openerId": opener_id,
+        "browserContextId": page.context.id,
+    });
+    ctx.sessions.insert(session_id.clone(), page_id.clone());
+    ctx.pending_events.push(CdpEvent::new(
+        "Target.targetCreated",
+        json!({ "targetInfo": target_info }),
+    ));
+    ctx.pending_events.push(CdpEvent::new(
+        "Target.attachedToTarget",
+        json!({
+            "sessionId": session_id,
+            "targetInfo": target_info,
+            "waitingForDebugger": false,
+        }),
+    ));
+    Some((page_id, session_id))
+}
