+/// A request page script made of an auxiliary window (HTML "window open
+/// steps"), identified by the id window.open returned for it.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum WindowRequest {
+    /// Open a new top-level traversable on `url`.
+    Open { id: u32, url: String },
+    /// Navigate an opened window to `url`.
+    Navigate { id: u32, url: String },
+    /// Close an opened window.
+    Close { id: u32 },
+}
+
+/// Queue a window request on the page (a frame's window.open opens a window
+/// of the page). `kind` is "open", "navigate" or "close"; "open" returns the
+/// new window's id.
+#[op2(fast)]
+fn op_window_request(state: &OpState, #[string] kind: &str, id: u32, #[string] url: &str) -> u32 {
+    let shared = frame_state(state, 0);
+    let mut gs = shared.borrow_mut();
+    match kind {
+        "open" => {
+            gs.next_window_id += 1;
+            let id = gs.next_window_id;
+            gs.window_requests.push(WindowRequest::Open { id, url: url.to_string() });
+            id
+        }
+        "navigate" => {
+            gs.window_requests.push(WindowRequest::Navigate { id, url: url.to_string() });
+            id
+        }
+        "close" => {
+            gs.window_requests.push(WindowRequest::Close { id });
+            id
+        }
+        _ => 0,
+    }
+}
+
 fn frame_message_queue_entry_limit() -> usize {
