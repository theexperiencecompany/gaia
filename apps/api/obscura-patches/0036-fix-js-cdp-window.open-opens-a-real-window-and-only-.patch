+/// Carry out what page script asked of windows (window.open): open a new
+/// page and load its URL, navigate a page it opened, or close one. Loads take
+/// the same navigation path as a client's Page.navigate, reporting through its
+/// events, with no command to answer.
+async fn service_window_requests(
+    ctx: &mut CdpContext,
+    reply_tx: &mpsc::UnboundedSender<String>,
+    rx: &mut mpsc::UnboundedReceiver<ServerMessage>,
+    intercept_rx: &mut Option<mpsc::UnboundedReceiver<obscura_js::ops::InterceptedRequest>>,
+    intercepted_paused: &mut HashMap<String, tokio::sync::oneshot::Sender<obscura_js::ops::InterceptResolution>>,
+    deferred: &mut std::collections::VecDeque<ServerMessage>,
+) {
+    let requests: Vec<(String, obscura_js::ops::WindowRequest)> = ctx
+        .pages
+        .iter()
+        .flat_map(|page| {
+            let opener = page.id.clone();
+            page.take_window_requests()
+                .into_iter()
+                .map(move |request| (opener.clone(), request))
+        })
+        .collect();
+    for (opener, request) in requests {
+        let (page_id, url) = match request {
+            obscura_js::ops::WindowRequest::Open { id, url } => {
+                let Some((page_id, _)) = crate::domains::target::open_window(ctx, &opener) else {
+                    continue;
+                };
+                ctx.opened_windows.insert((opener.clone(), id), page_id.clone());
+                forward_events(ctx, reply_tx);
+                (page_id, url)
+            }
+            obscura_js::ops::WindowRequest::Navigate { id, url } => {
+                let Some(page_id) = ctx.opened_windows.get(&(opener.clone(), id)).cloned() else {
+                    continue;
+                };
+                (page_id, url)
+            }
+            obscura_js::ops::WindowRequest::Close { id } => {
+                if let Some(page_id) = ctx.opened_windows.remove(&(opener.clone(), id)) {
+                    crate::domains::target::close_target(ctx, &page_id);
+                    forward_events(ctx, reply_tx);
+                }
+                continue;
+            }
+        };
+        if url == "about:blank" {
+            continue;
+        }
+        let Some(session_id) = ctx
+            .sessions
+            .iter()
+            .find(|(_, owner)| **owner == page_id)
+            .map(|(session_id, _)| session_id.clone())
+        else {
+            continue;
+        };
+        let navigation = json!({
+            "id": 0,
+            "method": "Page.navigate",
+            "params": {"url": url},
+            "sessionId": session_id,
+        })
+        .to_string();
+        process_with_interception(
+            &navigation,
+            ctx,
+            reply_tx,
+            rx,
+            intercept_rx,
+            intercepted_paused,
+            deferred,
+            false,
+        )
+        .await;
+    }
+}
