     ctx: &CdpContext,
 ) -> Option<(String, String, String, String)> {
diff --git a/crates/obscura-js/js/bootstrap.js b/crates/obscura-js/js/bootstrap.js
index eda0d40..a3cecc9 100644
--- a/crates/obscura-js/js/bootstrap.js
+++ b/crates/obscura-js/js/bootstrap.js
@@ -14678,7 +14678,73 @@ globalThis.print = function() {}; _markNative(globalThis.print);
 globalThis.alert = function() {}; _markNative(globalThis.alert);
 globalThis.confirm = function() { return true; }; _markNative(globalThis.confirm);
 globalThis.prompt = function() { return null; }; _markNative(globalThis.prompt);
-globalThis.open = function() { return null; }; _markNative(globalThis.open);
+// HTML transient user activation: a trusted press, release or key press
+// activates the page for a few seconds, and opening a popup consumes it, so
+// a page cannot open windows on its own (Chrome's popup blocker).
+const _USER_ACTIVATION_MS = 5000;
+let _userActivationAt = -Infinity;
+globalThis.__obscura_noteUserActivation = function() { _userActivationAt = performance.now(); };
+function _consumeUserActivation() {
+  const active = performance.now() - _userActivationAt <= _USER_ACTIVATION_MS;
+  _userActivationAt = -Infinity;
+  return active;
+}
+// A window this page opened. It is another page of the browser, so what the
+// embedder can carry across is what it offers: navigating it and closing it.
+class _OpenedWindow {
+  constructor(id) { this._id = id; this._closed = false; }
+  get closed() { return this._closed; }
+  close() {
+    if (this._closed) return;
+    this._closed = true;
+    Deno.core.ops.op_window_request('close', this._id, '');
+  }
+  _navigate(url) {
+    if (!this._closed) Deno.core.ops.op_window_request('navigate', this._id, _resolveUrl(String(url)));
+  }
+  get location() {
+    const win = this;
+    return {
+      assign(url) { win._navigate(url); },
+      replace(url) { win._navigate(url); },
+      set href(url) { win._navigate(url); },
+    };
+  }
+  set location(url) { this._navigate(url); }
+  get self() { return this; }
+  get window() { return this; }
+}
+const _openedWindowsByName = new Map();
+// HTML "window open steps" for a top-level page: _self/_parent/_top navigate
+// this page; any other target opens a new top-level window (reusing one this
+// page opened under the same name), if the page has transient activation.
+globalThis.open = function open(url, target, features) {
+  url = url === undefined || url === null ? '' : String(url);
+  const name = target === undefined || target === null || String(target) === '' ? '_blank' : String(target);
+  const keyword = name.toLowerCase();
+  let resolved = 'about:blank';
+  if (url !== '') {
+    try { resolved = new URL(url, _documentBase() || 'about:blank').href; }
+    catch (_e) { throw new DOMException(`Failed to execute 'open' on 'Window': Unable to open a window with invalid URL '${url}'.`, 'SyntaxError'); }
+  }
+  if (keyword === '_self' || keyword === '_parent' || keyword === '_top') {
+    if (url !== '') location.assign(resolved);
+    return globalThis;
+  }
+  const tokens = String(features === undefined || features === null ? '' : features)
+    .toLowerCase().split(/[\s,=]+/);
+  const noopener = tokens.includes('noopener') || tokens.includes('noreferrer');
+  const existing = keyword === '_blank' ? null : _openedWindowsByName.get(name);
+  if (existing && !existing.closed) {
+    if (url !== '') existing._navigate(resolved);
+    return noopener ? null : existing;
+  }
+  if (!_consumeUserActivation()) return null;
+  const win = new _OpenedWindow(Deno.core.ops.op_window_request('open', 0, resolved));
+  if (keyword !== '_blank') _openedWindowsByName.set(name, win);
+  return noopener ? null : win;
+};
+_markNative(globalThis.open);
 globalThis.close = function() {}; _markNative(globalThis.close);
 globalThis.stop = function() {}; _markNative(globalThis.stop);
 // `window.postMessage` targets this same window. It was a no-op, so a page
