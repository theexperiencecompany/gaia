-  // No service worker ever runs here, so a registration stays empty
-  // (installing/waiting/active all null) and `ready`, which waits for an
-  // active worker, never settles -- as in a browser whose worker has not
-  // activated. register() still resolves to a registration, because pages
-  // attach handlers to it (nytimes.com sets `registration.onupdatefound`).
-  serviceWorker: { ready: new Promise(() => {}), register(scriptURL, options) { return _serviceWorkerRegister(scriptURL, options); }, getRegistration(clientURL) { return _serviceWorkerGetRegistration(clientURL); }, getRegistrations() { return Promise.resolve([..._serviceWorkerRegistrations.values()]); }, startMessages() {}, controller: null, oncontrollerchange: null, onmessage: null, addEventListener(){}, removeEventListener(){}, dispatchEvent(){return true;} },
+  // A registered worker is modelled as one whose script defines no event
+  // handlers: it activates at once, so `ready` resolves for a page inside its
+  // scope as in a browser, and it never handles fetches or messages.
+  serviceWorker: { get ready() { return _serviceWorkerReady().promise; }, register(scriptURL, options) { return _serviceWorkerRegister(scriptURL, options); }, getRegistration(clientURL) { return _serviceWorkerGetRegistration(clientURL); }, getRegistrations() { return Promise.resolve([..._serviceWorkerRegistrations.values()]); }, startMessages() {}, controller: null, oncontrollerchange: null, onmessage: null, addEventListener(){}, removeEventListener(){}, dispatchEvent(){return true;} },
   mediaDevices: {
     enumerateDevices() {
       return Promise.resolve([
@@ -16187,6 +16185,20 @@ if (typeof ServiceWorkerContainer === 'undefined') {
   globalThis.ServiceWorkerContainer = class { register(){return Promise.resolve();} getRegistrations(){return Promise.resolve([]);} };
 }
 
+class ServiceWorker {
+  constructor(scriptURL) {
+    this._scriptURL = scriptURL;
+    this.onstatechange = null;
+    this.onerror = null;
+    _makeListenerBox(this);
+  }
+  get scriptURL() { return this._scriptURL; }
+  get state() { return "activated"; }
+  postMessage() {}
+}
+_markNative(ServiceWorker);
+Object.defineProperty(globalThis, "ServiceWorker", { value: ServiceWorker, writable: true, enumerable: false, configurable: true });
+
 class ServiceWorkerRegistration {
   constructor(scope) {
     this._scope = scope;
@@ -16217,6 +16229,39 @@ Object.defineProperty(globalThis, "ServiceWorkerRegistration", { value: ServiceW
 
 // Registrations by scope URL for this document's lifetime.
 var _serviceWorkerRegistrations = new Map();
+// ServiceWorkerContainer is [SecureContext]: __obscura_init exposes it only
+// to documents that are secure contexts.
+var _serviceWorkerContainer = globalThis.navigator.serviceWorker;
+
+// HTML "secure context" for a window: its URL is potentially trustworthy
+// (https, wss, file, or a loopback http host; a blob: URL by its origin), and
+// a frame's parent is one too. A top-level about:blank or data: document has
+// an opaque origin and is not; an about:blank or srcdoc frame is its parent's.
+function _isPotentiallyTrustworthyUrl(href) {
+  let url;
+  try { url = new URL(href); } catch (_e) { return false; }
+  if (url.protocol === 'blob:') {
+    try { url = new URL(url.pathname); } catch (_e) { return false; }
+  }
+  if (url.protocol === 'https:' || url.protocol === 'wss:' || url.protocol === 'file:') return true;
+  if (url.protocol !== 'http:' && url.protocol !== 'ws:') return false;
+  const host = url.hostname;
+  return host === 'localhost' || host.endsWith('.localhost') || /^127\./.test(host) || host === '[::1]';
+}
+function _isSecureContext() {
+  const href = String(globalThis.location?.href || '');
+  let parentSecure = null;
+  if (globalThis.parent && globalThis.parent !== globalThis) {
+    // A cross-origin parent is unreadable here; its URL then cannot count.
+    try { parentSecure = globalThis.parent.isSecureContext; } catch (_e) {}
+  }
+  if (href === 'about:blank' || href === 'about:srcdoc') return parentSecure === true;
+  return parentSecure !== false && _isPotentiallyTrustworthyUrl(href);
+}
+Object.defineProperty(globalThis, 'isSecureContext', {
+  get: _markNative(function isSecureContext() { return _isSecureContext(); }),
+  set: undefined, enumerable: true, configurable: true,
+});
 // ServiceWorkerContainer.register per the Service Workers spec, minus running
 // the worker: the script URL must be same-origin http(s), the scope defaults to
 // the script's directory and must share its origin.
@@ -16246,8 +16291,23 @@ function _serviceWorkerRegister(scriptURL, options) {
     registration = new ServiceWorkerRegistration(key);
     _serviceWorkerRegistrations.set(key, registration);
   }
+  registration.active = new ServiceWorker(script.href);
+  if (String(globalThis.location?.href || "").startsWith(key)) {
+    _serviceWorkerReady().resolve(registration);
+  }
   return Promise.resolve(registration);
 }
+// navigator.serviceWorker.ready: settles with the registration whose scope
+// covers this document once it has an active worker.
+var _serviceWorkerReadyDeferred = null;
+function _serviceWorkerReady() {
+  if (!_serviceWorkerReadyDeferred) {
+    let resolve;
+    const promise = new Promise((r) => { resolve = r; });
+    _serviceWorkerReadyDeferred = { promise, resolve };
+  }
+  return _serviceWorkerReadyDeferred;
+}
 function _serviceWorkerGetRegistration(clientURL) {
   let url;
   try { url = new URL(clientURL == null ? globalThis.location.href : String(clientURL), _documentBase() || globalThis.location?.href).href; }
@@ -16463,6 +16523,13 @@ globalThis.__obscura_init = function() {
     usedJSHeapSize: Math.floor(_totalHeap * (0.3 + _fpRand(621) * 0.5)),
   };
   globalThis.Notification.permission = "default";
+  if (_isSecureContext()) {
+    Object.defineProperty(globalThis.navigator, 'serviceWorker', {
+      value: _serviceWorkerContainer, writable: true, enumerable: true, configurable: true,
+    });
+  } else {
+    delete globalThis.navigator.serviceWorker;
+  }
 
   // userAgentData brands and getHighEntropyValues now derive the Chrome
   // version from navigator.userAgent and read the platform from the page
