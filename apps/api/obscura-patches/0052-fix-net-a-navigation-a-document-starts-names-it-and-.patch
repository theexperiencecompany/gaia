+/// The Origin header a request carries, if any (Fetch, "append a request
+/// `Origin` header"): a CORS request across origins, and any request whose
+/// method is neither GET nor HEAD, a form post included. Under the default
+/// referrer policy an https initiator sending to a non-https URL reveals no
+/// origin, so that one says `null`.
+pub(crate) fn request_origin_header(
+    request: &ResourceRequest,
+    target: &Url,
+    get_or_head: bool,
+    redirect_tainted: bool,
+) -> Option<String> {
+    if cors_required(request, target) {
+        return Some(serialized_request_origin(request, redirect_tainted));
+    }
+    if get_or_head {
+        return None;
+    }
+    let downgrade = request
