diff --git a/crates/obscura-browser/tests/navigation_request_headers.rs b/crates/obscura-browser/tests/navigation_request_headers.rs
new file mode 100644
index 0000000..76450e9
--- /dev/null
+++ b/crates/obscura-browser/tests/navigation_request_headers.rs
@@ -0,0 +1,125 @@
+//! A navigation a document starts (a form post, a link) names that document
+//! the way Chrome does: same-origin Sec-Fetch-Site, a Referer, and an Origin
+//! on a post (as any script POST has). One the browser starts names none. Sites check these against
+//! CSRF; a login posted with Sec-Fetch-Site none and no Origin or Referer is
+//! refused by Django-style guards.
+
+use std::collections::HashMap;
+use std::io::{Read, Write};
+use std::sync::{mpsc, Arc};
+
+use obscura_browser::{BrowserContext, Page};
+
+const FORM_PAGE: &str = r#"<!doctype html><html><body>
+<form id="f" method="post" action="/login"><input name="user" value="me"></form>
+<a id="link" href="/next">next</a>
+</body></html>"#;
+
+/// Serves the form page at any path and records each request's path and
+/// lower-cased headers.
+fn spawn_server() -> (String, mpsc::Receiver<(String, HashMap<String, String>)>) {
+    let listener = std::net::TcpListener::bind("127.0.0.1:0").unwrap();
+    let address = listener.local_addr().unwrap();
+    let (tx, rx) = mpsc::channel();
+    std::thread::spawn(move || {
+        for incoming in listener.incoming() {
+            let Ok(mut stream) = incoming else { continue };
+            let mut request = Vec::new();
+            let mut chunk = [0u8; 4096];
+            while !request.windows(4).any(|bytes| bytes == b"\r\n\r\n") {
+                match stream.read(&mut chunk) {
+                    Ok(0) | Err(_) => break,
+                    Ok(read) => request.extend_from_slice(&chunk[..read]),
+                }
+            }
+            let text = String::from_utf8_lossy(&request).into_owned();
+            let mut lines = text.split("\r\n");
+            let path = lines
+                .next()
+                .and_then(|line| line.split_whitespace().nth(1))
+                .unwrap_or("/")
+                .to_string();
+            let headers = lines
+                .take_while(|line| !line.is_empty())
+                .filter_map(|line| line.split_once(':'))
+                .map(|(name, value)| (name.trim().to_ascii_lowercase(), value.trim().to_string()))
+                .collect();
+            let _ = tx.send((path, headers));
+            let response = format!(
+                "HTTP/1.1 200 OK\r\nContent-Type: text/html\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{FORM_PAGE}",
+                FORM_PAGE.len()
+            );
+            let _ = stream.write_all(response.as_bytes());
+        }
+    });
+    (format!("http://{address}"), rx)
+}
+
+fn request_to(rx: &mpsc::Receiver<(String, HashMap<String, String>)>, path: &str) -> HashMap<String, String> {
+    loop {
+        let (seen, headers) = rx
+            .recv_timeout(std::time::Duration::from_secs(5))
+            .unwrap_or_else(|_| panic!("no request to {path}"));
+        if seen == path {
+            return headers;
+        }
+    }
+}
+
+async fn assert_navigation_headers(stealth: bool) {
+    std::env::set_var("OBSCURA_ALLOW_PRIVATE_NETWORK", "1");
+    let (base, rx) = spawn_server();
+    let context = Arc::new(BrowserContext::with_storage_and_network(
+        "navigation-headers".to_string(),
+        None,
+        stealth,
+        None,
+        None,
+        true,
+    ));
+    let mut page = Page::new("navigation-headers-page".to_string(), context);
+
+    page.navigate(&format!("{base}/")).await.unwrap();
+    let typed = request_to(&rx, "/");
+    assert_eq!(typed.get("sec-fetch-site").map(String::as_str), Some("none"));
+    assert_eq!(typed.get("referer"), None);
+    assert_eq!(typed.get("origin"), None);
+
+    page.evaluate(
+        "(function () { window.__posted = false; \
+         fetch('/api', {method: 'POST', body: 'x'}).then(() => { window.__posted = true; }); })()",
+    );
+    for _ in 0..20 {
+        page.settle(100).await;
+        if page.evaluate("window.__posted") == serde_json::json!(true) {
+            break;
+        }
+    }
+    let scripted = request_to(&rx, "/api");
+    assert_eq!(scripted.get("origin"), Some(&base), "a same-origin POST names its origin");
+
+    page.evaluate("document.getElementById('f').submit()");
+    assert!(page.process_pending_navigation().await.unwrap(), "the form did not navigate");
+    let posted = request_to(&rx, "/login");
+    assert_eq!(posted.get("sec-fetch-site").map(String::as_str), Some("same-origin"));
+    assert_eq!(posted.get("origin"), Some(&base));
+    assert_eq!(posted.get("referer"), Some(&format!("{base}/")));
+
+    page.evaluate("document.getElementById('link').click()");
+    assert!(page.process_pending_navigation().await.unwrap(), "the link did not navigate");
+    let followed = request_to(&rx, "/next");
+    assert_eq!(followed.get("sec-fetch-site").map(String::as_str), Some("same-origin"));
+    assert_eq!(followed.get("referer"), Some(&format!("{base}/login")));
+    assert_eq!(followed.get("origin"), None);
+}
+
+#[tokio::test(flavor = "current_thread")]
+async fn page_started_navigations_name_their_document() {
+    assert_navigation_headers(false).await;
+}
+
+#[cfg(feature = "stealth")]
+#[tokio::test(flavor = "current_thread")]
+async fn stealth_page_started_navigations_name_their_document() {
+    assert_navigation_headers(true).await;
+}
