+/// The elements whose focus pseudo-class state differs between two focus
+/// states, with the state that flipped: :focus on the focused elements and the
+/// shadow hosts holding them, :focus-visible where its flag changed, and
+/// :focus-within on the shadow-including ancestors the two chains do not
+/// share.
+fn focus_state_flips(
+    tree: &DomTree,
+    previous: Option<(NodeId, bool)>,
+    next: Option<(NodeId, bool)>,
+) -> Vec<(NodeId, &'static str)> {
+    fn chain(tree: &DomTree, focused: Option<NodeId>) -> Vec<NodeId> {
+        let mut out = Vec::new();
+        let mut current = focused;
+        while let Some(id) = current {
+            out.push(id);
+            current = tree
+                .get_node(id)
+                .and_then(|node| node.parent)
+                .or_else(|| tree.shadow_root_info(id).map(|root| root.host));
+        }
+        out
+    }
+    // A shadow host matches :focus while its shadow tree holds focus.
+    fn focus_holders(tree: &DomTree, focused: Option<NodeId>) -> HashSet<NodeId> {
+        let chain = chain(tree, focused);
+        let mut out: HashSet<NodeId> = chain.first().copied().into_iter().collect();
+        out.extend(chain.iter().filter(|id| tree.shadow_root(**id).is_some()).copied());
+        out
+    }
+    let mut flips = Vec::new();
+    let before_within: HashSet<NodeId> = chain(tree, previous.map(|focus| focus.0)).into_iter().collect();
+    let after_within: HashSet<NodeId> = chain(tree, next.map(|focus| focus.0)).into_iter().collect();
+    for node in before_within.symmetric_difference(&after_within) {
+        flips.push((*node, "focus-within"));
+    }
+    let before_focus = focus_holders(tree, previous.map(|focus| focus.0));
+    let after_focus = focus_holders(tree, next.map(|focus| focus.0));
+    for node in before_focus.symmetric_difference(&after_focus) {
+        flips.push((*node, "focus"));
+    }
+    let visible = |focus: Option<(NodeId, bool)>| focus.filter(|(_, visible)| *visible).map(|(id, _)| id);
+    if visible(previous) != visible(next) {
+        flips.extend(visible(previous).into_iter().chain(visible(next)).map(|id| (id, "focus-visible")));
+    }
+    flips
+}
