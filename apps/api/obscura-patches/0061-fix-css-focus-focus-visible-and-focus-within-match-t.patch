-            // Dynamic user-interaction pseudo-classes have no meaning against
-            // a static DOM snapshot with no live user input.
-            PseudoClass::Hover
-            | PseudoClass::Active
-            | PseudoClass::Focus
-            | PseudoClass::FocusVisible
