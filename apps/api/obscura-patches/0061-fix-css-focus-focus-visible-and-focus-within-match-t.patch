+                        .shadow_root(self.node_id)
+                        .is_some_and(|root| shadow_including_inclusive_ancestor(self.tree, root, focused))
+            }),
+            PseudoClass::FocusVisible => self
+                .tree
+                .focus()
+                .is_some_and(|(focused, visible)| visible && focused == self.node_id),
+            PseudoClass::FocusWithin => self.tree.focus().is_some_and(|(focused, _)| {
+                shadow_including_inclusive_ancestor(self.tree, self.node_id, focused)
+            }),
+            // No pointer is ever over or pressing an element here.
+            PseudoClass::Hover | PseudoClass::Active => false,
