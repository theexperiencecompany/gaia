+/// Moving focus restyles the elements whose :focus, :focus-visible and
+/// :focus-within state flipped, including a shadow host around the focused
+/// element, and matches a full cascade.
+#[test]
+fn retained_focus_moves_match_full() {
+    let mut peers = String::new();
+    for index in 0..CLEAN_PEERS {
+        peers.push_str(&format!("<span class=clean data-index={index}></span>"));
+    }
+    let html = format!(
+        r#"<!doctype html><html><head><style>
+             html,body{{margin:0}} .clean{{display:block;height:1px}}
+             input{{display:block;width:50px}} input:focus{{width:211px}}
+             input:focus-visible{{height:33px}} form:focus-within{{padding-left:7px}}
+             x-field{{display:block}} x-field:focus{{margin-left:9px}}
+           </style></head><body>
+           <form id="one"><input id="a"><input id="b"></form>
+           <form id="two"><x-field id="host"></x-field></form>
+           <div id="source"><input id="inner"></div>
+           <aside id="clean">{peers}</aside>
+           </body></html>"#
+    );
+    let tree = parse_html(&html);
+    let id = |name: &str| tree.get_element_by_id(name).unwrap_or_else(|| panic!("{name}"));
+    let (a, b, host) = (id("a"), id("b"), id("host"));
+    let root = attach(&tree, host, id("source"));
+    let inner = find(&tree, root, "inner");
+    let mut cache = crate::css::StylesheetCache::default();
+
+    let mut moves = [
+        ("focus a by keyboard", Some((a, true))),
+        ("focus b by pointer", Some((b, false))),
+        ("focus inside a shadow host", Some((inner, true))),
+        ("blur", None),
+    ]
+    .into_iter();
+    while let Some((case, next)) = moves.next() {
+        let initial = initial_layout(&tree, &mut cache);
+        let previous = tree.focus();
+        tree.set_focus(next);
+        let mutation = RetainedStyleMutation::Focus { previous, next };
+        finish(case, &tree, &mut cache, initial, &[mutation], COMPONENT_BUDGET);
+    }
+}
