@@ -1824,3 +1836,19 @@ mod tests {
         assert!(!tree.matches_selector(item, "::slotted(.item)").unwrap());
     }
 }
+
+/// Whether `ancestor` is `node` or one of its shadow-including ancestors (a
+/// shadow root's parent is its host).
+fn shadow_including_inclusive_ancestor(tree: &DomTree, ancestor: NodeId, node: NodeId) -> bool {
+    let mut current = Some(node);
+    while let Some(id) = current {
+        if id == ancestor {
+            return true;
+        }
+        current = tree
+            .with_node(id, |n| n.parent)
+            .flatten()
+            .or_else(|| tree.shadow_root_info(id).map(|root| root.host));
+    }
+    false
+}
