         collect(tree, id, split_inlines, styles, &mut pieces);
         let mut line_fragments = inline_fragments.get(&id).cloned().unwrap_or_default();
         if !pieces.iter().any(|piece| matches!(piece, Piece::Block(_))) {
-            // No split: shaping already produced the whole geometry.
+            // No split: shaping produced the whole geometry, unless the run
+            // holding this inline could not fold to shaped text (it holds an
+            // atomic inline such as an <input>) and was laid out box by box.
+            // Then its line fragments are its descendants' boxes, per line.
+            if line_fragments.is_empty() {
+                let fragments =
+                    descendant_line_fragments(tree, id, split_inlines, styles, rects, text_runs);
+                if !fragments.is_empty() {
+                    synthesized.push((id, fragments));
+                }
+            }
             continue;
         }
 
@@ -15741,6 +15828,27 @@ mod tests {
         root
     }
 
+    #[test]
+    fn spliced_inline_around_an_atomic_inline_has_a_box() {
+        // A label wrapping its text and an <input> is spliced out of the box
+        // tree, and its run cannot fold to shaped text (the input is atomic),
+        // so shaping gives it no fragment. Its box is its content's boxes.
+        let tree = parse_html(
+            r#"<style>html,body{margin:0;font:16px/20px sans-serif}</style><p><label id="wrap">Name: <input id="field"></label></p><label id="beside">Plain</label><input><p><span id="shaped">only text</span></p>"#,
+        );
+        let laid = layout_dom(&tree, (1280.0, 720.0));
+        let rect = |id: &str| laid.rects.get(&tree.get_element_by_id(id).unwrap()).copied();
+        let wrap = rect("wrap").expect("label around an input must have a box");
+        let field = rect("field").expect("input box");
+        assert!(wrap.x < field.x, "{wrap:?} starts before {field:?}");
+        assert!(wrap.x + wrap.width >= field.x + field.width - 0.5, "{wrap:?} covers {field:?}");
+        assert!(wrap.height > 0.0, "{wrap:?}");
+        let beside = rect("beside").expect("inline in a run with an input must have a box");
+        assert!(beside.width > 0.0 && beside.height > 0.0, "{beside:?}");
+        let shaped = rect("shaped").expect("shaped inline keeps its box");
+        assert!(shaped.width > 0.0, "{shaped:?}");
+    }
+
