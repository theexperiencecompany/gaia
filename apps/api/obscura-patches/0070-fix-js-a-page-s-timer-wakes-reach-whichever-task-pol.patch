-                runtime.run_event_loop(deno_core::PollEventLoopOptions::default())
-            });
+            let event_loop = std::future::poll_fn(|cx| self.poll_page_event_loop(cx));
             let _ = tokio::time::timeout(
                 tokio::time::Duration::from_millis(tick_ms),
                 event_loop,
@@ -21515,6 +21587,98 @@ mod tests {
         );
     }
 
+    /// Page script queues timers before anything polls the page's event loop
+    /// (see the first poll in `with_base_url_and_proxy`). When the first poll
+    /// finds a timer already due, the timer its callback queues must still
+    /// wake the page: bing.com's US homepage builds its links from such a
+    /// chain off `onload`.
+    #[tokio::test(flavor = "current_thread")]
+    async fn a_timer_queued_by_a_timer_due_at_the_first_poll_wakes_the_page() {
+        let mut rt = setup_runtime("<html><body></body></html>");
+        rt.evaluate(
+            "(function() { \
+                 globalThis.__fired = []; \
+                 setTimeout(() => { \
+                     __fired.push('due'); \
+                     setTimeout(() => __fired.push('queued'), 1); \
+                 }, 0); \
+             })()",
+        )
+        .unwrap();
+        // The first timer falls due before anything polls.
+        tokio::time::sleep(std::time::Duration::from_millis(20)).await;
+        // The deadline is polled first, so its own wake cannot drive the pump.
+        let woken = tokio::select! {
+            biased;
+            _ = tokio::time::sleep(std::time::Duration::from_millis(500)) => false,
+            _ = async {
+                while rt.evaluate("__fired.length === 2").unwrap() != serde_json::json!(true) {
+                    rt.run_autonomous_event_loop_turn().await.unwrap();
+                }
+            } => true,
+        };
+        assert!(
+            woken,
+            "the queued timer never woke the page: {}",
+            rt.evaluate("__fired.join()").unwrap()
+        );
+    }
+
+    /// The CDP server navigates a page in one task and pumps it from another
+    /// (see `EventLoopWaker`). A timer that falls due across that handoff is
+    /// fired by the new task, and the timer its callback queues must wake the
+    /// new task, not the finished one.
+    #[tokio::test(flavor = "current_thread")]
+    async fn a_timer_queued_after_the_polling_task_changes_still_wakes_the_page() {
+        let local = tokio::task::LocalSet::new();
+        local
+            .run_until(async {
+                let mut rt = setup_runtime("<html><body></body></html>");
+                rt.evaluate(
+                    "(function() { \
+                         globalThis.__fired = []; \
+                         setTimeout(() => { \
+                             __fired.push('due'); \
+                             setTimeout(() => __fired.push('queued'), 1); \
+                         }, 5); \
+                     })()",
+                )
+                .unwrap();
+                // The first owner polls once, so the timer sleep stores its
+                // waker, then finishes, as a navigation task does.
+                let mut rt = tokio::task::spawn_local(async move {
+                    let _ = tokio::time::timeout(
+                        std::time::Duration::from_millis(1),
+                        rt.run_autonomous_event_loop_turn(),
+                    )
+                    .await;
+                    rt
+                })
+                .await
+                .unwrap();
+                // The first timer falls due while no task is polling.
+                tokio::time::sleep(std::time::Duration::from_millis(20)).await;
+                // This task takes over, as the connection pump does, and must
+                // be woken for the timer the due one queues. The deadline is
+                // polled first, so its own wake cannot drive the pump.
+                let woken = tokio::select! {
+                    biased;
+                    _ = tokio::time::sleep(std::time::Duration::from_millis(500)) => false,
+                    _ = async {
+                        while rt.evaluate("__fired.length === 2").unwrap() != serde_json::json!(true) {
+                            rt.run_autonomous_event_loop_turn().await.unwrap();
+                        }
+                    } => true,
+                };
+                assert!(
+                    woken,
+                    "the queued timer never woke the new polling task: {}",
+                    rt.evaluate("__fired.join()").unwrap()
+                );
+            })
+            .await;
+    }
+
