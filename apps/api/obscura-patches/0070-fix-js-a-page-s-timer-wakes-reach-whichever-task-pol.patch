     /// their shims can call ops; nothing else can reach it, including page
     /// script.
     ops_handoff: Option<deno_core::v8::Global<deno_core::v8::Value>>,
+    /// Every poll of `js_runtime`'s event loop goes through this; see
+    /// `EventLoopWaker`.
+    event_loop_waker: EventLoopWaker,
     // Keep the runtime last: custom `Drop` enters its isolate, then every
     // V8-backed field above is released before `OwnedIsolate` performs the
     // matching exit and disposes the isolate.
@@ -373,6 +376,57 @@ const WATCHDOG_SCHEDULING_MARGIN_MS: u64 = 500;
 /// many pages exist or what order they are used and dropped in.
 struct EnteredRuntime<'a>(&'a mut JsRuntime);
 
+/// The waker deno_core is polled with. It forwards to whichever task polls
+/// the page's event loop now.
+///
+/// deno_core's timer queue wakes the waker it took from the last poll that
+/// found no timer due; a poll that finds one due fires it and takes nothing.
+/// deno_core assumes one task owns the event loop for life, but Obscura polls
+/// a page from more than one: the CDP server runs a navigation in a task of
+/// its own, then pumps the page from its connection task between commands. A
+/// timer queued after that handoff woke the finished navigation task (or
+/// nobody, if no poll had found the queue idle yet), and the page sat frozen
+/// until the next protocol command. bing.com's US homepage builds its links
+/// from a timer chain started by `onload` and stayed blank. With this one
+/// stable waker, a wake deno_core stored at any time reaches the current
+/// owner.
+struct EventLoopWaker {
+    owner: std::sync::Arc<EventLoopOwner>,
+    waker: std::task::Waker,
+}
+
+struct EventLoopOwner(std::sync::Mutex<Option<std::task::Waker>>);
+
+impl std::task::Wake for EventLoopOwner {
+    fn wake(self: std::sync::Arc<Self>) {
+        self.wake_by_ref();
+    }
+
+    fn wake_by_ref(self: &std::sync::Arc<Self>) {
+        if let Some(waker) = self.0.lock().expect("event loop owner lock").as_ref() {
+            waker.wake_by_ref();
+        }
+    }
+}
+
+impl EventLoopWaker {
+    fn new() -> Self {
+        let owner = std::sync::Arc::new(EventLoopOwner(std::sync::Mutex::new(None)));
+        let waker = std::task::Waker::from(owner.clone());
+        Self { owner, waker }
+    }
+
+    /// Make the task behind `cx` the one deno_core's wakes reach, and return
+    /// the waker to poll deno_core with.
+    fn adopt(&self, cx: &Context<'_>) -> std::task::Waker {
+        let mut current = self.owner.0.lock().expect("event loop owner lock");
+        if !current.as_ref().is_some_and(|waker| waker.will_wake(cx.waker())) {
+            *current = Some(cx.waker().clone());
+        }
+        self.waker.clone()
+    }
+}
+
 /// Enters an isolate only while an async deno_core operation is being polled.
 /// Holding an entry across `.await` would let interleaved page futures violate
 /// V8's per-thread isolate stack.
@@ -502,6 +556,21 @@ impl ObscuraJsRuntime {
         EnteredRuntime(&mut self.js_runtime)
     }
 
+    /// One poll of deno_core's event loop on behalf of the task behind `cx`.
+    /// Nothing polls `js_runtime`'s event loop any other way: a poll with the
+    /// caller's own waker would leave that waker in deno_core's timer queue
+    /// after the caller's task has gone (see `EventLoopWaker`).
+    fn poll_page_event_loop(
+        &mut self,
+        cx: &mut Context<'_>,
+    ) -> Poll<Result<(), deno_core::error::CoreError>> {
+        let waker = self.event_loop_waker.adopt(cx);
+        self.runtime().poll_event_loop(
+            &mut Context::from_waker(&waker),
+            deno_core::PollEventLoopOptions::default(),
+        )
+    }
+
     /// Freeze the document timeline for one JavaScript task. Browser timelines
     /// update at task/rendering boundaries, not on each forced style or layout
     /// read. Keeping one sample across the task also lets repeated CSSOM reads
@@ -608,6 +677,7 @@ impl ObscuraJsRuntime {
             loaded_module_specifiers,
             evaluated_module_specifiers: HashMap::new(),
             ops_handoff: None,
+            event_loop_waker: EventLoopWaker::new(),
             js_runtime: runtime,
         };
         // Take the op table before any page script can run, and drop the global
@@ -624,6 +694,19 @@ impl ObscuraJsRuntime {
             instance.js_runtime.v8_isolate().exit();
         }
 
+        // deno_core's timer queue takes a waker only from a poll that finds no
+        // timer due (see `EventLoopWaker`). Page script queues timers before
+        // the page's event loop is first polled; when one is already due by
+        // then, that first poll fires it without taking a waker, and every
+        // later timer falls due with nobody to wake. Poll once now, while
+        // nothing is queued, so the queue holds the forwarding waker from the
+        // start.
+        if let Poll::Ready(Err(error)) =
+            instance.poll_page_event_loop(&mut Context::from_waker(std::task::Waker::noop()))
+        {
+            panic!("a fresh page's event loop failed its first poll: {error}");
+        }
+
         instance
     }
 
@@ -2635,8 +2718,7 @@ impl ObscuraJsRuntime {
         let outcome = tokio::time::timeout(
             budget,
