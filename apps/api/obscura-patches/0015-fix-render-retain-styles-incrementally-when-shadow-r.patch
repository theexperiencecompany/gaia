+    );
+
+    let initial = initial_layout(&f.tree, &mut cache);
+    f.tree.remove_child(deep);
+    finish(
+        "shadow remove",
+        &f.tree,
+        &mut cache,
+        initial,
+        &[TreeStyleMutation::Remove {
+            node: deep,
+            old_parent: inner,
+        }
