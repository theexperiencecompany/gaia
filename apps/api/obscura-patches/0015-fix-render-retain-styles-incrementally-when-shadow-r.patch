+//! Retained (incremental) restyle in documents whose shadow roots carry
+//! stylesheets. Every case compares the incremental result with a forced full
+//! cascade of the same final tree, and checks that only the damaged component
+//! was re-cascaded.
+
+use super::*;
+use obscura_dom::tree::{NodeData, ShadowRootMode};
+use obscura_dom::tree_sink::parse_html;
+
+const VIEWPORT: (f32, f32) = (640.0, 480.0);
+const CLEAN_PEERS: usize = 2_000;
+
+const SHADOW_CSS: &str = r#"
+    :host { display:block; padding-left:3px }
+    :host(.active) { width:211px; color:#0a0b0c }
+    :host(.active) .inner { height:17px }
+    .inner { width:var(--accent); height:9px }
+    .inner.on { width:44px; color:#445566; --accent:13px }
+    .wrap.lit ::slotted(*) { margin-left:6px }
+    ::slotted(.item) { display:block; height:7px }
+    ::slotted(.hot) { width:77px; font-size:19px }
+    ::slotted(:first-child) { padding-top:2px }
+    slot { color:#778899 }
+    slot[name=other] { font-weight:700 }
+    b { display:block; width:var(--accent) }
+    .inner > b:first-child { margin-top:4px }
+"#;
+
+struct Fixture {
+    tree: DomTree,
+    host: NodeId,
+    other: NodeId,
+    root: NodeId,
+    other_source: NodeId,
+    /// A detached `<style>` ready to be inserted into a shadow root.
+    spare_style: NodeId,
+}
+
+fn attach(tree: &DomTree, host: NodeId, source: NodeId) -> NodeId {
+    let root = tree
+        .attach_shadow_root(host, ShadowRootMode::Open)
+        .expect("attach native shadow root");
+    for child in tree.children(source) {
+        tree.append_child(root, child);
+    }
+    tree.remove(source);
+    root
+}
+
+/// Two component instances plus a large clean light-DOM branch. The second
+/// host's shadow root is attached unless `defer_other` is set.
+fn fixture(defer_other: bool) -> Fixture {
+    let mut peers = String::new();
+    for index in 0..CLEAN_PEERS {
+        peers.push_str(&format!("<span class=clean data-index={index}></span>"));
+    }
+    let component = |suffix: &str| {
+        format!(
+            r#"<style>{SHADOW_CSS}</style>
+               <div id="wrap{suffix}" class="wrap">
+                 <slot id="title-slot{suffix}" name="title"></slot>
+                 <div id="inner{suffix}" class="inner"><b id="deep{suffix}">deep</b><b id="extra{suffix}">extra</b></div>
+                 <slot id="default-slot{suffix}"></slot>
+               </div>"#
+        )
+    };
+    let html = format!(
+        r#"<!doctype html><html><head><style>
+             html,body{{margin:0}}
+             x-card{{display:block}}
+             .clean{{display:block;height:1px}}
+             .item{{color:#102030}}
+           </style></head><body>
+           <x-card id="host" class="card" style="color:#010203;--accent:5px">
+             <span id="slotted" class="item" slot="title">title</span>
+             <span id="plain" class="item">body</span>
+             <span id="late" class="item">late</span>
+           </x-card>
+           <x-card id="other" class="card"><span id="other-slotted" class="item" slot="title">t</span></x-card>
+           <div id="source">{}</div>
+           <div id="source-other">{}</div>
+           <aside id="clean">{peers}</aside>
+           <div id="spare"><style id="spare-style">b {{ height:12px }} :host {{ border-left:4px solid }}</style></div>
+           </body></html>"#,
+        component(""),
+        component("-o"),
+    );
+    let tree = parse_html(&html);
+    let id = |name: &str| tree.get_element_by_id(name).unwrap_or_else(|| panic!("{name}"));
+    let host = id("host");
+    let other = id("other");
+    let source = id("source");
+    let other_source = id("source-other");
+    let spare = id("spare");
+    let spare_style = id("spare-style");
+    tree.remove_child(spare_style);
+    tree.remove(spare);
+    let root = attach(&tree, host, source);
+    if defer_other {
+        // Built off-document, as a component constructs its shadow content.
+        tree.remove_child(other_source);
+    } else {
+        attach(&tree, other, other_source);
+    }
+    Fixture {
+        tree,
+        host,
+        other,
+        root,
+        other_source,
+        spare_style,
+    }
+}
+
+fn find(tree: &DomTree, root: NodeId, id: &str) -> NodeId {
+    tree.descendants(root)
+        .into_iter()
+        .find(|node| {
+            tree.get_node(*node)
+                .is_some_and(|node| node.get_attribute("id") == Some(id))
+        })
+        .unwrap_or_else(|| panic!("shadow node {id}"))
+}
+
+fn initial_layout(tree: &DomTree, cache: &mut crate::css::StylesheetCache) -> DomLayout {
+    layout_dom_with_web_fonts_and_stylesheet_cache(tree, VIEWPORT, &HashMap::new(), &[], cache)
+}
+
+fn assert_styles_match(case: &str, tree: &DomTree, incremental: &DomLayout, full: &DomLayout) {
+    assert_eq!(
+        incremental.styles.keys().collect::<HashSet<_>>(),
+        full.styles.keys().collect::<HashSet<_>>(),
+        "{case}: computed-style node set"
+    );
+    for (node, style) in &incremental.styles {
+        assert_eq!(
+            format!("{style:#?}"),
+            format!("{:#?}", full.styles[node]),
+            "{case}: computed style for {node:?} {:?} (id={:?} parent={:?})",
+            tree.get_node(*node).and_then(|node| node.as_element().map(|element| element.local.to_string())),
+            tree.get_node(*node).and_then(|node| node.get_attribute("id").map(str::to_owned)),
+            tree.get_node(*node).and_then(|node| node.parent),
+        );
+    }
+    assert_eq!(incremental.rects, full.rects, "{case}: border boxes");
+    assert_eq!(
+        incremental.inline_fragments, full.inline_fragments,
+        "{case}: inline fragments"
+    );
+    assert_eq!(incremental.text_runs, full.text_runs, "{case}: text runs");
+    assert_eq!(
+        incremental.custom_properties, full.custom_properties,
+        "{case}: custom properties"
+    );
+}
+
+/// Run the retained restyle for `mutations` over `initial`, compare it with a
+/// full cascade, and require that it stayed incremental and local.
+fn finish(
+    case: &str,
+    tree: &DomTree,
+    cache: &mut crate::css::StylesheetCache,
+    mut initial: DomLayout,
+    mutations: &[RetainedStyleMutation],
+    max_fresh: usize,
+) -> ContainerLayoutTelemetry {
+    let retained = RetainedStyleMaps {
+        styles: std::mem::take(&mut initial.styles),
+        custom_properties: std::mem::take(&mut initial.custom_properties),
+    };
+    let (incremental, telemetry) = layout_dom_with_web_fonts_pass_limit(
+        tree,
+        VIEWPORT,
+        &HashMap::new(),
+        &[],
+        None,
+        Some(cache),
+        Some(retained),
+        mutations,
+    );
+    let full = layout_dom(tree, VIEWPORT);
+    assert_styles_match(case, tree, &incremental, &full);
+    assert_eq!(telemetry.retained_fallback, 0, "{case}: {telemetry:?}");
+    assert!(
+        telemetry.retained_reused >= CLEAN_PEERS,
+        "{case}: clean branch must be reused {telemetry:?}"
+    );
+    assert!(
+        telemetry.retained_fresh <= max_fresh,
+        "{case}: restyle must stay inside the damaged component {telemetry:?}"
+    );
+    telemetry
+}
+
+fn attribute(tree: &DomTree, node: NodeId, name: &str, value: &str) -> RetainedStyleMutation {
+    let old_value = tree
+        .get_node(node)
+        .and_then(|node| node.get_attribute(name).map(str::to_owned));
+    tree.with_node_mut(node, |node| node.set_attribute(name, value.into()));
+    AttributeStyleMutation {
+        node,
+        name: name.into(),
+        old_value,
+        new_value: Some(value.to_owned()),
+    }
+    .into()
+}
+
+/// One component's worth of nodes: host, its light children, and its shadow
+/// tree, plus the ancestor chain. Anything near the whole document means the
+/// retained path lost locality.
+const COMPONENT_BUDGET: usize = 40;
+
+#[test]
+fn retained_shadow_tree_attribute_matches_full() {
+    let f = fixture(false);
+    let mut cache = crate::css::StylesheetCache::default();
+    let initial = initial_layout(&f.tree, &mut cache);
+    let inner = find(&f.tree, f.root, "inner");
+    let mutation = attribute(&f.tree, inner, "class", "inner on");
+    finish("shadow class", &f.tree, &mut cache, initial, &[mutation], COMPONENT_BUDGET);
+}
