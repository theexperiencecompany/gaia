+    let extra = find(&f.tree, f.root, "extra");
+    f.tree.remove_child(deep);
+    let mut cache = crate::css::StylesheetCache::default();
+    let initial = initial_layout(&f.tree, &mut cache);
+    // Reinserting before `extra` moves :first-child between the two <b>.
+    f.tree.insert_before(extra, deep);
+    let mutation = TreeStyleMutation::Insert {
+        node: deep,
