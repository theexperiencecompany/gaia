+/// The author sheet whose ordinary rules match nodes in `node`'s tree scope.
+fn scope_sheet<'a>(
+    tree: &DomTree,
+    node: NodeId,
+    document_sheet: &'a crate::css::Stylesheet,
+    shadow_sheets: &'a HashMap<NodeId, std::sync::Arc<crate::css::Stylesheet>>,
+) -> &'a crate::css::Stylesheet {
+    tree.containing_shadow_root(node)
+        .and_then(|root| shadow_sheets.get(&root))
+        .map_or(document_sheet, |sheet| &**sheet)
+}
+
+fn push_sheet<'a>(sheets: &mut Vec<&'a crate::css::Stylesheet>, sheet: &'a crate::css::Stylesheet) {
+    if !sheets.iter().any(|known| std::ptr::eq(*known, sheet)) {
+        sheets.push(sheet);
+    }
+}
+
+/// Sheets that can select `node` as a subject: its own scope's sheet, its
+/// ShadowRoot's sheet when it is a host (`:host`), and the sheet of every
+/// scope it is slotted into (`::slotted()`, following nested slot chains).
+fn subject_sheets<'a>(
+    tree: &DomTree,
+    node: NodeId,
+    document_sheet: &'a crate::css::Stylesheet,
+    shadow_sheets: &'a HashMap<NodeId, std::sync::Arc<crate::css::Stylesheet>>,
+) -> Vec<&'a crate::css::Stylesheet> {
+    let mut sheets = vec![scope_sheet(tree, node, document_sheet, shadow_sheets)];
+    if shadow_sheets.is_empty() {
+        return sheets;
+    }
+    if let Some(sheet) = tree.shadow_root(node).and_then(|root| shadow_sheets.get(&root)) {
+        push_sheet(&mut sheets, sheet);
+    }
+    add_slot_chain_sheets(tree, node, shadow_sheets, &mut sheets);
+    sheets
+}
+
+fn add_slot_chain_sheets<'a>(
+    tree: &DomTree,
+    node: NodeId,
+    shadow_sheets: &'a HashMap<NodeId, std::sync::Arc<crate::css::Stylesheet>>,
+    sheets: &mut Vec<&'a crate::css::Stylesheet>,
+) {
+    let mut slot = tree.assigned_slot(node);
+    for _ in 0..tree.len() {
+        let Some(current) = slot else { break };
+        if let Some(sheet) = tree
+            .containing_shadow_root(current)
+            .and_then(|root| shadow_sheets.get(&root))
+        {
+            push_sheet(sheets, sheet);
+        }
+        slot = tree.assigned_slot(current);
+    }
+}
+
+/// Sheets whose selectors can observe the child list of `parent`: every sheet
+/// that can select `parent` itself, plus, when `parent` is a host, every
+/// scope its children are slotted into (`::slotted(:first-child)` and the
+/// like are evaluated against the host's light child list).
+fn child_list_sheets<'a>(
+    tree: &DomTree,
+    parent: NodeId,
+    document_sheet: &'a crate::css::Stylesheet,
+    shadow_sheets: &'a HashMap<NodeId, std::sync::Arc<crate::css::Stylesheet>>,
+) -> Vec<&'a crate::css::Stylesheet> {
+    let mut sheets = subject_sheets(tree, parent, document_sheet, shadow_sheets);
+    if let Some(root) = tree.shadow_root(parent) {
+        for slot in tree.descendants(root) {
+            if tree.is_html_slot_element(slot) {
+                if let Some(sheet) = shadow_sheets.get(&root) {
+                    push_sheet(&mut sheets, sheet);
+                }
+                add_slot_chain_sheets(tree, slot, shadow_sheets, &mut sheets);
+            }
+        }
+    }
+    sheets
+}
+
+fn subtree_contains_slot_element(tree: &DomTree, root: NodeId) -> bool {
+    std::iter::once(root)
+        .chain(tree.descendants(root))
+        .any(|id| tree.is_html_slot_element(id))
+}
+
+/// A slot entering or leaving a shadow tree reassigns the host's light
+/// children, which changes their inheritance parent and `::slotted()` rules.
+fn add_slot_reassignment_scope(
+    tree: &DomTree,
+    node: NodeId,
+    parent: Option<NodeId>,
+    dirty: &mut HashSet<NodeId>,
+) {
+    let Some(host) = parent
+        .and_then(|parent| tree.containing_shadow_root(parent))
+        .and_then(|root| tree.shadow_root_info(root))
+        .map(|info| info.host)
+    else {
+        return;
+    };
+    if subtree_contains_slot_element(tree, node) {
+        add_style_subtree(tree, host, dirty);
+    }
+}
