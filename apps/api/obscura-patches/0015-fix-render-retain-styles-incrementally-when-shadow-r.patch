+    enum Work {
+        Visit(NodeId),
+        Pop,
+    }
+    let mut dirty = HashSet::new();
+    let mut matcher = tree.matcher();
+    let mut work = vec![Work::Visit(tree.document())];
+    while let Some(item) = work.pop() {
+        match item {
+            Work::Pop => matcher.pop_ancestor(),
+            Work::Visit(id) => {
+                let is_element = tree.get_node(id).is_some_and(|node| node.is_element());
+                if is_element && sheet.node_matches_container_query_rule(tree, &mut matcher, id) {
+                    add_style_subtree(tree, id, &mut dirty);
+                }
+                if is_element {
+                    matcher.push_ancestor(tree, id);
+                    work.push(Work::Pop);
+                }
+                for child in tree.children(id).into_iter().rev() {
+                    work.push(Work::Visit(child));
+                }
+            }
+        }
+    }
+    dirty
+}
