+/// Container-query passes after the first reuse every style no conditional
+/// rule selects. The result must equal re-cascading the whole document on
+/// every pass, including multi-pass activation chains, pseudo-elements,
+/// inherited values and custom properties set under a condition, and a
+/// shadow host in the tree.
+#[test]
+fn container_query_passes_reuse_unconditional_styles_and_match_full_passes() {
+    let mut chain_css = String::from("#c0{container:c0/inline-size;width:300px}");
+    for level in 0..4 {
+        chain_css.push_str(&format!(
+            "@container c{level} (min-width:100px){{#c{}{{container:c{}/inline-size;width:{}px}}}}",
+            level + 1,
+            level + 1,
+            280 - level * 20,
+        ));
+    }
+    chain_css.push_str("@container c4 (min-width:100px){#chain-target{width:77px;color:#0000ff}}");
+    let mut chain = String::new();
+    for level in 0..=4 {
+        chain.push_str(&format!("<div id=\"c{level}\">"));
+    }
+    chain.push_str("<div id=\"chain-target\"><span>inherits</span></div>");
+    for _ in 0..=4 {
+        chain.push_str("</div>");
+    }
+    let mut peers = String::new();
+    for index in 0..300 {
+        peers.push_str(&format!("<p class=peer>peer {index}</p>"));
+    }
+    let tree = parse_html(&format!(
+        r#"<!doctype html><style>
+             body{{margin:0}}
+             .card{{container-type:inline-size;width:320px}}
+             .narrow{{container-type:inline-size;width:120px}}
+             .title{{font-size:12px}}
+             @container (min-width:200px){{
+               .title{{font-size:24px;color:#aa0000;--gap:9px}}
+               .title::before{{content:"wide ";color:#00aa00}}
+               .title + .body{{margin-top:var(--gap, 1px)}}
+             }}
+             @container (max-width:199px){{ .title{{letter-spacing:2px}} }}
+             .body{{padding-left:var(--gap, 3px)}}
+             .peer{{margin:0;height:4px}}
+             {chain_css}
+           </style>
+           <div class="card"><h2 class="title">Wide <b>inner</b></h2><div class="body">text</div></div>
+           <div class="narrow"><h2 class="title">Narrow</h2><div class="body">text</div></div>
+           <x-card id="host"><span class="title" slot="s">slotted</span></x-card>
+           <div id="source"><style>:host{{display:block}} slot{{color:#123123}}</style><div class="card"><slot name="s"></slot></div></div>
+           {chain}
+           <section>{peers}</section>"#
+    ));
+    let host = tree.get_element_by_id("host").unwrap();
+    let source = tree.get_element_by_id("source").unwrap();
+    attach(&tree, host, source);
+
+    let (incremental, incremental_telemetry) = layout_with_container_passes(&tree, false);
+    let (full, full_telemetry) = layout_with_container_passes(&tree, true);
+    assert_styles_match("container passes", &tree, &incremental, &full);
+    assert_eq!(incremental_telemetry.passes, full_telemetry.passes);
+    assert_eq!(incremental_telemetry.termination, full_telemetry.termination);
+    assert!(incremental_telemetry.passes >= 5, "{incremental_telemetry:?}");
+    let target = tree.get_element_by_id("chain-target").unwrap();
+    assert_eq!(incremental.styles[&target].width, crate::Dimension::Px(77.0));
+
+    // The same must hold after a retained restyle of the document.
+    let mut cache = crate::css::StylesheetCache::default();
+    let mut initial = initial_layout(&tree, &mut cache);
+    let wide_title = tree
+        .descendants(tree.document())
+        .into_iter()
+        .find(|node| {
+            tree.get_node(*node)
+                .is_some_and(|node| node.get_attribute("class") == Some("title"))
+        })
+        .unwrap();
+    let mutation = attribute(&tree, wide_title, "class", "title hot");
+    let retained = RetainedStyleMaps {
+        styles: std::mem::take(&mut initial.styles),
+        custom_properties: std::mem::take(&mut initial.custom_properties),
+    };
+    let (retained_layout, telemetry) = layout_dom_with_web_fonts_pass_limit(
+        &tree,
+        VIEWPORT,
+        &HashMap::new(),
+        &[],
+        None,
+        Some(&mut cache),
+        Some(retained),
+        &[mutation],
+    );
+    let (full, _) = layout_with_container_passes(&tree, true);
+    assert_eq!(telemetry.retained_fallback, 0, "{telemetry:?}");
+    assert_styles_match("retained container passes", &tree, &retained_layout, &full);
+}
