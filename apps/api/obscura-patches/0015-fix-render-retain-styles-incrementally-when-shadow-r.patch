+/// Cost: with many styled components, a mutation inside one of them
+/// re-cascades that component only.
+#[test]
+fn retained_shadow_mutation_restyles_only_its_component() {
+    let mut peers = String::new();
+    for index in 0..CLEAN_PEERS {
+        peers.push_str(&format!("<span class=clean data-index={index}></span>"));
+    }
+    let mut hosts = String::new();
+    let mut sources = String::new();
+    for index in 0..30 {
+        hosts.push_str(&format!(
+            r#"<x-card id="host-{index}"><span slot="title">t{index}</span></x-card>"#
+        ));
+        sources.push_str(&format!(
+            r#"<div id="source-{index}"><style>{SHADOW_CSS}</style>
+               <div class="wrap"><slot name="title"></slot>
+               <div id="inner-{index}" class="inner"><b>a</b><b>b</b></div></div></div>"#
+        ));
+    }
+    let tree = parse_html(&format!(
+        r#"<!doctype html><style>.clean{{display:block;height:1px}}</style>
+           <main>{hosts}</main>{sources}<aside>{peers}</aside>"#
+    ));
+    let mut roots = Vec::new();
+    for index in 0..30 {
+        let host = tree.get_element_by_id(&format!("host-{index}")).unwrap();
+        let source = tree.get_element_by_id(&format!("source-{index}")).unwrap();
+        roots.push(attach(&tree, host, source));
+    }
+    let mut cache = crate::css::StylesheetCache::default();
+    let initial = initial_layout(&tree, &mut cache);
+    let inner = find(&tree, roots[17], "inner-17");
+    let mutation = attribute(&tree, inner, "class", "inner on");
+    let telemetry = finish(
+        "one of thirty components",
+        &tree,
+        &mut cache,
+        initial,
+        &[mutation],
+        COMPONENT_BUDGET,
+    );
+    // Thirty components of ~9 styled nodes each plus the clean branch.
+    assert!(
+        telemetry.retained_reused >= CLEAN_PEERS + 29 * 8,
+        "{telemetry:?}"
+    );
+}
