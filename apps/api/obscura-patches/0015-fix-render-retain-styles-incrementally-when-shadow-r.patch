+fn layout_with_container_passes(tree: &DomTree, force_full: bool) -> (DomLayout, ContainerLayoutTelemetry) {
+    FORCE_FULL_CONTAINER_PASSES.with(|force| force.set(force_full));
+    let result = layout_dom_with_web_fonts_measured(tree, VIEWPORT, &HashMap::new(), &[]);
+    FORCE_FULL_CONTAINER_PASSES.with(|force| force.set(false));
+    result
+}
