+/// Children of `id` for style invalidation, over every edge the cascade
+/// walks: its light children, the children of its ShadowRoot when it is a
+/// host, and its assigned nodes when it is a slot. A slotted node therefore appears under both its light
+/// parent (the host) and its slot; both edges can carry style damage (the
+/// host through the document cascade, the slot through inheritance and
+/// `::slotted()`), so invalidation follows both.
+fn invalidation_children(tree: &DomTree, id: NodeId) -> Vec<NodeId> {
+    let mut children = tree.children(id);
+    if let Some(root) = tree.shadow_root(id) {
+        children.extend(tree.children(root));
+    }
+    if let Some(assigned) = tree.assigned_nodes(id) {
+        children.extend(assigned);
+    }
+    children
+}
+
+/// Every node below `root` in the style tree, crossing into shadow trees and
+/// from slots to their assigned nodes. Unlike `DomTree::descendants`, which
+/// stays inside one tree scope, this reaches every node whose computed style
+/// can inherit from `root`.
+fn style_descendants(tree: &DomTree, root: NodeId) -> Vec<NodeId> {
+    let mut result = Vec::new();
+    let mut visited = HashSet::new();
+    visited.insert(root);
+    let mut stack = invalidation_children(tree, root);
+    stack.reverse();
+    while let Some(id) = stack.pop() {
+        if !visited.insert(id) {
+            continue;
+        }
+        result.push(id);
+        let children = invalidation_children(tree, id);
+        stack.extend(children.into_iter().rev());
+    }
+    result
+}
+
+/// Every node above `node` in the style tree: its light ancestors, the host of
+/// each ShadowRoot on the way up (and that host's ancestors), and for a
+/// slotted node its slot chain and the slots' own ancestors.
+fn style_ancestors(tree: &DomTree, node: NodeId) -> Vec<NodeId> {
+    let mut result = Vec::new();
+    let mut visited = HashSet::new();
+    visited.insert(node);
+    let mut stack = vec![node];
+    while let Some(id) = stack.pop() {
+        let mut parents = Vec::with_capacity(3);
+        if let Some(parent) = tree.get_node(id).and_then(|node| node.parent) {
+            parents.push(parent);
+            if let Some(info) = tree.shadow_root_info(parent) {
+                parents.push(info.host);
+            } else if tree.shadow_root(parent).is_some() {
+                if let Some(slot) = tree.assigned_slot(id) {
+                    parents.push(slot);
+                }
+            }
+        } else if let Some(info) = tree.shadow_root_info(id) {
+            parents.push(info.host);
+        }
+        for parent in parents {
+            if visited.insert(parent) {
+                result.push(parent);
+                stack.push(parent);
+            }
+        }
+    }
+    result
+}
