+  y = Number(y);
+  if (!isFinite(x) || !isFinite(y)) return [];
+  const doc = scope.nodeType === 9 ? scope : scope.ownerDocument;
+  if (!doc) return [];
+  const w = (typeof window !== 'undefined' && window.innerWidth) || 1280;
+  const h = (typeof window !== 'undefined' && window.innerHeight) || 720;
