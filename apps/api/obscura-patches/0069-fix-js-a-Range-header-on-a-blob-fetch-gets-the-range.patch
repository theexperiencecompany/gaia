From c7b3ce840f927a60ca99ee7052ae665a007eecc8 Mon Sep 17 00:00:00 2001
From: gaia <build@heygaia.io>
Date: Fri, 2 Oct 2026 11:50:34 +0530
Subject: [PATCH] fix(js): a Range header on a blob: fetch gets the range, as
 in Chrome

The blob: fetch path passed only the method, so fetch(blobURL, {headers:
{Range}}) answered 200 with the whole Blob. It now reads the Range header
as Chrome's HttpUtil::ParseRangeHeader and HttpByteRange::ComputeBounds
do. One satisfiable range is 206 with Content-Range and the range's
Content-Length. More than one range, or one starting past the end, is a
network error. A header that does not parse, names no range, or names an
invalid one is ignored (200 with the whole Blob). Specs are trimmed of
spaces and tabs and empty ones dropped ("bytes=0-1," is one range).
Positions are signed 64-bit integers ("+2" and a last position of "-0"
parse; one that overflows int64 makes the header unparseable), compared as
BigInts so large values are never rounded. A suffix range is always
served, so on an empty Blob it is 206 "bytes 0--1/0". All 72 headers
tried against headless Chrome (on a 10-byte and an empty Blob) agree;
24 of them are in the test.

Claude-Session: https://claude.ai/code/session_01Tm2SNEJ42hMPiZ6cFb8Vih
---
 crates/obscura-js/js/bootstrap.js | 82 ++++++++++++++++++++++++++++---
 crates/obscura-js/src/runtime.rs  | 61 +++++++++++++++++++++++
 2 files changed, 136 insertions(+), 7 deletions(-)

diff --git a/crates/obscura-js/js/bootstrap.js b/crates/obscura-js/js/bootstrap.js
index fbb60d1..74f1396 100644
--- a/crates/obscura-js/js/bootstrap.js
+++ b/crates/obscura-js/js/bootstrap.js
@@ -8047,9 +8047,6 @@ globalThis.fetch = async (input, init = {}) => {
   // whether the input is absolute. _resolveUrl leaves absolute URLs
   // unchanged and keeps unparseable input as-is.
   url = _resolveUrl(url);
-  if (url.startsWith('blob:')) {
-    return _fetchObjectUrl(url, String(init.method || (request ? request.method : "GET")).toUpperCase());
-  }
   // Normalize the method to uppercase, matching the Request constructor, so
   // fetch(url, {method:"delete"}) and new Request(url, {method:"delete"}) agree
   // and lowercase standard methods are not rejected by the case-sensitive CORS
@@ -8057,6 +8054,10 @@ globalThis.fetch = async (input, init = {}) => {
   const method = String(init.method || (request ? request.method : "GET")).toUpperCase();
   const headers = init.headers !== undefined ? init.headers : (request ? request.headers : undefined);
   let _h = headers instanceof Headers ? Object.fromEntries(headers.entries()) : (headers || {});
+  if (url.startsWith('blob:')) {
+    const rangeName = Object.keys(_h).find(name => name.toLowerCase() === 'range');
+    return _fetchObjectUrl(url, method, rangeName === undefined ? null : String(_h[rangeName]));
+  }
   const inheritsRequestBody = init.body === undefined && request !== null;
   const initBody = init.body !== undefined
     ? init.body
@@ -14829,13 +14830,80 @@ function _objectUrlText(url) {
 // Fetch's scheme fetch for blob: URLs: the Blob this page's object URL names,
 // as a 200 response typed by the Blob, without touching the network. Only GET
 // reads a blob URL; anything else, or a URL this page did not mint, is a
-// network error.
-function _fetchObjectUrl(url, method) {
+// network error. A Range header asks for one byte range, answered with 206
+// and Content-Range as Chrome answers it.
+function _fetchObjectUrl(url, method, range) {
   const blob = _objectUrls.get(url.split('#')[0]);
   if (!blob || method !== 'GET') return Promise.reject(new TypeError('Failed to fetch'));
-  const headers = { 'Content-Length': String(blob.size) };
+  const headers = {};
   if (blob.type) headers['Content-Type'] = blob.type;
-  return Promise.resolve(new Response(blob._bytes.slice(), { status: 200, statusText: 'OK', headers, url }));
+  const span = range === null ? null : _blobByteRange(range, blob.size);
+  if (span === 'unsatisfiable') return Promise.reject(new TypeError('Failed to fetch'));
+  if (span === null) {
+    headers['Content-Length'] = String(blob.size);
+    return Promise.resolve(new Response(blob._bytes.slice(), { status: 200, statusText: 'OK', headers, url }));
+  }
+  const [first, last] = span;
+  headers['Content-Length'] = String(last - first + 1);
+  headers['Content-Range'] = 'bytes ' + first + '-' + last + '/' + blob.size;
+  return Promise.resolve(new Response(blob._bytes.slice(first, last + 1),
+    { status: 206, statusText: 'Partial Content', headers, url }));
+}
+// A Range header against a blob of `size` bytes, read as Chrome's
+// HttpUtil::ParseRangeHeader and HttpByteRange::ComputeBounds read it:
+// - after "bytes =", comma-separated specs, each trimmed of spaces and tabs,
+//   where an empty spec is dropped ("bytes=0-1," is one range);
+// - each position is a 64-bit integer with an optional sign ("+2", and "-0"
+//   as a last position); one that does not fit makes the header unparseable,
+//   so values are compared as BigInts, never rounded to a double;
+// - a header that does not parse, names no range, or names an invalid one
+//   (last before first, a zero suffix) is ignored: null, the whole blob;
+// - more than one range, or a first position past the end, cannot be served
+//   ('unsatisfiable');
+// - otherwise the inclusive [first, last]. A suffix range is always served,
+//   so on an empty blob it is [0, -1] and Chrome answers 206 "bytes 0--1/0".
+const _INT64_MAX = (1n << 63n) - 1n;
+function _rangeHeaderInteger(text) {
+  if (!/^[+-]?\d+$/.test(text)) return null;
+  const value = BigInt(text);
+  return value > _INT64_MAX || value < -_INT64_MAX - 1n ? null : value;
+}
+function _blobByteRange(header, size) {
+  const equals = header.indexOf('=');
+  if (equals === -1) return null;
+  const trim = text => text.replace(/^[\t ]+|[\t ]+$/g, '');
+  if (trim(header.slice(0, equals)).toLowerCase() !== 'bytes') return null;
+  const ranges = [];
+  for (const raw of header.slice(equals + 1).split(',')) {
+    const spec = trim(raw);
+    if (spec === '') continue;
+    const minus = spec.indexOf('-');
+    if (minus === -1) return null;
+    const firstText = trim(spec.slice(0, minus));
+    const lastText = trim(spec.slice(minus + 1));
+    const first = firstText === '' ? null : _rangeHeaderInteger(firstText);
+    if (firstText !== '' && first === null) return null;
+    const last = lastText === '' ? null : _rangeHeaderInteger(lastText);
+    if (lastText !== '' && last === null) return null;
+    if (first === null) {
+      if (last === null || last <= 0n) return null;
+      ranges.push({ suffix: last });
+    } else {
+      if (first < 0n || (last !== null && last < first)) return null;
+      ranges.push({ first, last });
+    }
+  }
+  if (ranges.length === 0) return null;
+  if (ranges.length !== 1) return 'unsatisfiable';
+  const range = ranges[0];
+  const total = BigInt(size);
+  if (range.suffix !== undefined) {
+    const length = range.suffix < total ? range.suffix : total;
+    return [Number(total - length), size - 1];
+  }
+  if (range.first >= total) return 'unsatisfiable';
+  const last = range.last === null || range.last > total - 1n ? total - 1n : range.last;
+  return [Number(range.first), Number(last)];
 }
 URL.createObjectURL = function(blob) {
   // Chrome mints blob:<document-origin>/<v4-uuid> (blob:null/<uuid> on an opaque
diff --git a/crates/obscura-js/src/runtime.rs b/crates/obscura-js/src/runtime.rs
index afca420..55c3645 100644
--- a/crates/obscura-js/src/runtime.rs
+++ b/crates/obscura-js/src/runtime.rs
@@ -7460,6 +7460,67 @@ mod tests {
         );
     }
 
+    /// A Range header on a blob: fetch is answered as Chrome answers it: one
+    /// satisfiable range is 206 with Content-Range, more than one or one past
+    /// the end is a network error, and a header that is not a byte range is
+    /// ignored. Every expectation is headless Chrome's answer to the same
+    /// header: empty specs are dropped, positions are signed 64-bit integers
+    /// (one that overflows makes the header unparseable), and a suffix range
+    /// on an empty blob is served as "bytes 0--1/0".
+    #[tokio::test(flavor = "current_thread")]
+    async fn blob_url_fetches_honour_a_single_byte_range() {
+        let mut rt = setup_runtime_at("<html><body></body></html>", "https://example.com/");
+        rt.evaluate(
+            r#"(() => {
+            const url = URL.createObjectURL(new Blob(['0123456789'], {type: 'text/plain'}));
+            const empty = URL.createObjectURL(new Blob([]));
+            globalThis.__ranges = null;
+            const cases = ['bytes=2-5', 'bytes=-3', 'bytes = 5-100', 'bytes=10-', 'bytes=0-1,4-5', 'bytes=5-2', 'items=0-1',
+                'bytes=0-1,', 'bytes=,0-1', 'bytes=0-1, ,3-4', 'bytes=,',
+                'bytes=0-99999999999999999999', 'bytes=0-9223372036854775807', 'bytes=0-9223372036854775808',
+                'bytes=9007199254740993-9007199254740992', 'bytes=-9223372036854775808',
+                'bytes=+1-2', 'bytes=1-+2', 'bytes=-+3', 'bytes=0--0', 'bytes=1--2', 'bytes=++1-2'];
+            Promise.all(cases.map(range => [url, range]).concat([[empty, 'bytes=-3'], [empty, 'bytes=0-']]).map(([target, range]) => fetch(target, {headers: new Headers({Range: range})}).then(
+                async response => [response.status, response.headers.get('content-range'),
+                    response.headers.get('content-length'), await response.text()],
+                error => error.name,
+            ))).then(results => { __ranges = results; });
+            return true;
+            })()"#,
+        )
+        .unwrap();
+        rt.run_event_loop_bounded(200).await.unwrap();
+        assert_eq!(
+            rt.evaluate("__ranges").unwrap(),
+            serde_json::json!([
+                [206, "bytes 2-5/10", "4", "2345"],
+                [206, "bytes 7-9/10", "3", "789"],
+                [206, "bytes 5-9/10", "5", "56789"],
+                "TypeError",
+                "TypeError",
+                [200, null, "10", "0123456789"],
+                [200, null, "10", "0123456789"],
+                [206, "bytes 0-1/10", "2", "01"],
+                [206, "bytes 0-1/10", "2", "01"],
+                "TypeError",
+                [200, null, "10", "0123456789"],
+                [200, null, "10", "0123456789"],
+                [206, "bytes 0-9/10", "10", "0123456789"],
+                [200, null, "10", "0123456789"],
+                [200, null, "10", "0123456789"],
+                [200, null, "10", "0123456789"],
+                [206, "bytes 1-2/10", "2", "12"],
+                [206, "bytes 1-2/10", "2", "12"],
+                [206, "bytes 7-9/10", "3", "789"],
+                [206, "bytes 0-0/10", "1", "0"],
+                [200, null, "10", "0123456789"],
+                [200, null, "10", "0123456789"],
+                [206, "bytes 0--1/0", "0", ""],
+                "TypeError",
+            ])
+        );
+    }
+
