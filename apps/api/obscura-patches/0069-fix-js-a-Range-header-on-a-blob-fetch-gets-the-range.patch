+    /// A Range header on a blob: fetch is answered as Chrome answers it: one
+    /// satisfiable range is 206 with Content-Range, more than one or one past
+    /// the end is a network error, and a header that is not a byte range is
+    /// ignored.
+    #[tokio::test(flavor = "current_thread")]
+    async fn blob_url_fetches_honour_a_single_byte_range() {
+        let mut rt = setup_runtime_at("<html><body></body></html>", "https://example.com/");
+        rt.evaluate(
+            r#"(() => {
+            const url = URL.createObjectURL(new Blob(['0123456789'], {type: 'text/plain'}));
+            globalThis.__ranges = null;
+            const cases = ['bytes=2-5', 'bytes=-3', 'bytes = 5-100', 'bytes=10-', 'bytes=0-1,4-5', 'bytes=5-2', 'items=0-1'];
+            Promise.all(cases.map(range => fetch(url, {headers: new Headers({Range: range})}).then(
+                async response => [response.status, response.headers.get('content-range'),
+                    response.headers.get('content-length'), await response.text()],
+                error => error.name,
+            ))).then(results => { __ranges = results; });
+            return true;
+            })()"#,
+        )
+        .unwrap();
+        rt.run_event_loop_bounded(200).await.unwrap();
+        assert_eq!(
+            rt.evaluate("__ranges").unwrap(),
+            serde_json::json!([
+                [206, "bytes 2-5/10", "4", "2345"],
+                [206, "bytes 7-9/10", "3", "789"],
+                [206, "bytes 5-9/10", "5", "56789"],
+                "TypeError",
+                "TypeError",
+                [200, null, "10", "0123456789"],
+                [200, null, "10", "0123456789"],
+            ])
+        );
+    }
+
