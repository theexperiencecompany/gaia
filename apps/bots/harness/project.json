{
  "name": "bot-harness",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "root": "apps/bots/harness",
  "sourceRoot": "apps/bots/harness/src",
  "projectType": "application",
  "tags": ["scope:typescript"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm tsup",
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "outputs": ["{projectRoot}/dist"]
    },
    "sim": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm tsx src/cli.ts",
        "cwd": "{projectRoot}"
      }
    },
    "e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash run-scenarios.sh",
        "cwd": "{projectRoot}"
      },
      "cache": false,
      "inputs": [
        "{projectRoot}/run-scenarios.sh",
        "{projectRoot}/scenarios/**/*",
        "{projectRoot}/src/**/*",
        "{workspaceRoot}/libs/shared/ts/src/bots/**/*",
        "{workspaceRoot}/libs/shared/ts/src/conversation/**/*",
        "{workspaceRoot}/libs/shared/py/conversation_wire.py",
        "{workspaceRoot}/libs/shared/py/approvals.py",
        "{workspaceRoot}/apps/api/app/services/conversation/**/*",
        "{workspaceRoot}/apps/api/app/services/runtime/**/*",
        "{workspaceRoot}/apps/api/app/services/hil/**/*",
        "{workspaceRoot}/apps/api/app/agents/core/**/*",
        "{workspaceRoot}/apps/api/app/api/v1/endpoints/bot.py",
        "{workspaceRoot}/apps/api/app/api/v1/endpoints/bot_conversations.py",
        "{workspaceRoot}/apps/api/app/api/v1/endpoints/conversations.py",
        "{workspaceRoot}/apps/api/app/api/v1/endpoints/approvals.py",
        "{workspaceRoot}/apps/api/app/api/v1/endpoints/dev.py",
        "{workspaceRoot}/tools/llm-stub/**/*",
        "{workspaceRoot}/scripts/ci/sim-stack.sh",
        "{workspaceRoot}/scripts/ci/test-services.sh",
        "{workspaceRoot}/.github/actions/setup-python-test-env/**/*",
        {
          "externalDependencies": []
        }
      ],
      "metadata": {
        "ci": {
          "job": "web-e2e-screen"
        }
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm biome check src/",
        "cwd": "{projectRoot}"
      }
    },
    "lint:fix": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm biome check --write src/",
        "cwd": "{projectRoot}"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm biome format --write src/",
        "cwd": "{projectRoot}"
      }
    },
    "format:check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm biome format src/",
        "cwd": "{projectRoot}"
      }
    },
    "type-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node \"$NX_WORKSPACE_ROOT/scripts/ts/type-check.mjs\" --noEmit",
        "cwd": "{projectRoot}"
      }
    }
  }
}
