ENV=development                      # Environment type: development, staging, production.
                                     # Doubles as the Infisical environment slug. Optional locally —
                                     # a bare checkout already resolves to development; set it to be
                                     # explicit. Deployed images pin ENV=production.

# ── GAIA API Connection ──
GAIA_API_URL=http://localhost:8000
GAIA_BOT_API_KEY=                    # must match GAIA_BOT_API_KEY in your API .env
GAIA_FRONTEND_URL=http://localhost:3000
BOT_LOG_HASH_SECRET=                 # HMAC-SHA256 key for hashing PII (phone numbers, platform user IDs) in logs.
                                     # Required, min 32 chars. Generate with: openssl rand -hex 32
                                     # Use the same value across all bots in an environment; rotate to invalidate old hashes.

# ── Outbound delivery (RabbitMQ) ──
RABBITMQ_URL=amqp://guest:guest@localhost:5672/   # Consume backend-originated messages (executor replies, reminders).
                                     # Optional — the outbound consumer is disabled if unset.
                                     # Use the dockered broker's host port for `mise dev:bots`; in compose use amqp://guest:guest@rabbitmq:5672/

# ── Discord ──
DISCORD_BOT_TOKEN=                   # Bot > Token — used to log in to the gateway
DISCORD_CLIENT_ID=                   # OAuth2 > Client ID — used by deploy-commands to register slash commands

# ── Slack ──
SLACK_BOT_TOKEN=                     # OAuth & Permissions > Bot User OAuth Token
SLACK_APP_TOKEN=                     # Basic Information > App-Level Tokens (Socket Mode)
SLACK_SIGNING_SECRET=                # Basic Information > Signing Secret

# ── Telegram ──
TELEGRAM_BOT_TOKEN=                  # from @BotFather

# ── WhatsApp (Kapso) ──
KAPSO_API_KEY=                          # From Kapso dashboard
KAPSO_PHONE_NUMBER_ID=                  # From: kapso whatsapp numbers resolve --phone-number "<number>" --output json
WHATSAPP_PHONE_NUMBER=                  # E.164 number without +, e.g. 15551234567 (used for wa.me links)
KAPSO_WEBHOOK_SECRET=                   # Webhook signature secret (set when creating phone-number webhook)

# ── iMessage (Photon Spectrum) ──
SPECTRUM_PROJECT_ID=                    # From app.photon.codes project settings
SPECTRUM_PROJECT_SECRET=                # From app.photon.codes project settings
SPECTRUM_WEBHOOK_SECRET=                # Returned once by POST /projects/{id}/webhooks/

# ── Analytics ──
POSTHOG_API_KEY=                     # PostHog project API key (optional; analytics disabled if unset)

# ── Infisical (optional) ──
# Team developers: prefer `infisical login` + `infisical run` (see
# docs/configuration/infisical-setup.mdx) — no credentials in this file.
# Machine identity vars below are for deployed/headless environments only.
# Self-hosters / contributors: ignore this section, fill in the values above.
# INFISICAL_PROJECT_ID=
# INFISICAL_MACHINE_IDENTITY_CLIENT_ID=
# INFISICAL_MACHINE_IDENTITY_CLIENT_SECRET=
