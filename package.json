{
  "name": "gaia",
  "scripts": {
    "openui:gen-prompt": "tsx scripts/openui/generate-prompt.ts",
    "quality:all": "pnpm run quality:lint && pnpm run quality:type && pnpm run quality:deps && pnpm run quality:circular && pnpm run quality:size && pnpm run quality:components && pnpm run quality:types-location && pnpm run quality:pkg-json && pnpm run quality:dead && pnpm run quality:publint && pnpm run quality:attw && pnpm run quality:py:ruff && pnpm run quality:py:mypy && pnpm run quality:py:interrogate && pnpm run quality:py:xenon",
    "quality:attw": "pnpm --filter @heygaia/cli build && attw --pack packages/cli --profile node16",
    "quality:circular": "biome lint --only=suspicious/noImportCycles apps/web/src apps/mobile/src apps/desktop/src apps/bots libs/shared/ts/src libs/wake-word/src packages/cli/src",
    "quality:components": "node scripts/ci/check-components-per-file.mjs",
    "quality:dead": "bash scripts/dead-code-check.sh",
    "quality:dead:strict": "bash scripts/dead-code-check.sh --strict",
    "quality:deps": "syncpack lint --config config/.syncpackrc.json && manypkg check",
    "quality:deps:fix": "syncpack fix --config config/.syncpackrc.json && manypkg fix",
    "quality:dupe": "node scripts/ci/check-duplication.mjs",
    "quality:format": "biome format --write",
    "quality:lint": "biome check",
    "quality:lint:fix": "biome check --write",
    "quality:observability-bots": "node scripts/ci/evlog-map-bots.mjs --min-score 100",
    "quality:pkg-json": "npmPkgJsonLint . --configFile config/.npmpackagejsonlintrc.json --quiet",
    "quality:publint": "pnpm --filter @heygaia/cli build && publint packages/cli",
    "quality:py:interrogate": "uvx interrogate -c pyproject.toml apps/api apps/voice-agent libs/shared/py",
    "quality:py:mypy": "uv run --project apps/api --group backend --group dev mypy apps/api/app apps/voice-agent/src libs/shared/py --ignore-missing-imports",
    "quality:py:ruff": "uv run --project apps/api --group dev ruff check apps/api apps/voice-agent libs/shared/py",
    "quality:py:xenon": "uvx xenon --max-absolute F --max-modules E --max-average B apps/api apps/voice-agent libs/shared/py -e 'apps/api/tests/**' -e 'apps/api/scripts/**' -e 'libs/shared/py/tests/**'",
    "quality:size": "node scripts/ci/check-file-sizes.mjs",
    "quality:type": "nx run-many -t type-check",
    "quality:types-location": "node scripts/ci/check-types-location.mjs",
    "tokens": "pnpm run tokens:export && pnpm run tokens:build",
    "tokens:build": "style-dictionary build",
    "tokens:check": "design.md export --format dtcg DESIGN.md | diff - config/design.tokens.json",
    "tokens:export": "design.md export --format dtcg DESIGN.md > config/design.tokens.json",
    "doctor": "npx react-doctor@0.9.12"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.7",
    "@google/design.md": "^0.1.1",
    "@manypkg/cli": "^0.25.1",
    "@nx/docker": "^22.7.7",
    "@nx/next": "^22.7.7",
    "@react-navigation/native": "^7.3.8",
    "@react-navigation/native-stack": "^7.17.10",
    "@swc/core": "^1.15.43",
    "@swc/helpers": "^0.5.23",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "jscpd": "^4.2.5",
    "jsdom": "^30.0.1",
    "knip": "^6.31.0",
    "next": "16.3.0",
    "npm-package-json-lint": "^10.4.1",
    "nx": "^22.7.7",
    "publint": "^0.3.24",
    "react": "19.1.0",
    "react-doctor": "^0.9.12",
    "react-dom": "19.1.0",
    "style-dictionary": "^4.4.0",
    "syncpack": "^15.3.2",
    "tsx": "^4.23.11",
    "typescript": "npm:typescript@6.0.0-beta"
  },
  "packageManager": "pnpm@10.17.1",
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@heroui/shared-utils"
    ],
    "onlyBuiltDependencies": [
      "@heroui/shared-utils",
      "@parcel/watcher",
      "@sentry/cli",
      "@swc/core",
      "canvas",
      "core-js",
      "electron",
      "esbuild",
      "nx",
      "protobufjs",
      "sharp",
      "workerd"
    ],
    "overrides": {
      "react": "19.1.0",
      "react-dom": "19.1.0",
      "zod": "4.3.6",
      "fast-xml-parser@<4.5.5": "4.5.5",
      "fast-xml-parser@>=5.0.0 <5.7.0": "5.7.0",
      "node-forge@<1.4.0": "1.4.0",
      "minimatch@<3.1.4": "3.1.4",
      "minimatch@>=8.0.0 <8.0.6": "8.0.6",
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "undici@>=6.0.0 <6.27.0": "6.27.0",
      "undici@>=7.0.0 <7.24.0": "7.24.0",
      "flatted@<3.4.2": "3.4.2",
      "axios@<1.16.0": "1.16.0",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "preact@<10.28.2": "10.28.2",
      "serialize-javascript@<7.0.5": "7.0.5",
      "trim-newlines@<3.0.1": "3.0.1",
      "hono@<4.12.25": "4.12.25",
      "immutable@>=5.0.0 <5.1.5": "5.1.5",
      "path-to-regexp@>=8.0.0 <8.4.0": "8.4.0",
      "express-rate-limit@>=8.0.0 <8.2.2": "8.2.2",
      "@xmldom/xmldom@<0.8.13": "0.8.13",
      "simple-git@<3.36.0": "3.36.0",
      "tar@<7.5.16": "7.5.16",
      "koa@>=3.0.0 <3.1.2": "3.1.2",
      "lodash-es@<=4.17.23": "4.18.0",
      "prismjs@<1.30.0": "1.30.0",
      "esbuild@<=0.24.2": "0.25.0",
      "esbuild@>=0.27.3 <0.28.1": "0.28.1",
      "postcss@<8.5.10": "8.5.16",
      "ip-address@<=10.1.0": "10.1.1",
      "@smithy/config-resolver@<4.4.0": "4.4.0",
      "@tootallnate/once@<3.0.1": "3.0.1"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "react-remove-scroll>@types/react": "^19.0.0",
        "zustand": "5"
      }
    },
    "patchedDependencies": {
      "dmg-builder": "patches/dmg-builder.patch",
      "sileo@0.1.4": "patches/sileo@0.1.4.patch"
    }
  }
}
