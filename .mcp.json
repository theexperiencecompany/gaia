{
  "mcpServers": {
    "dagger": {
      "command": "dagger",
      "args": ["-s", "mcp"],
      "env": {}
    },
    "infisical": {
      "command": "sh",
      "args": [
        "-c",
        "INFISICAL_TOKEN=\"$(infisical user get token --plain --silent)\" exec npx -y @infisical/mcp"
      ],
      "env": {
        "INFISICAL_AUTH_METHOD": "access-token",
        "INFISICAL_HOST_URL": "https://app.infisical.com"
      }
    },
    "code-review-graph": {
      "command": "uvx",
      "args": ["code-review-graph", "serve"],
      "type": "stdio"
    },
    "langsmith": {
      "command": "uvx",
      "args": ["langsmith-mcp-server"],
      "type": "stdio",
      "env": {
        "LANGSMITH_API_KEY": "${LANGSMITH_API_KEY:-}"
      }
    },
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest", "--autoConnect"],
      "env": {}
    },
    "mobile": {
      "command": "npx",
      "args": ["-y", "@mobilenext/mobile-mcp@latest"]
    },
    "sentry": {
      "type": "http",
      "url": "https://mcp.sentry.dev/mcp"
    }
  }
}
