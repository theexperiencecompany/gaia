{
  "mcpServers": {
    "dagger": {
      "command": "dagger",
      "args": ["-s", "mcp"],
      "env": {}
    },
    "infisical": {
      "command": "npx",
      "args": ["-y", "@infisical/mcp"],
      "env": {
        "INFISICAL_AUTH_METHOD": "universal-auth",
        "INFISICAL_UNIVERSAL_AUTH_CLIENT_ID": "${INFISICAL_MCP_CLIENT_ID:-}",
        "INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET": "${INFISICAL_MCP_CLIENT_SECRET:-}",
        "INFISICAL_HOST_URL": "https://app.infisical.com"
      }
    },
    "code-review-graph": {
      "command": "uvx",
      "args": ["code-review-graph", "serve"],
      "type": "stdio"
    },
    "langsmith": {
      "command": "uvx",
      "args": ["langsmith-mcp-server"],
      "type": "stdio",
      "env": {
        "LANGSMITH_API_KEY": "${LANGSMITH_API_KEY:-}"
      }
    },
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest", "--autoConnect"],
      "env": {}
    },
    "mobile": {
      "command": "npx",
      "args": ["-y", "@mobilenext/mobile-mcp@latest"],
      "env": {
        "ANDROID_HOME": "/Users/dhruvmaradiya/Library/Android/sdk",
        "PATH": "/Users/dhruvmaradiya/Library/Android/sdk/platform-tools:/Users/dhruvmaradiya/Library/Android/sdk/emulator:/Users/dhruvmaradiya/.local/share/mise/installs/java/21.0.2/bin:/usr/local/bin:/usr/bin:/bin"
      }
    }
  }
}
