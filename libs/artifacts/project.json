{
  "name": "artifacts",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "root": "libs/artifacts",
  "sourceRoot": "libs/artifacts/src",
  "projectType": "library",
  "tags": ["scope:typescript"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "biome check .",
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/biome.json"]
    },
    "type-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node \"$NX_WORKSPACE_ROOT/scripts/ts/type-check.mjs\" --noEmit",
        "cwd": "{projectRoot}"
      },
      "cache": true
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm vitest run",
        "cwd": "{projectRoot}"
      }
    }
  }
}
