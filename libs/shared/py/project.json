{
  "name": "shared-python",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "root": "libs/shared/py",
  "sourceRoot": "libs/shared/py",
  "projectType": "library",
  "tags": ["scope:python"],
  "namedInputs": {
    "production": ["default", "{workspaceRoot}/libs/pyproject.toml"]
  },
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --frozen --no-build --isolated --only-group lint ruff check .",
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/libs/pyproject.toml",
        "python",
        {
          "externalDependencies": []
        }
      ]
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --frozen --no-build --isolated --only-group lint ruff format .",
        "cwd": "{projectRoot}"
      }
    }
  }
}
