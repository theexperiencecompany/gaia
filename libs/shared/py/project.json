{
  "name": "shared-python",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "root": "libs/shared/py",
  "sourceRoot": "libs/shared/py",
  "projectType": "library",
  "tags": ["scope:python"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uvx ruff@0.14.13 check .",
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/libs/shared/py/pyproject.toml",
        "{workspaceRoot}/apps/api/pyproject.toml"
      ]
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uvx ruff@0.14.13 format .",
        "cwd": "{projectRoot}"
      }
    }
  }
}
