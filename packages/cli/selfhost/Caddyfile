# Single-origin entrypoint for the self-host stack (proxy profile in
# docker-compose.selfhost.yml). /api/v1 — REST, SSE streams and the WebSocket —
# and /health/ready go to gaia-backend; everything else is the Next.js app.
# Same origin means no CORS and host-only session cookies, on any hostname or IP.
#
# GAIA_SITE_ADDRESS comes from compose: GAIA_DOMAIN when set, else ":80".
# GAIA_BACKEND_UPSTREAM / GAIA_WEB_UPSTREAM default to the compose service
# names; platforms with other private hostnames (Render) set them.
# GAIA_DOMAIN unset: plain HTTP on :80 (published as WEB_HOST_PORT) for any host.
# GAIA_DOMAIN set: Caddy obtains and renews a certificate for it and redirects
# HTTP to HTTPS; plain-HTTP localhost keeps answering so the CLI's readiness and
# doctor probes work before DNS points here.
# GAIA_CADDY_GLOBAL_OPTIONS is "local_certs" for a domain no public CA will
# certify (gaia.test, *.internal): Caddy then issues it from its own local CA.

{
	{$GAIA_CADDY_GLOBAL_OPTIONS}
}

(gaia) {
	# Per-dependency readiness for `gaia status` / `gaia doctor` and platform probes.
	handle /health/ready {
		reverse_proxy {$GAIA_BACKEND_UPSTREAM:gaia-backend:8000}
	}

	handle /api/v1/* {
		reverse_proxy {$GAIA_BACKEND_UPSTREAM:gaia-backend:8000} {
			# Chat replies stream as SSE; never buffer a response.
			flush_interval -1
		}
	}

	handle {
		reverse_proxy {$GAIA_WEB_UPSTREAM:gaia-web:3000}
	}
}

{$GAIA_SITE_ADDRESS} {
	import gaia
}

# host.docker.internal is how a local code-sandbox container reaches GAIA
# (docker-compose.sandbox.yml), over plain HTTP like localhost.
http://localhost, http://host.docker.internal {
	import gaia
}

# Optional share domains beside GAIA_DOMAIN, set by `gaia up --link-domain` /
# `--usercontent-domain`. Unset, each address is a .invalid name over plain
# HTTP that no request carries, so the block never serves. Compose sets the
# fallback itself: Caddy takes an empty variable as an empty address.

# GAIA_LINK_DOMAIN: short links. /<slug> goes to the app's /l/<slug> page,
# never cached, so a revoked or re-pointed link takes effect at once.
{$GAIA_LINK_SITE_ADDRESS:http://link.gaia.invalid} {
	header Cache-Control no-store
	redir / https://{$GAIA_SITE_ADDRESS}/ 307
	redir https://{$GAIA_SITE_ADDRESS}/l{uri} 307
}

# GAIA_USERCONTENT_DOMAIN: shared files' bytes, apart from GAIA's origin. Only
# the content route is reachable here; the API serves a snapshot only when it
# arrived on this host. No cookie or credential travels either way, and the
# API's CSP sandbox gives every document an opaque origin.
{$GAIA_USERCONTENT_SITE_ADDRESS:http://usercontent.gaia.invalid} {
	request_header -Cookie
	request_header -Authorization
	handle /api/v1/usercontent/* {
		reverse_proxy {$GAIA_BACKEND_UPSTREAM:gaia-backend:8000} {
			header_down -Set-Cookie
		}
	}
	handle {
		respond 404
	}
}
