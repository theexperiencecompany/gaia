{
  "name": "@heygaia/cli",
  "description": "CLI tool for setting up and managing GAIA",
  "version": "0.7.0",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "bake:logo": "node scripts/bake-logo.mjs",
    "build": "node esbuild.config.mjs && chmod +x dist/index.js",
    "check": "biome check src",
    "dev": "tsx watch src/index.ts",
    "fix": "biome check --write src",
    "format": "biome format --write src",
    "lint": "pnpm run check",
    "lint:fix": "pnpm run fix",
    "prepublishOnly": "pnpm run build",
    "start": "NODE_ENV=production node dist/index.js",
    "type-check": "node ../../scripts/ts/type-check.mjs --noEmit"
  },
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "execa": "^9.6.1",
    "ink": "^6.8.0",
    "ink-text-input": "^6.0.0",
    "is-unicode-supported": "^2.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "semver": "^7.8.5",
    "simple-git": "^4.0.2",
    "supports-hyperlinks": "^3.2.0",
    "wrap-ansi": "^9.0.2",
    "ws": "^8.21.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@gaia/shared": "workspace:*",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/semver": "^7.8.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.12",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.5"
  },
  "bin": {
    "gaia": "./dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "ai-assistant",
    "cli",
    "gaia",
    "setup"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theexperiencecompany/gaia.git",
    "directory": "packages/cli"
  }
}
