{
  "drop": {
    "button": ["color", "radius"],
    "chip": ["radius"],
    "spinner": ["variant"],
    "tabs": ["size", "color", "radius"],
    "accordion": ["size", "color"],
    "modal": ["backdrop", "scrollBehavior"],
    "card": ["shadow", "radius"],
    "select": ["size", "color", "radius"],
    "input": ["size", "color", "radius"],
    "switch": ["color"],
