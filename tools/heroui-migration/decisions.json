  "decisions": {
    "spinner": {
      "color": {
        "default": "accent",
        "primary": "accent"
      }
    },
    "tabs": {
      "variant": {
        "solid": "primary",
        "underlined": "secondary",
        "light": "secondary"
      },
      "color": {
        "primary": "tabsVariants({ color: \"accent\" }).base()",
        "default": "default"
      }
    },
    "accordion": {
      "variant": {
        "light": "surface",
        "shadow": "default",
        "splitted": "default"
      }
    },
    "modal": {
      "size": {
        "xs": "xs",
        "sm": "sm",
        "md": "md",
        "lg": "lg",
        "xl": "modalVariants({ size: \"xl\" }) on Modal.Dialog, no Container size",
        "2xl": "modalVariants({ size: \"2xl\" }) on Modal.Dialog, no Container size",
        "3xl": "modalVariants({ size: \"3xl\" }) on Modal.Dialog, no Container size",
        "4xl": "modalVariants({ size: \"4xl\" }) on Modal.Dialog, no Container size",
        "5xl": "modalVariants({ size: \"5xl\" }) on Modal.Dialog, no Container size",
        "full": "full"
      }
    },
    "badge": {
      "color": {
        "primary": "accent",
        "secondary": "accent"
      }
    },
    "select": {
      "variant": {
        "flat": "secondary",
        "bordered": "secondary",
        "faded": "secondary",
        "underlined": "secondary"
      }
    },
    "input": {
      "variant": {
        "flat": "secondary",
        "bordered": "outline",
        "faded": "secondary",
        "underlined": "secondary",
        "light": "primary"
      }
    },
    "link": {
      "color": {
        "primary": "primary",
        "foreground": "default",
        "danger": "danger"
      }
    },
    "button": {
      "variant": {
        "light": "ghost",
        "bordered": "outline",
        "faded": "tertiary"
      },
      "colorVariant": {
        "default|solid": "default-solid (GaiaButton)",
        "default|flat": "default-soft (GaiaButton)",
        "primary|flat": "accent-soft (GaiaButton)",
        "success|flat": "success-soft (GaiaButton)",
        "warning|flat": "warning-soft (GaiaButton)",
        "danger|flat": "danger-soft (HeroUI)"
      }
    },
    "chip": {
      "variant": {
        "flat": "soft",
        "shadow": "chipVariants({ isSelected: true })"
      }
    },
    "radius": {
      "full": "shape=\"pill\" (components/shared/shape.ts)",
      "sm|md|lg": "default (gaia layer)"
    },
    "autocomplete": {
      "component": "ComboBox"
    },
    "labelPlacement": {
      "inside": "fieldVariants({ labelPlacement: \"inside\" }) on TextField/Select/ComboBox",
      "(default, labelled md/lg field)": "inside",
      "outside": "outside"
    },
    "avatar": {
      "isBordered": "avatarVariants({ isBordered: true })"
    },
    "slider": {
      "size": {
        "sm": "sliderVariants({ size: \"sm\" })",
        "md": "default"
      }
    },
    "dropdown": {
      "placement": {
        "right-end": "right bottom",
        "right-start": "right top",
        "bottom-end": "bottom end",
        "bottom-start": "bottom start",
        "top-end": "top end",
        "top-start": "top start"
      },
      "DropdownSection showDivider": "<Separator /> after the section"
    },
    "tabsPanel": "no empty Tabs.Panel for a switcher; RAC Tabs need no panels"
  },
  "v3dims": {
