{
  "name": "alert-rules",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "root": "tools/alert-rules",
  "projectType": "library",
  "targets": {
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash tools/alert-rules/verify.sh"
      },
      "inputs": [
        "default",
        "{workspaceRoot}/infra/docker/observability/grafana/provisioning/alerting/**/*",
        "{workspaceRoot}/config/pint.hcl",
        "{workspaceRoot}/tools/lints/check_alert_metric_contract.py",
        "{workspaceRoot}/tools/lints/_common.py",
        "{workspaceRoot}/apps/api/app/**/*.py",
        "{workspaceRoot}/apps/voice-agent/src/**/*.py",
        "{workspaceRoot}/libs/shared/ts/src/**/*.ts",
        "{workspaceRoot}/apps/bots/**/*.ts",
        "{workspaceRoot}/uv.lock",
        {
          "externalDependencies": []
        }
      ],
      "metadata": {
        "ci": {
          "job": "lint-python",
          "check": "alert-rules",
          "area": "contracts"
        }
      }
    }
  }
}
