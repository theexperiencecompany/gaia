{
  "name": "ci",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "root": "tools/ci",
  "projectType": "application",
  "tags": ["scope:ci"],
  "targets": {
    "biome": {
      "executor": "nx:run-commands",
      "inputs": [
        "{workspaceRoot}/biome.json",
        "{workspaceRoot}/config/biome-rules/**/*",
        "ciHarness",
        "{workspaceRoot}/**/*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc,css}",
        {
          "externalDependencies": []
        }
      ],
      "options": {
        "command": "bash scripts/ci/changes.sh scoped --task ci:biome --ext \"ts tsx js jsx json jsonc css\" --env -- node scripts/ci/checks.mjs biome"
      },
      "cache": false,
      "metadata": {
        "ci": {
          "job": "lint-node",
          "check": "biome",
          "area": "node"
        }
      }
    },
    "deps": {
      "executor": "nx:run-commands",
      "inputs": [
        "{workspaceRoot}/pnpm-lock.yaml",
        "{workspaceRoot}/packages/**/*",
        "{workspaceRoot}/config/.syncpackrc.json",
        "{workspaceRoot}/config/.npmpackagejsonlintrc.json",
        "ciHarness",
        "{workspaceRoot}/**/*.{ts,tsx,js,jsx,json}",
        {
          "externalDependencies": []
        }
      ],
      "options": {
        "command": "pnpm run quality:deps && pnpm run quality:pkg-json"
      },
      "cache": false,
      "metadata": {
        "ci": {
          "job": "lint-node",
          "check": "deps",
          "area": "node",
          "fallback": "package.json"
        }
      }
    },
    "circular": {
      "executor": "nx:run-commands",
      "inputs": [
        "{workspaceRoot}/biome.json",
        "{workspaceRoot}/config/biome-rules/**/*",
        "ciHarness",
        "{workspaceRoot}/**/*.{ts,tsx,js,jsx}",
        {
          "externalDependencies": []
        }
      ],
      "options": {
        "command": "pnpm run quality:circular"
      },
      "cache": false,
      "metadata": {
        "ci": {
          "job": "lint-node",
          "check": "circular",
          "area": "node"
        }
      }
    },
    "file-size": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash scripts/ci/changes.sh scoped --task ci:file-size --ext \"ts tsx js jsx mjs cjs\" --env -- node scripts/ci/checks.mjs file-sizes"
      },
      "cache": false,
      "inputs": [
        "ciHarness",
        "{workspaceRoot}/**/*.{ts,tsx,js,jsx,mjs,cjs}",
        {
          "externalDependencies": []
        }
      ],
      "metadata": {
        "ci": {
          "job": "lint-node",
          "check": "file-size",
          "area": "node"
        }
      }
    },
    "types-location": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash scripts/ci/changes.sh scoped --task ci:types-location --ext \"ts tsx\" --env -- node scripts/ci/checks.mjs types-location --enforce"
      },
      "cache": false,
      "inputs": [
        "ciHarness",
        "{workspaceRoot}/**/*.{ts,tsx,js}",
        {
          "externalDependencies": []
        }
      ],
      "metadata": {
        "ci": {
          "job": "lint-node",
          "check": "types-location",
          "area": "node"
        }
      }
    },
    "doc-comments": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash scripts/ci/changes.sh scoped --task ci:doc-comments --ext \"ts tsx js jsx mjs cjs\" --env -- node scripts/ci/checks.mjs doc-comments"
      },
      "cache": false,
      "inputs": [
        "ciHarness",
        "{workspaceRoot}/**/*.{ts,tsx,js,jsx,mjs,cjs}",
        {
          "externalDependencies": []
        }
      ],
      "metadata": {
        "ci": {
          "job": "lint-node",
          "check": "doc-comments",
          "area": "node"
        }
      }
    },
    "components-per-file": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash scripts/ci/changes.sh scoped --task ci:components-per-file --ext tsx --env -- node scripts/ci/checks.mjs components-per-file"
      },
      "cache": false,
      "inputs": [
        "ciHarness",
        "{workspaceRoot}/**/*.tsx",
        {
          "externalDependencies": []
        }
      ],
      "metadata": {
        "ci": {
          "job": "lint-node",
          "check": "components-per-file",
          "area": "node"
        }
      }
    },
    "package-hygiene": {
      "executor": "nx:run-commands",
      "inputs": [
        "{workspaceRoot}/packages/cli/**/*",
        "{workspaceRoot}/pnpm-lock.yaml",
        "ciHarness",
        {
          "externalDependencies": []
        }
      ],
      "options": {
        "command": "pnpm run quality:publint && pnpm run quality:attw"
      },
      "cache": false,
      "metadata": {
        "ci": {
          "job": "lint-node",
          "check": "package-hygiene",
          "area": "node"
        }
      }
    },
    "pnpm-audit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash scripts/ci/audit.sh pnpm"
      },
      "cache": false,
      "inputs": [
        "{workspaceRoot}/pnpm-lock.yaml",
        "{workspaceRoot}/**/package.json",
        "{workspaceRoot}/config/pnpm-audit-allowlist.json",
        "ciHarness",
        {
          "externalDependencies": []
        }
      ],
      "metadata": {
        "ci": {
          "job": "lint-node",
          "check": "pnpm-audit",
          "area": "node",
          "reuse": false
        }
      }
    },
    "duplicates": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run quality:dupe"
      },
      "inputs": [
        "{workspaceRoot}/config/.jscpd.json",
        "ciHarness",
        "{workspaceRoot}/**/*.{ts,tsx,js,jsx,py}",
        {
          "externalDependencies": []
        }
      ],
      "metadata": {
        "ci": {
          "job": "lint-node",
          "check": "duplicates",
          "area": "node"
        }
      }
    },
    "ruff": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash scripts/ci/changes.sh scoped --task ci:ruff --ext py --full . -- uv run --frozen --no-build --isolated --only-group lint ruff check && bash scripts/ci/changes.sh scoped --task ci:ruff --ext py --full . -- uv run --frozen --no-build --isolated --only-group lint ruff format --check"
      },
      "cache": false,
      "inputs": [
        "{workspaceRoot}/**/pyproject.toml",
        "{workspaceRoot}/**/ruff.toml",
        "ciHarness",
        "{workspaceRoot}/**/*.py",
        {
          "externalDependencies": []
        }
      ],
      "metadata": {
        "ci": {
          "job": "lint-python",
          "check": "ruff",
          "area": "python"
        }
      }
    },
    "custom-lints": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python3 tools/lints/run.py apps/api/app apps/api/tests"
      },
      "cache": false,
      "inputs": [
        "{workspaceRoot}/tools/lints/**/*",
        "ciHarness",
        "{workspaceRoot}/**/*.py",
        {
          "externalDependencies": []
        }
      ],
      "metadata": {
        "ci": {
          "job": "lint-python",
          "check": "custom-lints",
          "area": "python"
        }
      }
    },
    "lint-imports": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --frozen --no-build --isolated --only-group lint lint-imports --no-cache",
        "cwd": "apps/api"
      },
      "cache": false,
      "inputs": [
        "{workspaceRoot}/apps/api/pyproject.toml",
        "ciHarness",
        "{workspaceRoot}/apps/api/app/**/*.py",
        {
          "externalDependencies": []
        }
      ],
      "metadata": {
        "ci": {
          "job": "lint-python",
          "check": "lint-imports",
          "area": "python"
        }
      }
    },
    "ignore-whys": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python3 tools/lints/check_ignore_whys.py"
      },
      "cache": false,
      "inputs": [
        "{workspaceRoot}/**/pyproject.toml",
        "{workspaceRoot}/tools/lints/check_ignore_whys.py",
        "ciHarness",
        {
          "externalDependencies": []
        }
      ],
      "metadata": {
        "ci": {
          "job": "lint-python",
          "check": "ignore-whys",
          "area": "python"
        }
      }
    },
    "plr-complexity": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python3 tools/lints/check_plr_complexity.py"
      },
      "cache": false,
      "inputs": [
        "{workspaceRoot}/tools/lints/check_plr_complexity.py",
        "{workspaceRoot}/tools/lints/plr_complexity_baseline.txt",
        "ciHarness",
        "{workspaceRoot}/**/*.py",
        {
          "externalDependencies": []
        }
      ],
      "metadata": {
        "ci": {
          "job": "lint-python",
          "check": "plr-complexity",
          "area": "python"
        }
      }
    },
    "mypy-tests": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python3 tools/lints/check_mypy_tests.py"
      },
      "cache": false,
      "inputs": [
        "{workspaceRoot}/tools/lints/check_mypy_tests.py",
        "{workspaceRoot}/tools/lints/mypy_tests_baseline.txt",
        "{workspaceRoot}/tools/lints/_ratchet.py",
        "{workspaceRoot}/tools/lints/_common.py",
        "{workspaceRoot}/pyproject.toml",
        "{workspaceRoot}/apps/api/pyproject.toml",
        "{workspaceRoot}/uv.lock",
        "ciHarness",
        "{workspaceRoot}/apps/api/tests/**/*.py",
        "{workspaceRoot}/apps/api/app/**/*.py",
        "{workspaceRoot}/libs/shared/py/**/*.py",
        {
          "externalDependencies": []
        }
      ],
      "metadata": {
        "ci": {
          "job": "lint-python",
          "check": "mypy-tests",
          "area": "python"
        }
      }
    },
    "typed-boundaries": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python3 tools/lints/check_typed_boundaries.py"
      },
      "cache": false,
      "inputs": [
        "{workspaceRoot}/tools/lints/check_typed_boundaries.py",
        "{workspaceRoot}/tools/lints/typed_boundaries_baseline.txt",
        "{workspaceRoot}/tools/lints/_ratchet.py",
        "{workspaceRoot}/tools/lints/_common.py",
        "ciHarness",
        "{workspaceRoot}/**/*.py",
        {
          "externalDependencies": []
        }
      ],
      "metadata": {
        "ci": {
          "job": "lint-python",
          "check": "typed-boundaries",
          "area": "python"
        }
      }
    },
    "xenon": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash scripts/ci/changes.sh scoped --task ci:xenon --py-source --full \"apps/api apps/voice-agent libs/shared/py -e apps/api/tests/** -e apps/api/scripts/** -e libs/shared/py/tests/**\" -- uv run --frozen --no-build --isolated --only-group lint xenon --max-absolute F --max-modules E --max-average B"
      },
      "cache": false,
      "inputs": [
        "{workspaceRoot}/pyproject.toml",
        "ciHarness",
        "{workspaceRoot}/apps/api/**/*.py",
        "{workspaceRoot}/apps/voice-agent/**/*.py",
        "{workspaceRoot}/libs/shared/py/**/*.py",
        {
          "externalDependencies": []
        }
      ],
      "metadata": {
        "ci": {
          "job": "lint-python",
          "check": "xenon",
          "area": "python"
        }
      }
    },
    "interrogate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash scripts/ci/changes.sh scoped --task ci:interrogate --py-source --full \"apps/api apps/voice-agent libs/shared/py\" -- uv run --frozen --no-build --isolated --only-group lint interrogate -c pyproject.toml"
      },
      "cache": false,
      "inputs": [
        "{workspaceRoot}/pyproject.toml",
        "ciHarness",
        "{workspaceRoot}/apps/api/**/*.py",
        "{workspaceRoot}/apps/voice-agent/**/*.py",
        "{workspaceRoot}/libs/shared/py/**/*.py",
        {
          "externalDependencies": []
        }
      ],
      "metadata": {
        "ci": {
          "job": "lint-python",
          "check": "interrogate",
          "area": "python"
        }
      }
    },
    "bandit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash scripts/ci/changes.sh scoped --task ci:bandit --py-source --full \"-r apps/api/app apps/voice-agent/src libs/shared/py\" -- uv run --frozen --no-build --isolated --only-group lint bandit -c pyproject.toml --severity-level low --confidence-level low"
      },
      "cache": false,
      "inputs": [
        "{workspaceRoot}/pyproject.toml",
        "ciHarness",
        "{workspaceRoot}/apps/api/app/**/*.py",
        "{workspaceRoot}/apps/voice-agent/src/**/*.py",
        "{workspaceRoot}/libs/shared/py/**/*.py",
        {
          "externalDependencies": []
        }
      ],
      "metadata": {
        "ci": {
          "job": "lint-python",
          "check": "bandit",
          "area": "python"
        }
      }
    },
    "mypy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --project apps/api --frozen --group backend --group dev mypy tools/lints --ignore-missing-imports && MYPYPATH=scripts/ci:scripts/ci/tests uv run --project apps/api --frozen --group backend --group dev mypy --explicit-package-bases scripts/ci --ignore-missing-imports --cache-dir \"${MYPY_CACHE_DIR:-.mypy_cache}/scripts-ci\""
      },
      "cache": false,
      "inputs": [
        "{workspaceRoot}/pyproject.toml",
        "{workspaceRoot}/apps/api/pyproject.toml",
        "{workspaceRoot}/uv.lock",
        "ciHarness",
        "{workspaceRoot}/tools/lints/**/*.py",
        "{workspaceRoot}/scripts/ci/**/*.py",
        {
          "externalDependencies": []
        }
      ],
      "metadata": {
        "ci": {
          "job": "lint-python",
          "check": "mypy",
          "area": "python"
