        "{workspaceRoot}/tools/lints/**/*",
        "ciHarness",
        "{workspaceRoot}/**/*.py",
        {
          "externalDependencies": []
        }
      ],
      "metadata": {
        "ci": {
          "job": "lint-python",
          "check": "ignore-staleness",
          "area": "python"
        }
