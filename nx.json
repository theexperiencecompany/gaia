{
  "$schema": "https://raw.githubusercontent.com/nrwl/nx/refs/heads/master/packages/nx/schemas/nx-schema.json",
  "installation": {
    "version": "24.0.0",
    "plugins": {
      "sources": []
    }
  },
  "useDaemonProcess": false,
  "defaultBase": "master",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "!{projectRoot}/**/README.md",
      "!{projectRoot}/**/CLAUDE.md",
      "!{projectRoot}/**/AGENTS.md"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/*.{spec,test}.{ts,tsx,js,jsx}"
    ],
    "typecheck": [
      "default",
      {
        "env": "GAIA_TS_CHECKER"
      }
    ],
    "python": ["{workspaceRoot}/pyproject.toml", "{workspaceRoot}/uv.lock"],
    "ciHarness": [
      "{workspaceRoot}/scripts/ci/**/*",
      "!{workspaceRoot}/scripts/ci/**/*.md",
      "{workspaceRoot}/.github/workflows/ci.yml",
      "{workspaceRoot}/.github/actions/**/*",
      "{workspaceRoot}/tools/nx-ci-status/**/*"
    ]
  },
  "targetDefaults": {
    "sync": {
      "cache": true
    },
    "build": {
      "cache": true,
      "inputs": ["production", "^production"],
      "dependsOn": ["sync", "^build"],
      "metadata": {
        "ci": {
          "job": "ts-build-test",
          "check": "build",
          "area": "build"
        }
      }
    },
    "test": {
      "cache": true,
      "inputs": ["default", "^production"],
      "metadata": {
        "ci": {
          "job": "ts-build-test",
          "check": "test-typescript",
          "area": "tests"
        }
      }
    },
    "lint": {
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/biome.json"]
    },
    "lint:fix": {
      "cache": false
    },
    "format": {
      "cache": false
    },
    "format:check": {
      "cache": true,
      "inputs": ["default"]
    },
    "type-check": {
      "cache": true,
      "inputs": ["typecheck", "^production"],
      "metadata": {
        "ci": {
          "job": "lint-node",
          "check": "type-check",
          "area": "node"
        }
      }
    },
    "dev": {
      "cache": false
    },
    "worker": {
      "cache": false
    },
    "clean": {
      "cache": false
    },
    "next:build": {
      "cache": false
    },
    "next:start": {
      "dependsOn": []
    }
  },
  "parallel": 3,
  "plugins": [
    {
      "plugin": "@nx/next/plugin",
      "options": {
        "startTargetName": "next:start",
        "buildTargetName": "next:build",
        "devTargetName": "next:dev",
        "serveStaticTargetName": "serve-static",
        "buildDepsTargetName": "build-deps",
        "watchDepsTargetName": "watch-deps"
      }
    },
    "@nx/docker",
    "./tools/nx-ci-status/index.js"
  ],
  "release": {
    "releaseTag": {
      "pattern": "release/{projectName}/{version}"
    },
    "changelog": {
      "automaticFromRef": true
    },
    "groups": {
      "apps": {
        "projects": ["tag:release:apps"],
        "projectsRelationship": "independent",
        "docker": {
          "groupPreVersionCommand": "npx nx run-many -t docker:build -p tag:release:apps --parallel --skipNxCache",
          "skipVersionActions": true,
          "registryUrl": "ghcr.io"
        },
        "changelog": {
          "projectChangelogs": true
        }
      },
      "bots": {
        "projects": ["tag:release:bots"],
        "projectsRelationship": "fixed",
        "docker": {
          "groupPreVersionCommand": "npx nx run-many -t docker:build -p tag:release:bots --parallel --skipNxCache",
          "skipVersionActions": true,
          "registryUrl": "ghcr.io"
        },
        "changelog": {
          "projectChangelogs": false
        }
      }
    },
    "docker": {
      "preVersionCommand": "",
      "versionSchemes": {
        "production": "{currentDate|YYMM.DD}.{shortCommitSha}",
        "develop": "develop-{shortCommitSha}"
      }
    }
  },
  "analytics": false,
  "pluginsConfig": {
    "@nx/js": {
      "analyzeSourceFiles": false,
      "projectsAffectedByDependencyUpdates": "auto"
    }
  }
}
