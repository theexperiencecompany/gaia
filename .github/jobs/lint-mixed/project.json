{
  "name": "lint-mixed",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "root": ".github/jobs/lint-mixed",
  "metadata": {
    "description": "The checks ci.yml's lint-mixed job runs, one target each. A target's inputs are the files its check reads, so `nx affected` decides which of them a change runs; the commands live in the job."
  },
  "targets": {
    "api-schema": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/ci/checks.mjs api-schema"
      },
      "cache": false,
      "inputs": [
        "{workspaceRoot}/apps/api/scripts/export_openapi.py",
        "{workspaceRoot}/apps/api/scripts/openapi_contract.py",
        "{workspaceRoot}/apps/api/tests/offline_env.py",
        "{workspaceRoot}/apps/api/pyproject.toml",
        "{workspaceRoot}/apps/api/openapi.json",
        "{workspaceRoot}/uv.lock",
        "{workspaceRoot}/libs/shared/ts/src/api/generated/**/*",
        "{workspaceRoot}/scripts/ci/checks.mjs",
        "{workspaceRoot}/package.json",
        "ciHarness",
        "{workspaceRoot}/apps/api/app/**/*.py",
        "{workspaceRoot}/libs/shared/py/**/*.py",
        {
          "externalDependencies": []
        }
      ]
    },
    "analytics-catalog": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/ci/checks.mjs analytics-catalog"
      },
      "cache": false,
      "inputs": [
        "{workspaceRoot}/libs/shared/py/analytics/**/*",
        "{workspaceRoot}/libs/shared/ts/src/analytics/generated/**/*",
        "{workspaceRoot}/uv.lock",
        "{workspaceRoot}/scripts/ci/checks.mjs",
        "ciHarness",
        {
          "externalDependencies": []
        }
      ]
    },
    "cli-config-schema": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/ci/checks.mjs cli-config-schema"
      },
      "cache": false,
      "inputs": [
        "{workspaceRoot}/apps/api/app/config/**/*",
        "{workspaceRoot}/apps/api/scripts/dump_config_schema.py",
        "{workspaceRoot}/packages/cli/src/lib/api-config-schema.generated.json",
        "{workspaceRoot}/scripts/ci/checks.mjs",
        "ciHarness",
        {
          "externalDependencies": []
        }
      ]
    },
    "deploy-templates": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/ci/checks.mjs deploy-templates"
      },
      "cache": false,
      "inputs": [
        "{workspaceRoot}/infra/docker/docker-compose.selfhost.yml",
        "{workspaceRoot}/infra/docker/selfhost/Caddyfile",
        "{workspaceRoot}/packages/cli/src/lib/machine-secrets.json",
        "{workspaceRoot}/deploy/coolify/gaia.yaml",
        "{workspaceRoot}/deploy/proxy.Dockerfile",
        "{workspaceRoot}/render.yaml",
        "{workspaceRoot}/scripts/ci/lib/deploy_templates.py",
        "{workspaceRoot}/scripts/ci/checks.mjs",
        "ciHarness",
        {
          "externalDependencies": []
        }
      ]
    },
    "analytics-check": {
      "executor": "nx:noop",
      "inputs": [
        "{workspaceRoot}/libs/shared/py/analytics/catalog/**/*",
        "{workspaceRoot}/libs/shared/ts/src/analytics/generated/**/*",
        "{workspaceRoot}/config/posthog/**/*",
        "{workspaceRoot}/scripts/ci/analytics.py",
        "ciHarness",
        {
          "externalDependencies": []
        }
      ]
    },
    "api-schema-types": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/ci/checks.mjs api-schema-types"
      },
      "cache": false,
      "inputs": [
        "{workspaceRoot}/apps/api/openapi.json",
        "ciHarness",
        "{workspaceRoot}/**/*.{ts,tsx}",
        {
          "externalDependencies": []
        }
      ]
    },
    "observability-evlog-tests": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --frozen --no-build --isolated --only-group harness pytest tools/evlog_map tools/logcheck -q"
      },
      "cache": false,
      "inputs": [
        "{workspaceRoot}/tools/evlog_map/**/*",
        "{workspaceRoot}/tools/logcheck/**/*",
        "ciHarness",
        "{workspaceRoot}/**/*.py",
        {
          "externalDependencies": []
        }
      ]
    },
    "observability-map": {
      "executor": "nx:noop",
      "inputs": [
        "{workspaceRoot}/apps/bots/**/*",
        "{workspaceRoot}/libs/shared/ts/**/*",
        "ciHarness",
        "{workspaceRoot}/**/*.py",
        {
          "externalDependencies": []
        }
      ]
    },
    "observability-ratchet": {
      "executor": "nx:noop",
      "inputs": [
        "ciHarness",
        "{workspaceRoot}/**/*.py",
        {
          "externalDependencies": []
        }
      ]
    },
    "observability-bots": {
      "executor": "nx:noop",
      "inputs": [
        "ciHarness",
        "{workspaceRoot}/apps/bots/**/*.ts",
        "{workspaceRoot}/libs/shared/ts/**/*.ts",
        {
          "externalDependencies": []
        }
      ]
    },
    "wide-event-conformance": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python3 scripts/ci/wide-event-conformance/run.py --show-capture"
      },
      "cache": false,
      "inputs": [
        "ciHarness",
        "{workspaceRoot}/**/*.{py,ts,tsx}",
        {
          "externalDependencies": []
        }
      ]
    },
    "dead-code": {
      "executor": "nx:noop",
      "inputs": [
        "{workspaceRoot}/**/package.json",
        "{workspaceRoot}/**/pyproject.toml",
        "{workspaceRoot}/scripts/dead-code-check.sh",
        "{workspaceRoot}/config/knip.config.ts",
        "ciHarness",
        "{workspaceRoot}/**/*.{ts,tsx,py}",
        {
          "externalDependencies": []
        }
      ]
    },
    "harness-tests": {
      "executor": "nx:noop",
      "inputs": [
        "{workspaceRoot}/**/*",
        "!{workspaceRoot}/**/*.md",
        "!{workspaceRoot}/**/*.mdx",
        "ciHarness",
        {
          "externalDependencies": []
        }
      ]
    },
    "selfhost-bundle-lock": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/ci/checks.mjs selfhost-bundle-lock"
      },
      "cache": false,
      "inputs": [
        "{workspaceRoot}/infra/docker/docker-compose.selfhost.yml",
        "{workspaceRoot}/infra/docker/docker-compose.sandbox.yml",
        "{workspaceRoot}/infra/docker/docker-compose.bot-*.yml",
        "{workspaceRoot}/infra/docker/selfhost/**/*",
        "{workspaceRoot}/infra/docker/seccomp-mongo.json",
        "{workspaceRoot}/packages/cli/selfhost-bundle.json",
        "{workspaceRoot}/scripts/ci/checks.mjs",
        "{workspaceRoot}/scripts/ci/lib/generated-artifacts.mjs",
        "ciHarness",
        {
          "externalDependencies": []
        }
      ]
    }
  }
}
