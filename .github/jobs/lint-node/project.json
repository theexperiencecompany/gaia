{
  "name": "lint-node",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "root": ".github/jobs/lint-node",
  "metadata": {
    "description": "The checks ci.yml's lint-node job runs, one target each. A target's inputs are the files its check reads, so `nx affected` decides which of them a change runs; the commands live in the job."
  },
  "targets": {
    "biome": {
      "executor": "nx:noop",
      "inputs": [
        "{workspaceRoot}/biome.json",
        "{workspaceRoot}/config/biome-rules/**/*",
        "ciHarness",
        "{workspaceRoot}/**/*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc,css}",
        {
          "externalDependencies": []
        }
      ]
    },
    "deps": {
      "executor": "nx:noop",
      "inputs": [
        "{workspaceRoot}/pnpm-lock.yaml",
        "{workspaceRoot}/packages/**/*",
        "{workspaceRoot}/config/.syncpackrc.json",
        "{workspaceRoot}/config/.npmpackagejsonlintrc.json",
        "ciHarness",
        "{workspaceRoot}/**/*.{ts,tsx,js,jsx,json}",
        {
          "externalDependencies": []
        }
      ]
    },
    "circular": {
      "executor": "nx:noop",
      "inputs": [
        "{workspaceRoot}/biome.json",
        "{workspaceRoot}/config/biome-rules/**/*",
        "ciHarness",
        "{workspaceRoot}/**/*.{ts,tsx,js,jsx}",
        {
          "externalDependencies": []
        }
      ]
    },
    "file-size": {
      "executor": "nx:noop",
      "inputs": [
        "ciHarness",
        "{workspaceRoot}/**/*.{ts,tsx,js,jsx,mjs,cjs}",
        {
          "externalDependencies": []
        }
      ]
    },
    "types-location": {
      "executor": "nx:noop",
      "inputs": [
        "ciHarness",
        "{workspaceRoot}/**/*.{ts,tsx,js}",
        {
          "externalDependencies": []
        }
      ]
    },
    "doc-comments": {
      "executor": "nx:noop",
      "inputs": [
        "ciHarness",
        "{workspaceRoot}/**/*.{ts,tsx,js,jsx,mjs,cjs}",
        {
          "externalDependencies": []
        }
      ]
    },
    "components-per-file": {
      "executor": "nx:noop",
      "inputs": [
        "ciHarness",
        "{workspaceRoot}/**/*.tsx",
        {
          "externalDependencies": []
        }
      ]
    },
    "package-hygiene": {
      "executor": "nx:noop",
      "inputs": [
        "{workspaceRoot}/packages/cli/**/*",
        "{workspaceRoot}/pnpm-lock.yaml",
        "ciHarness",
        {
          "externalDependencies": []
        }
      ]
    },
    "pnpm-audit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash scripts/ci/audit.sh pnpm"
      },
      "cache": false,
      "inputs": [
        "{workspaceRoot}/pnpm-lock.yaml",
        "{workspaceRoot}/**/package.json",
        "{workspaceRoot}/config/pnpm-audit-allowlist.json",
        "ciHarness",
        {
          "externalDependencies": []
        }
      ]
    },
    "ts-type-check": {
      "executor": "nx:noop",
      "inputs": [
        "{workspaceRoot}/nx.json",
        "{workspaceRoot}/**/tsconfig*.json",
        "ciHarness",
        "{workspaceRoot}/**/*.{ts,tsx,js,jsx}",
        {
          "externalDependencies": []
        }
      ]
    },
    "duplicates": {
      "executor": "nx:noop",
      "inputs": [
        "{workspaceRoot}/config/.jscpd.json",
        "ciHarness",
        "{workspaceRoot}/**/*.{ts,tsx,js,jsx,py}",
        {
          "externalDependencies": []
        }
      ]
    }
  }
}
