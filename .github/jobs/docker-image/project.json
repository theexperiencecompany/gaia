{
  "name": "docker-image",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "root": ".github/jobs/docker-image",
  "metadata": {
    "description": "The checks ci.yml's docker-image job runs, one target each. A target's inputs are the files its check reads, so `nx affected` decides which of them a change runs; the commands live in the job."
  },
  "targets": {
    "api-image": {
      "executor": "nx:noop",
      "inputs": [
        "{workspaceRoot}/apps/api/Dockerfile",
        "{workspaceRoot}/.dockerignore",
        "{workspaceRoot}/**/*Dockerfile.dockerignore",
        "{workspaceRoot}/uv.lock",
        "{workspaceRoot}/pyproject.toml",
        "{workspaceRoot}/apps/api/pyproject.toml",
        "{workspaceRoot}/libs/pyproject.toml",
        "{workspaceRoot}/scripts/ci/audit.sh",
        "{workspaceRoot}/apps/api/app/constants/memory.py",
        {
          "externalDependencies": []
        }
      ]
    }
  }
}
