#!/usr/sbin/nft -f
# nftables-tailnet-ingress.nft — what the tailnet may reach on this box.
#
# ufw cannot do this: tailscaled inserts its own "accept everything from
# tailscale0" rules (ts-input) ahead of ufw's chains, so a ufw allowlist on
# tailscale0 is never consulted. This table hooks input at priority -10,
# before both, and admits only the services meant to be reached over the
# tailnet: SSH, the tailscale-serve listeners, and the staging preview
# entrypoints. Everything else this box listens on (Langfuse, Portainer,
# Redis, RabbitMQ, dashboards, ...) is loopback-only from the tailnet's point
# of view, whatever the Tailscale ACL says. Loaded by gaia-ci-firewall.service
# (see create-runner-user.sh); independent of the runner-user table.

table inet tailnet_ingress {
  set allowed_tcp {
    type inet_service
    flags interval
    elements = {
      22,                                        # ssh
      443, 2222, 2443, 3443, 4443, 5443, 6443,   # tailscale serve
      7090, 7443, 8384, 8443, 9090, 9091, 9096, 9443,
      10443-16443,
      8101-8120                                  # staging preview entrypoints (traefik)
    }
  }

  chain input {
    type filter hook input priority -10; policy accept;
    iifname != "tailscale0" accept
    ct state established,related accept
    tcp dport @allowed_tcp accept
    udp dport 53 drop
    meta l4proto { tcp, udp } counter drop
  }
}
